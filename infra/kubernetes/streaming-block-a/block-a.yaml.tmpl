# Bounded Block A stack for the owner-approved row 12 run. Nothing here is deployed
# by default: scripts/streaming/block_a_cloud.sh renders it and applies it only with
# --execute. It is a single-broker, single-TaskManager verification stack, not a
# production deployment, and its storage is ephemeral on purpose.
#
# It lives in ml-platform so the sinks reuse the existing Workload Identity service
# account and the labelled path through the Redis NetworkPolicy.
apiVersion: v1
kind: Service
metadata:
  name: block-a-redpanda
  namespace: ml-platform
  labels: {app.kubernetes.io/part-of: ewallet-block-a, ewallet.block-a/namespace: ${BLOCK_A_NAMESPACE}}
spec:
  clusterIP: None
  selector: {app.kubernetes.io/name: block-a-redpanda}
  ports:
    - {name: kafka, port: 29092, targetPort: 29092}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: block-a-redpanda
  namespace: ml-platform
  labels: {app.kubernetes.io/part-of: ewallet-block-a, ewallet.block-a/namespace: ${BLOCK_A_NAMESPACE}}
spec:
  replicas: 1
  selector:
    matchLabels: {app.kubernetes.io/name: block-a-redpanda}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: block-a-redpanda
        app.kubernetes.io/part-of: ewallet-block-a
        ewallet.block-a/namespace: ${BLOCK_A_NAMESPACE}
    spec:
      containers:
        - name: redpanda
          image: docker.redpanda.com/redpandadata/redpanda@sha256:3387a7ac6b2307129032562bf957653de13373a2748f82de7ab588a39d50b88d
          args:
            - redpanda
            - start
            - --overprovisioned
            - --smp=1
            - --memory=1G
            - --reserve-memory=0M
            - --node-id=0
            - --check=false
            - --kafka-addr=INTERNAL://0.0.0.0:29092
            - --advertise-kafka-addr=INTERNAL://block-a-redpanda.ml-platform.svc.cluster.local:29092
          ports:
            - {containerPort: 29092}
          readinessProbe:
            tcpSocket: {port: 29092}
            periodSeconds: 5
          resources:
            requests: {cpu: 500m, memory: 1536Mi}
            limits: {cpu: "1", memory: 1536Mi}
          volumeMounts:
            - {name: data, mountPath: /var/lib/redpanda/data}
      volumes:
        - name: data
          emptyDir: {sizeLimit: 2Gi}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: block-a-flink
  namespace: ml-platform
  labels: {app.kubernetes.io/part-of: ewallet-block-a, ewallet.block-a/namespace: ${BLOCK_A_NAMESPACE}}
data:
  FLINK_PROPERTIES: |
    jobmanager.rpc.address: block-a-flink-jobmanager
    jobmanager.memory.process.size: 1024m
    taskmanager.memory.process.size: 2560m
    taskmanager.numberOfTaskSlots: 4
    parallelism.default: 1
    state.checkpoints.dir: file:///flink-data/checkpoints
    python.executable: /opt/venv/bin/python
    python.client.executable: /opt/venv/bin/python
---
apiVersion: v1
kind: Service
metadata:
  name: block-a-flink-jobmanager
  namespace: ml-platform
  labels: {app.kubernetes.io/part-of: ewallet-block-a, ewallet.block-a/namespace: ${BLOCK_A_NAMESPACE}}
spec:
  selector: {app.kubernetes.io/name: block-a-flink-jobmanager}
  ports:
    - {name: rpc, port: 6123}
    - {name: blob, port: 6124}
    - {name: rest, port: 8081}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: block-a-flink-jobmanager
  namespace: ml-platform
  labels: {app.kubernetes.io/part-of: ewallet-block-a, ewallet.block-a/namespace: ${BLOCK_A_NAMESPACE}}
spec:
  replicas: 1
  selector:
    matchLabels: {app.kubernetes.io/name: block-a-flink-jobmanager}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: block-a-flink-jobmanager
        app.kubernetes.io/part-of: ewallet-block-a
        ewallet.block-a/namespace: ${BLOCK_A_NAMESPACE}
    spec:
      containers:
        - name: jobmanager
          image: ${FLINK_IMAGE}
          args: ["jobmanager"]
          envFrom:
            - configMapRef: {name: block-a-flink}
          ports:
            - {containerPort: 8081}
          readinessProbe:
            httpGet: {path: /overview, port: 8081}
            periodSeconds: 5
          resources:
            requests: {cpu: 250m, memory: 1280Mi}
            limits: {cpu: "1", memory: 1280Mi}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: block-a-flink-taskmanager
  namespace: ml-platform
  labels: {app.kubernetes.io/part-of: ewallet-block-a, ewallet.block-a/namespace: ${BLOCK_A_NAMESPACE}}
spec:
  replicas: 1
  selector:
    matchLabels: {app.kubernetes.io/name: block-a-flink-taskmanager}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: block-a-flink-taskmanager
        app.kubernetes.io/part-of: ewallet-block-a
        ewallet.block-a/namespace: ${BLOCK_A_NAMESPACE}
    spec:
      containers:
        - name: taskmanager
          image: ${FLINK_IMAGE}
          args: ["taskmanager"]
          envFrom:
            - configMapRef: {name: block-a-flink}
          resources:
            requests: {cpu: 500m, memory: 3Gi}
            limits: {cpu: "2", memory: 3Gi}
          volumeMounts:
            - {name: flink-data, mountPath: /flink-data}
      volumes:
        - name: flink-data
          emptyDir: {sizeLimit: 1Gi}
