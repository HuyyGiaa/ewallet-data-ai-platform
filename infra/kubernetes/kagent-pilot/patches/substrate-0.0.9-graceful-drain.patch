+// WorkerUsable reports whether a worker's pod exists in the informer cache and is not terminating
+// (ewallet patch, B′). A worker record can outlive its pod (deleted while ateapi was down) or point
+// at a draining pod (scale-in); neither may receive a new assignment.
+func (d *AteletDialer) WorkerUsable(workerPodNamespace, workerPodName string) bool {
+	if d == nil || d.workerIndexer == nil {
+		return true
+	}
+	matching, err := d.workerIndexer.ByIndex(byNamespaceAndName, workerPodNamespace+"/"+workerPodName)
+	if err != nil || len(matching) != 1 {
+		return false
+	}
+	pod, ok := matching[0].(*corev1.Pod)
+	return ok && pod.DeletionTimestamp == nil
+}
