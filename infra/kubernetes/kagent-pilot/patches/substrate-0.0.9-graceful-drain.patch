+// ewallet patch (B′ safe scale-in): a terminating worker drains.
+//
+// The pods here have a nodeName and no kubelet, so a default (graceful) delete leaves them in the
+// API with a deletionTimestamp, exactly the state of a worker pod during its grace period; a delete
+// with grace 0 then removes them (the kubelet's final delete).
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/agent-substrate/substrate/cmd/ateapi/internal/store"
+	"github.com/agent-substrate/substrate/pkg/proto/ateapipb"
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/util/wait"
+)
+
+func createActor(t *testing.T, tc *testContext, ns, name string) {
+	t.Helper()
+	if _, err := tc.client.CreateActor(context.Background(), &ateapipb.CreateActorRequest{Actor: &ateapipb.Actor{
+		Metadata: &ateapipb.ResourceMetadata{Atespace: testAtespace, Name: name}, ActorTemplateNamespace: ns, ActorTemplateName: "tmpl1",
+	}}); err != nil {
+		t.Fatalf("CreateActor %s: %v", name, err)
+	}
+}
+
+// beginTermination puts a worker pod into its grace period (deletionTimestamp set, pod kept).
+func beginTermination(t *testing.T, tc *testContext, ns, pod string) {
+	t.Helper()
+	ctx := context.Background()
+	if err := tc.k8sClient.CoreV1().Pods(ns).Delete(ctx, pod, metav1.DeleteOptions{}); err != nil {
+		t.Fatalf("delete %s: %v", pod, err)
+	}
+	if err := wait.PollUntilContextTimeout(ctx, 20*time.Millisecond, 5*time.Second, true, func(context.Context) (bool, error) {
+		p, err := tc.k8sClient.CoreV1().Pods(ns).Get(ctx, pod, metav1.GetOptions{})
+		return err == nil && p.DeletionTimestamp != nil, nil
+	}); err != nil {
+		t.Fatalf("%s did not enter its grace period", pod)
+	}
+	// Let the informer deliver the update before asserting on syncer reactions.
+	if err := wait.PollUntilContextTimeout(ctx, 20*time.Millisecond, 5*time.Second, true, func(context.Context) (bool, error) {
+		return !tc.service.actorWorkflow.dialer.WorkerUsable(ns, pod), nil
+	}); err != nil {
+		t.Fatalf("informer did not see %s terminating", pod)
+	}
+}
+
+// finishTermination is the kubelet's final delete after the drain (or after SIGKILL).
+func finishTermination(t *testing.T, tc *testContext, ns, pod string) {
+	t.Helper()
+	zero := int64(0)
+	if err := tc.k8sClient.CoreV1().Pods(ns).Delete(context.Background(), pod, metav1.DeleteOptions{GracePeriodSeconds: &zero}); err != nil {
+		t.Fatalf("final delete %s: %v", pod, err)
+	}
+}
+
+func suspend(t *testing.T, tc *testContext, name string) {
+	t.Helper()
+	if _, err := tc.client.SuspendActor(context.Background(), &ateapipb.SuspendActorRequest{Actor: &ateapipb.ObjectRef{Atespace: testAtespace, Name: name}}); err != nil {
+		t.Fatalf("SuspendActor %s: %v", name, err)
+	}
+}
+
+func recordGone(t *testing.T, tc *testContext, ns, pod string) {
+	t.Helper()
+	if err := wait.PollUntilContextTimeout(context.Background(), 20*time.Millisecond, 5*time.Second, true, func(c context.Context) (bool, error) {
+		_, err := tc.persistence.GetWorker(c, ns, "pool1", pod)
+		return errors.Is(err, store.ErrNotFound), nil
+	}); err != nil {
+		t.Fatalf("worker record %s/%s still present", ns, pod)
+	}
+}
+
+// A terminating worker that is idle is removed at once and never receives a new actor.
+func TestDrain_TerminatingIdleWorkerGetsNoNewAssignment(t *testing.T) {
+	tc, ns, cleanup := recoverySetup(t, "ns-drain-idle", "worker-a", "worker-b")
+	defer cleanup()
+	ctx := context.Background()
+
+	beginTermination(t, tc, ns, "worker-a")
+	recordGone(t, tc, ns, "worker-a")
+
+	if err := resume(ctx, tc, "id1"); err != nil {
+		t.Fatalf("resume: %v", err)
+	}
+	a := waitActorStatus(t, tc, "id1", ateapipb.Actor_STATUS_RUNNING, 2*time.Second)
+	if a.GetAteomPodName() != "worker-b" {
+		t.Fatalf("actor placed on %q, want the live worker-b", a.GetAteomPodName())
+	}
+	finishTermination(t, tc, ns, "worker-a")
+}
+
+// The core B′ property: a worker running an actor keeps it through its grace period. The actor is
+// not released (no second copy can start elsewhere), the worker takes no other actor, the actor
+// still suspends normally on it, and only then is the record removed.
+func TestDrain_BoundActorStaysOnItsTerminatingWorkerUntilSuspended(t *testing.T) {
+	tc, ns, cleanup := recoverySetup(t, "ns-drain-busy", "worker-a")
+	defer cleanup()
+	ctx := context.Background()
+
+	if err := resume(ctx, tc, "id1"); err != nil {
+		t.Fatalf("resume id1: %v", err)
+	}
+	waitActorStatus(t, tc, "id1", ateapipb.Actor_STATUS_RUNNING, 2*time.Second)
+	createWorkerPod(t, tc, ns, "worker-b", "node1", "pool1")
+
+	beginTermination(t, tc, ns, "worker-a")
+	time.Sleep(300 * time.Millisecond) // give the syncer every chance to (wrongly) release it
+
+	a, err := tc.persistence.GetActor(ctx, testAtespace, "id1")
+	if err != nil || a.GetStatus() != ateapipb.Actor_STATUS_RUNNING || a.GetAteomPodName() != "worker-a" {
+		t.Fatalf("draining worker lost its actor: %+v err=%v", a, err)
+	}
+	if got := workerAssignee(t, tc, ns, "worker-a"); got != "id1" {
+		t.Fatalf("draining worker claim = %q, want id1", got)
+	}
+
+	// Another actor never lands on the draining worker.
+	createActor(t, tc, ns, "id2")
+	if err := resume(ctx, tc, "id2"); err != nil {
+		t.Fatalf("resume id2: %v", err)
+	}
+	if b := waitActorStatus(t, tc, "id2", ateapipb.Actor_STATUS_RUNNING, 2*time.Second); b.GetAteomPodName() != "worker-b" {
+		t.Fatalf("id2 placed on %q, want worker-b", b.GetAteomPodName())
+	}
+
+	// The turn ends: the post-turn suspend checkpoints on the draining worker as usual.
+	suspend(t, tc, "id1")
+	waitActorStatus(t, tc, "id1", ateapipb.Actor_STATUS_SUSPENDED, 2*time.Second)
+	if n := tc.syncer.reconcileStore(ctx); n != 1 {
+		t.Fatalf("reconcile removed %d records, want the drained worker-a", n)
+	}
+	recordGone(t, tc, ns, "worker-a")
+	finishTermination(t, tc, ns, "worker-a")
+	if got := workerAssignee(t, tc, ns, "worker-b"); got != "id2" {
+		t.Fatalf("worker-b claim changed to %q", got)
+	}
+}
+
+// If the drain outlives the grace period, the kubelet kills the pod; the final delete releases the
+// actor (its execution is gone with the pod) so the next turn restores it elsewhere.
+func TestDrain_KilledDrainReleasesTheActorOnFinalDelete(t *testing.T) {
+	tc, ns, cleanup := recoverySetup(t, "ns-drain-kill", "worker-a")
+	defer cleanup()
+	ctx := context.Background()
+
+	if err := resume(ctx, tc, "id1"); err != nil {
+		t.Fatalf("resume: %v", err)
+	}
+	waitActorStatus(t, tc, "id1", ateapipb.Actor_STATUS_RUNNING, 2*time.Second)
+	beginTermination(t, tc, ns, "worker-a")
+	if a, _ := tc.persistence.GetActor(ctx, testAtespace, "id1"); a.GetStatus() != ateapipb.Actor_STATUS_RUNNING {
+		t.Fatalf("actor released during the grace period: %v", a.GetStatus())
+	}
+	finishTermination(t, tc, ns, "worker-a")
+	a := waitActorStatus(t, tc, "id1", ateapipb.Actor_STATUS_SUSPENDED, 3*time.Second)
+	if a.GetAteomPodName() != "" {
+		t.Fatalf("actor still points at the killed pod: %q", a.GetAteomPodName())
+	}
+	recordGone(t, tc, ns, "worker-a")
+
+	// The next turn restores it on a live worker.
+	createWorkerPod(t, tc, ns, "worker-c", "node1", "pool1")
+	if err := resume(ctx, tc, "id1"); err != nil {
+		t.Fatalf("resume after kill: %v", err)
+	}
+	if a := waitActorStatus(t, tc, "id1", ateapipb.Actor_STATUS_RUNNING, 2*time.Second); a.GetAteomPodName() != "worker-c" {
+		t.Fatalf("actor restored on %q, want worker-c", a.GetAteomPodName())
+	}
+}
+
+var _ = corev1.PodRunning
