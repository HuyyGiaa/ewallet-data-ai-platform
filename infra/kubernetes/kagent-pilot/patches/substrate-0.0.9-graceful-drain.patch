index 0000000..a9a0491
--- /dev/null
+++ b/cmd/ateom-gvisor/drain.go
@@ -0,0 +1,79 @@
+// Copyright 2026 Google LLC
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package main
+
+// ewallet patch (B′ safe scale-in): graceful drain on SIGTERM.
+//
+// Upstream ateom installs no signal handler, so the Go runtime exits on the SIGTERM that the
+// kubelet sends when a worker pod is deleted (a scale-in, a rollout): the actor running a turn
+// was killed mid-turn. With this patch ateom stops accepting new activations (Run/Restore answer
+// Unavailable), keeps the active sandbox running until its turn ends and the post-turn
+// checkpoint clears it, then stops serving and exits. The pod's terminationGracePeriodSeconds
+// (atecontroller patch) bounds the wait; the kubelet's SIGKILL ends a drain that outlives it.
+
+import (
+	"context"
+	"log/slog"
+	"time"
+
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+const drainPollInterval = 500 * time.Millisecond
+
+// errDraining is returned to activations that arrive while the worker pod is terminating.
+var errDraining = status.Error(codes.Unavailable, "ateom is draining: the worker pod is terminating")
+
+// beginDrain marks the service as draining. Activations started afterwards are refused.
+func (s *AteomService) beginDrain() {
+	s.lock.Lock()
+	defer s.lock.Unlock()
+	s.draining = true
+}
+
+// idle reports whether no sandbox is active (no actor running on this worker).
+func (s *AteomService) idle() bool {
+	s.lock.Lock()
+	defer s.lock.Unlock()
+	return s.active == nil
+}
+
+// waitIdle blocks until no sandbox is active or ctx ends; it reports whether the worker drained.
+func (s *AteomService) waitIdle(ctx context.Context, poll time.Duration) bool {
+	ticker := time.NewTicker(poll)
+	defer ticker.Stop()
+	for {
+		if s.idle() {
+			return true
+		}
+		select {
+		case <-ctx.Done():
+			return false
+		case <-ticker.C:
+		}
+	}
+}
+
+// drain runs once SIGTERM arrives: refuse new activations, wait for the active actor to be
+// checkpointed, then stop the server (stop returns only after in-flight RPCs finish).
+func (s *AteomService) drain(ctx context.Context, stop func()) {
+	s.beginDrain()
+	start := time.Now()
+	slog.InfoContext(ctx, "ateom draining: no new activations; waiting for the active actor to be checkpointed")
+	drained := s.waitIdle(ctx, drainPollInterval)
+	slog.InfoContext(ctx, "ateom drain finished", slog.Bool("idle", drained), slog.Duration("waited", time.Since(start)))
+	stop()
+}
