+package main
+
+import (
+	"context"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/agent-substrate/substrate/internal/proto/ateompb"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+func TestDrain_RefusesNewActivations(t *testing.T) {
+	s := &AteomService{}
+	s.beginDrain()
+	if _, err := s.RunWorkload(context.Background(), &ateompb.RunWorkloadRequest{}); status.Code(err) != codes.Unavailable {
+		t.Fatalf("RunWorkload while draining: want Unavailable, got %v", err)
+	}
+	if _, err := s.RestoreWorkload(context.Background(), &ateompb.RestoreWorkloadRequest{}); status.Code(err) != codes.Unavailable {
+		t.Fatalf("RestoreWorkload while draining: want Unavailable, got %v", err)
+	}
+}
+
+func TestDrain_WaitsForTheActiveActorThenStops(t *testing.T) {
+	s := &AteomService{active: &activeSandbox{}}
+	var stopped atomic.Bool
+	done := make(chan struct{})
+	go func() {
+		s.drain(context.Background(), func() { stopped.Store(true) })
+		close(done)
+	}()
+	time.Sleep(3 * drainPollInterval)
+	if stopped.Load() {
+		t.Fatal("ateom stopped while an actor was still active")
+	}
+	// The post-turn checkpoint clears the active sandbox (CheckpointWorkload).
+	s.lock.Lock()
+	s.active = nil
+	s.lock.Unlock()
+	select {
+	case <-done:
+	case <-time.After(5 * drainPollInterval):
+		t.Fatal("ateom did not stop after the actor was checkpointed")
+	}
+	if !stopped.Load() {
+		t.Fatal("stop was not called")
+	}
+}
+
+func TestDrain_IdleWorkerStopsAtOnce(t *testing.T) {
+	s := &AteomService{}
+	start := time.Now()
+	s.drain(context.Background(), func() {})
+	if time.Since(start) > drainPollInterval {
+		t.Fatalf("idle drain took %v", time.Since(start))
+	}
+}
+
+func TestDrain_EndsWhenTheContextEnds(t *testing.T) {
+	s := &AteomService{active: &activeSandbox{}}
+	ctx, cancel := context.WithTimeout(context.Background(), 2*drainPollInterval)
+	defer cancel()
+	if s.waitIdle(ctx, 50*time.Millisecond) {
+		t.Fatal("waitIdle reported idle with an active sandbox")
+	}
+}
