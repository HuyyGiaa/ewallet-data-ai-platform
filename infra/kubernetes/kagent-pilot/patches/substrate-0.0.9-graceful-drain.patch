+// usableOnly drops workers whose pod is missing or terminating (ewallet patch, B′).
+func (s *AssignWorkerStep) usableOnly(workers []*ateapipb.Worker) []*ateapipb.Worker {
+	if s.usable == nil {
+		return workers
+	}
+	out := make([]*ateapipb.Worker, 0, len(workers))
+	for _, w := range workers {
+		if s.workerUsable(w) {
+			out = append(out, w)
+		}
+	}
+	return out
