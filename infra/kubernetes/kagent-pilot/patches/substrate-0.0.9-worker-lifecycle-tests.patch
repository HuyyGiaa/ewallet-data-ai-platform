+// A record whose pod now carries another pool label belongs to the old pool: it is removed and
+// the pod is registered under its current pool.
+func TestSyncerReconcile_PoolChangeReRegisters(t *testing.T) {
+	t.Setenv("ATE_WORKER_RECONCILE_INTERVAL", "0")
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+
+	f := newRecFixture(t, recPod("moved", "00000000-0000-4000-8000-000000000201", "10.0.0.7"))
+	old := recStoreWorker("moved", "00000000-0000-4000-8000-000000000201", "10.0.0.7")
+	old.WorkerPool = "pool-old"
+	if err := f.persistence.CreateWorker(ctx, old); err != nil {
+		t.Fatalf("seed: %v", err)
+	}
+	f.start(ctx)
+	poll(t, ctx, "old-pool record removed", func(c context.Context) (bool, error) {
+		_, err := f.persistence.GetWorker(c, recNS, "pool-old", "moved")
+		return errors.Is(err, store.ErrNotFound), nil
+	})
+	poll(t, ctx, "registered under the current pool", func(c context.Context) (bool, error) {
+		_, err := f.persistence.GetWorker(c, recNS, recPool, "moved")
+		return err == nil, nil
+	})
+	if n := f.syncer.reconcileStore(ctx); n != 0 {
+		t.Errorf("second pass removed %d, want 0", n)
+	}
+}
+
+// failingDeletes makes DeleteWorker fail while fail is set; every other call passes through.
+type failingDeletes struct {
+	store.Interface
+	fail bool
+}
+
+func (f *failingDeletes) DeleteWorker(ctx context.Context, ns, pool, pod string) error {
+	if f.fail {
+		return errors.New("injected store failure")
+	}
+	return f.Interface.DeleteWorker(ctx, ns, pool, pod)
+}
+
+// A failed store delete is not counted, leaves the record for the next pass, and the next pass
+// removes it.
+func TestSyncerReconcile_StoreFailureIsRetriedNextPass(t *testing.T) {
+	t.Setenv("ATE_WORKER_RECONCILE_INTERVAL", "0")
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+
+	f := newRecFixture(t, recPod("live-3", "00000000-0000-4000-8000-000000000301", "10.0.0.8"))
+	if err := f.persistence.CreateWorker(ctx, recStoreWorker("gone-3", "00000000-0000-4000-8000-000000000302", "10.9.9.6")); err != nil {
+		t.Fatalf("seed: %v", err)
+	}
+	f.start(ctx)
+	poll(t, ctx, "startup pass removed the record", workerGone(ctx, f.persistence, "gone-3"))
+
+	if err := f.persistence.CreateWorker(ctx, recStoreWorker("gone-4", "00000000-0000-4000-8000-000000000303", "10.9.9.5")); err != nil {
+		t.Fatalf("seed: %v", err)
+	}
+	wrapped := &failingDeletes{Interface: f.persistence, fail: true}
+	f.syncer.persistence = wrapped
+	if n := f.syncer.reconcileStore(ctx); n != 0 {
+		t.Fatalf("a failed delete was counted: %d", n)
+	}
+	if _, err := f.persistence.GetWorker(ctx, recNS, recPool, "gone-4"); err != nil {
+		t.Fatalf("record lost although the delete failed: %v", err)
+	}
+	wrapped.fail = false
+	if n := f.syncer.reconcileStore(ctx); n != 1 {
+		t.Fatalf("next pass removed %d, want 1", n)
+	}
+	if _, err := f.persistence.GetWorker(ctx, recNS, "pool-rec", "live-3"); err != nil {
+		t.Fatalf("live worker removed: %v", err)
+	}
+}
