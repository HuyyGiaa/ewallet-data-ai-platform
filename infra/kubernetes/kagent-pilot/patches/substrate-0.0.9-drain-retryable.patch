+// workerWithdrawn reports whether a failed restore is explained by the claimed worker leaving the
+// pool: its pod is missing or terminating, or its ateom refused the activation while draining.
+func (w *ActorWorkflow) workerWithdrawn(state *ResumeState, err error) (bool, string) {
+	if state == nil || state.Actor == nil {
+		return false, ""
+	}
+	ns, pod := state.Actor.GetAteomPodNamespace(), state.Actor.GetAteomPodName()
+	if pod == "" {
+		return false, ""
+	}
+	if strings.Contains(err.Error(), "ateom is draining") {
+		return true, ns + "/" + pod
+	}
+	return w.dialer != nil && !w.dialer.WorkerUsable(ns, pod), ns + "/" + pod
+}
