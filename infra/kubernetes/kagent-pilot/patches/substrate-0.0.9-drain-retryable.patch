+// A restore that its claimed worker refuses because ateom is draining ran nothing: it is reported
+// as a full pool (kagent: "no free workers"; the Coordinator waits and retries) and the actor is
+// rolled back, so the retry lands on a live worker (GKE R3, 2026-11-16).
+func TestDrain_RestoreRefusedByDrainingAteomIsReportedAsNoFreeWorkers(t *testing.T) {
+	tc, ns, cleanup := recoverySetup(t, "ns-drain-refused", "worker-a")
+	defer cleanup()
+	tc.fakeAtelet.FailRestore = status.Error(codes.Unavailable, "ateom is draining: the worker pod is terminating")
+	err := resume(context.Background(), tc, "id1")
+	if status.Code(err) != codes.FailedPrecondition || !strings.Contains(err.Error(), "no free workers") {
+		t.Fatalf("want FailedPrecondition no free workers, got %v", err)
+	}
+	a := waitActorStatus(t, tc, "id1", ateapipb.Actor_STATUS_SUSPENDED, 2*time.Second)
+	if a.GetAteomPodName() != "" || workerAssignee(t, tc, ns, "worker-a") != "" {
+		t.Fatalf("rollback incomplete: actor on %q", a.GetAteomPodName())
+	}
+}
+
+// The claimed worker's pod starts terminating while the restore is still being prepared (the GKE
+// R3 case: atelet had not reached ateom yet). The failed restore is a full pool, not an error.
+func TestDrain_WorkerTerminatingDuringRestoreIsReportedAsNoFreeWorkers(t *testing.T) {
+	tc, ns, cleanup := recoverySetup(t, "ns-drain-during", "worker-a")
+	defer cleanup()
+	tc.fakeAtelet.RestoreDelay = time.Second
+	tc.fakeAtelet.FailRestore = status.Error(codes.Unavailable, "connection error: ateom exited")
+	errCh := make(chan error, 1)
+	go func() { errCh <- resume(context.Background(), tc, "id1") }()
+	waitActorStatus(t, tc, "id1", ateapipb.Actor_STATUS_RESUMING, 2*time.Second)
+	beginTermination(t, tc, ns, "worker-a")
+	err := <-errCh
+	if status.Code(err) != codes.FailedPrecondition || !strings.Contains(err.Error(), "no free workers") {
+		t.Fatalf("want FailedPrecondition no free workers, got %v", err)
+	}
+	waitActorStatus(t, tc, "id1", ateapipb.Actor_STATUS_SUSPENDED, 2*time.Second)
+
+	// The retry restores on a live worker.
+	createWorkerPod(t, tc, ns, "worker-b", "node1", "pool1")
+	tc.fakeAtelet.Lock.Lock()
+	tc.fakeAtelet.FailRestore, tc.fakeAtelet.RestoreDelay = nil, 0
+	tc.fakeAtelet.Lock.Unlock()
+	if err := resume(context.Background(), tc, "id1"); err != nil {
+		t.Fatalf("retry: %v", err)
+	}
+	if a := waitActorStatus(t, tc, "id1", ateapipb.Actor_STATUS_RUNNING, 2*time.Second); a.GetAteomPodName() != "worker-b" {
+		t.Fatalf("retry placed on %q, want worker-b", a.GetAteomPodName())
+	}
+	finishTermination(t, tc, ns, "worker-a")
+}
+
+// An ordinary restore failure on a live worker keeps its own error (not a capacity wait).
+func TestDrain_OrdinaryRestoreFailureKeepsItsError(t *testing.T) {
+	tc, _, cleanup := recoverySetup(t, "ns-drain-ordinary", "worker-a")
+	defer cleanup()
+	tc.fakeAtelet.FailRestore = status.Error(codes.Internal, "image pull failed")
+	err := resume(context.Background(), tc, "id1")
+	if err == nil || status.Code(err) == codes.FailedPrecondition || strings.Contains(err.Error(), "no free workers") {
+		t.Fatalf("an ordinary failure must not look like a full pool: %v", err)
+	}
+}
