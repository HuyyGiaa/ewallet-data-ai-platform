diff --git a/cmd/ateom-gvisor/sandbox_teardown.go b/cmd/ateom-gvisor/sandbox_teardown.go
new file mode 100644
index 0000000..2d272bc
--- /dev/null
+++ b/cmd/ateom-gvisor/sandbox_teardown.go
@@ -0,0 +1,161 @@
+//go:build linux
+
+// ewallet patch: a failed or cancelled activation must not leave a sandbox behind.
+//
+// Upstream v0.0.9 RunWorkload/RestoreWorkload return on the first error (including a cancelled
+// readyz wait) after cleaning up only the actor network. Containers already created by
+// `runsc create`/`start`/`restore` keep running: on GKE the application inside a restore that
+// ate-api had abandoned finished booting seven seconds later. The worker then holds a sandbox no
+// controller knows about, and a retried restore of the same actor would start a second one
+// (atelet resets the actor's runsc state directory before calling ateom).
+//
+// The worker runs one actor at a time, so the invariants here are simple:
+//   - activation tears down every container it created when it does not succeed;
+//   - a successful activation is recorded as the worker's active sandbox, and cleared by a
+//     successful checkpoint cleanup;
+//   - before a new activation, a still-recorded active sandbox is torn down first.
+//
+// Every teardown runs on a context detached from the (possibly cancelled) request and bounded
+// by sandboxTeardownTimeout.
+
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"log/slog"
+	"os"
+	"os/exec"
+	"strings"
+	"syscall"
+	"time"
+
+	"github.com/agent-substrate/substrate/internal/ateompath"
+)
+
+const sandboxTeardownTimeout = 30 * time.Second
+
+// activeSandbox is what ateom needs to tear a sandbox down later.
+type activeSandbox struct {
+	runsc      runsc
+	containers []string // creation order; "pause" first
+	pids       []int    // host PIDs from `runsc state`, used when the state directory is gone
+}
+
+// trackedActivation collects the containers an activation creates.
+type trackedActivation struct {
+	sandbox activeSandbox
+}
+
+func newTrackedActivation(r *runsc) *trackedActivation {
+	return &trackedActivation{sandbox: activeSandbox{runsc: *r}}
+}
+
+func (t *trackedActivation) created(name string) {
+	t.sandbox.containers = append(t.sandbox.containers, name)
+}
+
+// teardown force-deletes the created containers, newest first, then kills any recorded sandbox
+// PID that is still a runsc process. Errors are joined; nothing is retried beyond the bound.
+func (a *activeSandbox) teardown(parent context.Context, reason string) error {
+	if a == nil || len(a.containers) == 0 && len(a.pids) == 0 {
+		return nil
+	}
+	ctx, cancel := context.WithTimeout(context.WithoutCancel(parent), sandboxTeardownTimeout)
+	defer cancel()
+	log := slog.With(slog.String("atespace", a.runsc.atespace), slog.String("actor", a.runsc.actorID), slog.String("reason", reason))
+	var errs error
+	if _, err := os.Stat(ateompath.RunSCStateDir(a.runsc.atespace, a.runsc.actorID)); err == nil {
+		for i := len(a.containers) - 1; i >= 0; i-- {
+			if err := a.runsc.cmdDelete(ctx, a.containers[i]); err != nil {
+				errs = errors.Join(errs, fmt.Errorf("delete %q: %w", a.containers[i], err))
+			}
+		}
+	}
+	for _, pid := range a.pids {
+		if err := killRunscPID(pid); err != nil {
+			errs = errors.Join(errs, err)
+		}
+	}
+	if errs != nil {
+		log.WarnContext(ctx, "Sandbox teardown incomplete", slog.Any("err", errs))
+	} else {
+		log.InfoContext(ctx, "Sandbox torn down", slog.Int("containers", len(a.containers)))
+	}
+	return errs
+}
+
+// recordPIDs reads the host PID of each created container so a later teardown still works after
+// atelet has removed the runsc state directory. Best effort: a missing PID only weakens that
+// fallback.
+func (a *activeSandbox) recordPIDs(ctx context.Context) {
+	for _, name := range a.containers {
+		if pid, err := a.runsc.statePID(ctx, name); err == nil && pid > 0 {
+			a.pids = append(a.pids, pid)
+		}
+	}
+}
+
+func (r *runsc) statePID(ctx context.Context, containerName string) (int, error) {
+	reapLock.RLock()
+	defer reapLock.RUnlock()
+	out, err := exec.CommandContext(ctx, r.path, "-root", ateompath.RunSCStateDir(r.atespace, r.actorID), "state", containerName).Output()
+	if err != nil {
+		return 0, err
+	}
+	var st struct {
+		Pid int `json:"pid"`
+	}
+	if err := json.Unmarshal(out, &st); err != nil {
+		return 0, err
+	}
+	return st.Pid, nil
+}
+
+// killRunscPID sends SIGKILL to pid only if it is still a runsc process, so a recycled PID of an
+// unrelated process is never signalled.
+func killRunscPID(pid int) error {
+	cmdline, err := os.ReadFile(fmt.Sprintf("/proc/%d/cmdline", pid))
+	if err != nil {
+		return nil // already gone
+	}
+	if !strings.Contains(strings.ReplaceAll(string(cmdline), "\x00", " "), "runsc") {
+		return nil
+	}
+	if err := syscall.Kill(pid, syscall.SIGKILL); err != nil && !errors.Is(err, syscall.ESRCH) {
+		return fmt.Errorf("kill sandbox pid %d: %w", pid, err)
+	}
+	return nil
+}
+
+// finishActivation applies the activation invariants. Called with s.lock held, as the last
+// deferred step of RunWorkload/RestoreWorkload.
+//   - failure: tear down what was created;
+//   - success, but the caller is gone (ctx done): the caller will treat the activation as failed
+//     and roll the actor back, so a running sandbox here would be unowned. Tear it down and
+//     report failure instead of a success nobody receives.
+//   - success: remember the sandbox as the worker's active one.
+func (s *AteomService) finishActivation(ctx context.Context, t *trackedActivation, retErr *error) {
+	if *retErr == nil && ctx.Err() != nil {
+		*retErr = fmt.Errorf("activation finished after its caller gave up: %w", context.Cause(ctx))
+	}
+	if *retErr != nil {
+		_ = t.sandbox.teardown(ctx, "activation failed")
+		return
+	}
+	t.sandbox.recordPIDs(context.WithoutCancel(ctx))
+	s.active = &t.sandbox
+}
+
+// clearStaleActive tears down a sandbox left recorded by an earlier activation that was never
+// checkpointed (for example, a successful restore whose checkpoint later failed). Called with
+// s.lock held at the start of an activation.
+func (s *AteomService) clearStaleActive(ctx context.Context) {
+	if s.active == nil {
+		return
+	}
+	_ = s.active.teardown(ctx, "stale sandbox before a new activation")
+	s.active = nil
+}
diff --git a/cmd/ateom-gvisor/sandbox_teardown_test.go b/cmd/ateom-gvisor/sandbox_teardown_test.go
new file mode 100644
index 0000000..f7b5713
--- /dev/null
+++ b/cmd/ateom-gvisor/sandbox_teardown_test.go
@@ -0,0 +1,190 @@
+//go:build linux
+
+// ewallet patch tests. They need write access to ateompath.BasePath (run as root in a throwaway
+// container) and use a fake runsc that records its arguments.
+
+package main
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/agent-substrate/substrate/internal/ateompath"
+)
+
+type fakeRunsc struct {
+	path, log string
+	pid       int
+}
+
+// newFakeRunsc writes a runsc stand-in: every call is appended to log; `state` prints the PID of a
+// long-running process whose argv[0] contains "runsc", standing in for the gVisor sandbox.
+func newFakeRunsc(t *testing.T, atespace, actor string) (*fakeRunsc, *exec.Cmd) {
+	t.Helper()
+	if os.Geteuid() != 0 {
+		t.Skip("needs root to write " + ateompath.BasePath)
+	}
+	dir := t.TempDir()
+	sandbox := exec.Command("bash", "-c", "exec -a runsc-sandbox sleep 300")
+	if err := sandbox.Start(); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = sandbox.Process.Kill(); _, _ = sandbox.Process.Wait() })
+	f := &fakeRunsc{path: filepath.Join(dir, "runsc"), log: filepath.Join(dir, "calls"), pid: sandbox.Process.Pid}
+	script := fmt.Sprintf("#!/bin/bash\necho \"$*\" >> %s\nfor a in \"$@\"; do [ \"$a\" = state ] && echo '{\"pid\": %d}'; done\nexit 0\n", f.log, f.pid)
+	if err := os.WriteFile(f.path, []byte(script), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.MkdirAll(ateompath.RunSCStateDir(atespace, actor), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = os.RemoveAll(filepath.Dir(ateompath.RunSCStateDir(atespace, actor))) })
+	return f, sandbox
+}
+
+func (f *fakeRunsc) calls(t *testing.T) []string {
+	t.Helper()
+	b, err := os.ReadFile(f.log)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	var out []string
+	for _, l := range strings.Split(strings.TrimSpace(string(b)), "\n") {
+		out = append(out, l)
+	}
+	return out
+}
+
+func deletes(calls []string) []string {
+	var out []string
+	for _, c := range calls {
+		if i := strings.Index(c, "delete -force "); i >= 0 {
+			out = append(out, c[i+len("delete -force "):])
+		}
+	}
+	return out
+}
+
+func alive(pid int) bool {
+	b, err := os.ReadFile(fmt.Sprintf("/proc/%d/stat", pid))
+	if err != nil {
+		return false
+	}
+	// A killed but unreaped child is a zombie (state Z): no longer running.
+	fields := strings.Fields(string(b))
+	return len(fields) > 2 && fields[2] != "Z"
+}
+
+func TestFailedActivationTearsDownCreatedContainers(t *testing.T) {
+	f, _ := newFakeRunsc(t, "as", "a1")
+	s := &AteomService{}
+	act := newTrackedActivation(&runsc{path: f.path, atespace: "as", actorID: "a1"})
+	act.created("pause")
+	act.created("kagent")
+	err := errors.New("while waiting for container readyz: context canceled")
+	s.finishActivation(context.Background(), act, &err)
+	if got := deletes(f.calls(t)); strings.Join(got, ",") != "kagent,pause" {
+		t.Fatalf("want app then pause force-deleted, got %v", got)
+	}
+	if s.active != nil {
+		t.Fatal("a failed activation must not become the active sandbox")
+	}
+}
+
+func TestSuccessAfterCallerGaveUpIsTornDown(t *testing.T) {
+	f, _ := newFakeRunsc(t, "as", "a2")
+	s := &AteomService{}
+	act := newTrackedActivation(&runsc{path: f.path, atespace: "as", actorID: "a2"})
+	act.created("pause")
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	var err error
+	s.finishActivation(ctx, act, &err)
+	if err == nil || !strings.Contains(err.Error(), "after its caller gave up") {
+		t.Fatalf("want failure reported, got %v", err)
+	}
+	if got := deletes(f.calls(t)); strings.Join(got, ",") != "pause" {
+		t.Fatalf("want pause force-deleted, got %v", got)
+	}
+}
+
+func TestSuccessfulActivationIsRecordedAndStaleOneClearedFirst(t *testing.T) {
+	f, sandbox := newFakeRunsc(t, "as", "a3")
+	s := &AteomService{}
+	act := newTrackedActivation(&runsc{path: f.path, atespace: "as", actorID: "a3"})
+	act.created("pause")
+	act.created("kagent")
+	var err error
+	s.finishActivation(context.Background(), act, &err)
+	if err != nil || s.active == nil || len(s.active.pids) != 2 || s.active.pids[0] != f.pid {
+		t.Fatalf("want active sandbox with recorded pids, got err=%v active=%+v", err, s.active)
+	}
+	// atelet resets the actor's runsc state directory before a retried restore of the same
+	// actor: teardown must then fall back to the recorded PID.
+	if err := os.RemoveAll(ateompath.RunSCStateDir("as", "a3")); err != nil {
+		t.Fatal(err)
+	}
+	s.clearStaleActive(context.Background())
+	if s.active != nil {
+		t.Fatal("stale sandbox still recorded")
+	}
+	go func() { _, _ = sandbox.Process.Wait() }()
+	deadline := time.Now().Add(3 * time.Second)
+	for alive(f.pid) && time.Now().Before(deadline) {
+		time.Sleep(20 * time.Millisecond)
+	}
+	if alive(f.pid) {
+		t.Fatal("stale sandbox process still running")
+	}
+}
+
+func TestKillRunscPIDLeavesOtherProcessesAlone(t *testing.T) {
+	other := exec.Command("sleep", "300")
+	if err := other.Start(); err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = other.Process.Kill(); _, _ = other.Process.Wait() }()
+	if err := killRunscPID(other.Process.Pid); err != nil {
+		t.Fatal(err)
+	}
+	if err := other.Process.Signal(syscall.Signal(0)); err != nil {
+		t.Fatalf("a non-runsc process was signalled: %v", err)
+	}
+	if err := killRunscPID(1 << 30); err != nil {
+		t.Fatalf("a missing pid is not an error: %v", err)
+	}
+}
+
+func TestTeardownIsBoundedOnAHungRunsc(t *testing.T) {
+	if os.Geteuid() != 0 {
+		t.Skip("needs root")
+	}
+	dir := t.TempDir()
+	hung := filepath.Join(dir, "runsc")
+	if err := os.WriteFile(hung, []byte("#!/bin/bash\nexec sleep 300\n"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.MkdirAll(ateompath.RunSCStateDir("as", "a5"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(filepath.Dir(ateompath.RunSCStateDir("as", "a5")))
+	a := &activeSandbox{runsc: runsc{path: hung, atespace: "as", actorID: "a5"}, containers: []string{"pause"}}
+	ctx, cancel := context.WithTimeout(context.Background(), 200*time.Millisecond)
+	defer cancel()
+	start := time.Now()
+	_ = a.teardown(ctx, "test")
+	if took := time.Since(start); took > sandboxTeardownTimeout+5*time.Second {
+		t.Fatalf("teardown not bounded: %v", took)
+	}
+}
