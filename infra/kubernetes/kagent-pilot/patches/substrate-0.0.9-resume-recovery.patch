 func (s *FinalizeRunningStep) RetryBackoff() *wait.Backoff { return nil }
+
+// restoreOutcome records whether a failed Run/Restore left the actor for rollback. A crash
+// (codes.DataLoss from maybeCrashActor) already moved the actor to CRASHED and is not rolled back.
+func restoreOutcome(state *ResumeState, err error) error {
+	if err != nil && status.Code(err) != codes.DataLoss {
+		state.RestoreFailed = true
+	}
+	return err
+}
+
+// resumeRollbackTimeout bounds the rollback writes; the workflow context may already be expired.
+const resumeRollbackTimeout = 15 * time.Second
+
+// rollbackFailedResume returns an actor whose Run/Restore failed to a resumable state and frees
+// its worker (ewallet patch). It runs after the atelet call has returned, while the workflow
+// still holds the actor lock (skipped if the lock was lost), so no other workflow can move the actor in between; the worker is
+// released only if it is still assigned to this actor (version-checked write), and the actor
+// only if it is still RESUMING. The snapshot pointers are untouched: the next ResumeActor restores
+// from the same snapshot (or golden). Prior PAUSED/PAUSING actors keep node-local state that this
+// rollback cannot reason about, so they are left as they are.
+func rollbackFailedResume(ctx context.Context, st store.Interface, input *ResumeInput, state *ResumeState) {
+	switch state.PriorStatus {
+	case ateapipb.Actor_STATUS_PAUSED, ateapipb.Actor_STATUS_PAUSING:
+		return
+	}
+	if errors.Is(context.Cause(ctx), errLostActorLock) {
+		// Another workflow may own the actor now; leave it to that owner.
+		slog.WarnContext(ctx, "Resume rollback skipped: actor lock lost", slog.String("actor", input.ActorName))
+		return
+	}
+	rctx, cancel := context.WithTimeout(context.WithoutCancel(ctx), resumeRollbackTimeout)
+	defer cancel()
+	log := slog.With(slog.String("atespace", input.Atespace), slog.String("actor", input.ActorName))
+
+	actor, err := st.GetActor(rctx, input.Atespace, input.ActorName)
+	if err != nil {
+		log.ErrorContext(rctx, "Resume rollback: cannot load actor", slog.Any("err", err))
+		return
+	}
+	if actor.GetStatus() != ateapipb.Actor_STATUS_RESUMING {
+		return
+	}
+	if pod := actor.GetAteomPodName(); pod != "" {
+		worker, err := st.GetWorker(rctx, actor.GetAteomPodNamespace(), actor.GetWorkerPoolName(), pod)
+		switch {
+		case errors.Is(err, store.ErrNotFound):
+		case err != nil:
+			log.ErrorContext(rctx, "Resume rollback: cannot load worker; actor stays RESUMING", slog.Any("err", err))
+			return
+		default:
+			if a := worker.GetAssignment(); a != nil && a.GetActor().GetAtespace() == input.Atespace && a.GetActor().GetName() == input.ActorName {
+				worker.Assignment = nil
+				if err := st.UpdateWorker(rctx, worker, worker.GetVersion()); err != nil {
+					log.ErrorContext(rctx, "Resume rollback: cannot release worker; actor stays RESUMING", slog.Any("err", err))
+					return
+				}
+			}
+		}
+	}
+	actor.Status = ateapipb.Actor_STATUS_SUSPENDED
+	actor.AteomPodNamespace = ""
+	actor.AteomPodName = ""
+	actor.AteomPodIp = ""
+	actor.AteomPodUid = ""
+	actor.WorkerPoolName = ""
+	if _, err := st.UpdateActor(rctx, actor, actor.GetMetadata().GetVersion()); err != nil {
+		log.ErrorContext(rctx, "Resume rollback: worker released but actor update failed", slog.Any("err", err))
+		return
+	}
+	log.InfoContext(rctx, "Resume rolled back after a failed restore; actor SUSPENDED and worker released")
+}
