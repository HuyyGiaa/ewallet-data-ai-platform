--- /dev/null
+++ b/cmd/ateapi/internal/controlapi/functional_recovery_test.go
@@ -0,0 +1,224 @@
+// ewallet patch: failure-injection tests for resume cancellation and rollback. They run the real
+// ActorWorkflow over gRPC against the package's envtest + miniredis + fake atelet harness.
+
+package controlapi
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"testing"
+	"time"
+
+	"github.com/agent-substrate/substrate/internal/ateerrors"
+	"github.com/agent-substrate/substrate/pkg/proto/ateapipb"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+	"k8s.io/apimachinery/pkg/util/wait"
+)
+
+func recoverySetup(t *testing.T, base string, workers ...string) (*testContext, string, func()) {
+	t.Helper()
+	ns := namespaceForTest(base)
+	tc := setupTest(t, ns)
+	createTemplate(t, tc, ns)
+	for _, w := range workers {
+		createWorkerPod(t, tc, ns, w, "node1", "pool1")
+	}
+	name := "id1"
+	if _, err := tc.client.CreateActor(context.Background(), &ateapipb.CreateActorRequest{Actor: &ateapipb.Actor{
+		Metadata:               &ateapipb.ResourceMetadata{Atespace: testAtespace, Name: name},
+		ActorTemplateNamespace: ns,
+		ActorTemplateName:      "tmpl1",
+	}}); err != nil {
+		t.Fatalf("CreateActor: %v", err)
+	}
+	return tc, ns, tc.cleanup
+}
+
+func resume(ctx context.Context, tc *testContext, name string) error {
+	_, err := tc.client.ResumeActor(ctx, &ateapipb.ResumeActorRequest{Actor: &ateapipb.ObjectRef{Atespace: testAtespace, Name: name}})
+	return err
+}
+
+func waitActorStatus(t *testing.T, tc *testContext, name string, want ateapipb.Actor_Status, within time.Duration) *ateapipb.Actor {
+	t.Helper()
+	var last *ateapipb.Actor
+	err := wait.PollUntilContextTimeout(context.Background(), 50*time.Millisecond, within, true, func(ctx context.Context) (bool, error) {
+		a, err := tc.persistence.GetActor(ctx, testAtespace, name)
+		if err != nil {
+			return false, nil
+		}
+		last = a
+		return a.GetStatus() == want, nil
+	})
+	if err != nil {
+		t.Fatalf("actor %s: want %v within %v, last %v", name, want, within, last.GetStatus())
+	}
+	return last
+}
+
+// workerAssignee returns the actor a worker is assigned to ("" when free).
+func workerAssignee(t *testing.T, tc *testContext, ns, pod string) string {
+	t.Helper()
+	w, err := tc.persistence.GetWorker(context.Background(), ns, "pool1", pod)
+	if err != nil {
+		t.Fatalf("GetWorker %s: %v", pod, err)
+	}
+	return w.GetAssignment().GetActor().GetName()
+}
+
+// F2/F3 regression: the caller's RPC deadline expires during a slow restore. Upstream cancelled
+// the workflow mid-restore and left the actor RESUMING on a claimed worker forever. The patched
+// workflow keeps running, so the actor ends RUNNING on its worker and nothing is stranded.
+func TestResumeActor_CallerDeadlineDoesNotStrandActor(t *testing.T) {
+	tc, ns, cleanup := recoverySetup(t, "ns-rec-deadline", "worker-1")
+	defer cleanup()
+	tc.fakeAtelet.RestoreDelay = 1500 * time.Millisecond
+
+	ctx, cancel := context.WithTimeout(context.Background(), 300*time.Millisecond)
+	defer cancel()
+	if err := resume(ctx, tc, "id1"); status.Code(err) != codes.DeadlineExceeded {
+		t.Fatalf("caller should see its own deadline, got %v", err)
+	}
+	a := waitActorStatus(t, tc, "id1", ateapipb.Actor_STATUS_RUNNING, 5*time.Second)
+	if a.GetAteomPodName() != "worker-1" || workerAssignee(t, tc, ns, "worker-1") != "id1" {
+		t.Fatalf("RUNNING actor must own its worker: actor on %q, worker assigned to %q", a.GetAteomPodName(), workerAssignee(t, tc, ns, "worker-1"))
+	}
+}
+
+// A restore that fails after the caller gave up is still rolled back: SUSPENDED, worker free.
+func TestResumeActor_CallerDeadlineThenRestoreFailureRollsBack(t *testing.T) {
+	tc, ns, cleanup := recoverySetup(t, "ns-rec-deadline-fail", "worker-1")
+	defer cleanup()
+	tc.fakeAtelet.RestoreDelay = 1 * time.Second
+	tc.fakeAtelet.FailRestore = fmt.Errorf("readyz cancelled")
+
+	ctx, cancel := context.WithTimeout(context.Background(), 200*time.Millisecond)
+	defer cancel()
+	_ = resume(ctx, tc, "id1")
+	// RESUMING while the restore runs, then rolled back.
+	waitActorStatus(t, tc, "id1", ateapipb.Actor_STATUS_RESUMING, 2*time.Second)
+	a := waitActorStatus(t, tc, "id1", ateapipb.Actor_STATUS_SUSPENDED, 5*time.Second)
+	if a.GetAteomPodName() != "" || a.GetWorkerPoolName() != "" {
+		t.Fatalf("rolled-back actor keeps worker fields: %+v", a)
+	}
+	if got := workerAssignee(t, tc, ns, "worker-1"); got != "" {
+		t.Fatalf("worker still assigned to %q after rollback", got)
+	}
+}
+
+// After a rollback the WorkerPool has capacity again: another actor resumes on the same worker,
+// and the rolled-back actor resumes later with its identity unchanged.
+func TestResumeActor_CapacityReturnsAfterFailedRestore(t *testing.T) {
+	tc, ns, cleanup := recoverySetup(t, "ns-rec-capacity", "worker-1")
+	defer cleanup()
+	if _, err := tc.client.CreateActor(context.Background(), &ateapipb.CreateActorRequest{Actor: &ateapipb.Actor{
+		Metadata: &ateapipb.ResourceMetadata{Atespace: testAtespace, Name: "id2"}, ActorTemplateNamespace: ns, ActorTemplateName: "tmpl1",
+	}}); err != nil {
+		t.Fatalf("CreateActor id2: %v", err)
+	}
+	tc.fakeAtelet.FailRestore = fmt.Errorf("mock restore failure")
+	if err := resume(context.Background(), tc, "id1"); err == nil {
+		t.Fatal("expected the first restore to fail")
+	}
+	tc.fakeAtelet.FailRestore = nil
+	if err := resume(context.Background(), tc, "id2"); err != nil {
+		t.Fatalf("single worker must be free after rollback, got %v", err)
+	}
+	if got := workerAssignee(t, tc, ns, "worker-1"); got != "id2" {
+		t.Fatalf("worker assigned to %q, want id2", got)
+	}
+	if _, err := tc.client.SuspendActor(context.Background(), &ateapipb.SuspendActorRequest{Actor: &ateapipb.ObjectRef{Atespace: testAtespace, Name: "id2"}}); err != nil {
+		t.Fatalf("SuspendActor id2: %v", err)
+	}
+	if err := resume(context.Background(), tc, "id1"); err != nil {
+		t.Fatalf("rolled-back actor must resume: %v", err)
+	}
+	a := waitActorStatus(t, tc, "id1", ateapipb.Actor_STATUS_RUNNING, time.Second)
+	if a.GetMetadata().GetName() != "id1" {
+		t.Fatalf("identity changed: %s", a.GetMetadata().GetName())
+	}
+}
+
+// A concurrent request during an in-flight (caller-abandoned) restore gets Aborted rather than a
+// second workflow; once the first finishes, the retry sees RUNNING and succeeds.
+func TestResumeActor_ConcurrentRetryDuringDetachedRestore(t *testing.T) {
+	tc, _, cleanup := recoverySetup(t, "ns-rec-concurrent", "worker-1", "worker-2")
+	defer cleanup()
+	tc.fakeAtelet.RestoreDelay = 1 * time.Second
+	ctx, cancel := context.WithTimeout(context.Background(), 150*time.Millisecond)
+	defer cancel()
+	_ = resume(ctx, tc, "id1")
+	err := resume(context.Background(), tc, "id1")
+	if status.Code(err) != codes.Aborted {
+		t.Fatalf("second resume during the detached workflow: want Aborted, got %v", err)
+	}
+	waitActorStatus(t, tc, "id1", ateapipb.Actor_STATUS_RUNNING, 5*time.Second)
+	tc.fakeAtelet.RestoreDelay = 0
+	if err := resume(context.Background(), tc, "id1"); err != nil {
+		t.Fatalf("resume of a RUNNING actor: %v", err)
+	}
+	actors, _, err := tc.persistence.ListActors(context.Background(), testAtespace, 100, "")
+	if err != nil {
+		t.Fatalf("ListActors: %v", err)
+	}
+	running := 0
+	for _, a := range actors {
+		if a.GetStatus() == ateapipb.Actor_STATUS_RUNNING {
+			running++
+		}
+	}
+	if running != 1 {
+		t.Fatalf("want exactly one RUNNING actor, got %d", running)
+	}
+}
+
+// A crash-classified restore error keeps upstream semantics: CRASHED, no rollback.
+func TestResumeActor_CrashIsNotRolledBack(t *testing.T) {
+	tc, _, cleanup := recoverySetup(t, "ns-rec-crash", "worker-1")
+	defer cleanup()
+	tc.fakeAtelet.FailRestore = ateerrors.NewGRPCError(context.Background(), codes.DataLoss, ateerrors.ReasonTerminalFileSystemError,
+		ateerrors.ActorCrashedMetadata(), errors.New("disk gone"))
+	if err := resume(context.Background(), tc, "id1"); status.Code(err) != codes.DataLoss {
+		t.Fatalf("want DataLoss, got %v", err)
+	}
+	waitActorStatus(t, tc, "id1", ateapipb.Actor_STATUS_CRASHED, time.Second)
+}
+
+// After a failed restore the actor can be deleted (kagent's finalizer path), where upstream's
+// RESUMING actor made every suspend-before-delete fail.
+func TestDeleteActor_AfterFailedRestore(t *testing.T) {
+	tc, _, cleanup := recoverySetup(t, "ns-rec-delete", "worker-1")
+	defer cleanup()
+	tc.fakeAtelet.FailRestore = fmt.Errorf("mock restore failure")
+	_ = resume(context.Background(), tc, "id1")
+	if _, err := tc.client.DeleteActor(context.Background(), &ateapipb.DeleteActorRequest{Actor: &ateapipb.ObjectRef{Atespace: testAtespace, Name: "id1"}}); err != nil {
+		t.Fatalf("DeleteActor after rollback: %v", err)
+	}
+}
+
+// Rollback never touches an actor whose lock was lost to another workflow.
+func TestRollbackFailedResume_SkipsWhenLockLost(t *testing.T) {
+	tc, ns, cleanup := recoverySetup(t, "ns-rec-locklost", "worker-1")
+	defer cleanup()
+	// Put the actor in the state a failed restore leaves (RESUMING on worker-1), then call the
+	// rollback with the lost-lock cause.
+	a, err := tc.persistence.GetActor(context.Background(), testAtespace, "id1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	a.Status = ateapipb.Actor_STATUS_RESUMING
+	a.AteomPodNamespace, a.AteomPodName, a.WorkerPoolName = ns, "worker-1", "pool1"
+	if _, err := tc.persistence.UpdateActor(context.Background(), a, a.GetMetadata().GetVersion()); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancelCause(context.Background())
+	cancel(errLostActorLock)
+	rollbackFailedResume(ctx, tc.persistence, &ResumeInput{Atespace: testAtespace, ActorName: "id1"},
+		&ResumeState{PriorStatus: ateapipb.Actor_STATUS_SUSPENDED})
+	got, _ := tc.persistence.GetActor(context.Background(), testAtespace, "id1")
+	if got.GetStatus() != ateapipb.Actor_STATUS_RESUMING {
+		t.Fatalf("rollback must not run without the lock, got %v", got.GetStatus())
+	}
+}
