+func recStoreWorker(pod, uid, ip string) *ateapipb.Worker {
+	return &ateapipb.Worker{
+		WorkerNamespace: recNS, WorkerPool: recPool, WorkerPod: pod, Ip: ip,
+		WorkerPodUid: uid, NodeName: "gone-node", SandboxClass: "gvisor",
+	}
