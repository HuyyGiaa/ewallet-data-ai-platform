+func recPod(name, uid, ip string) *corev1.Pod {
+	return &corev1.Pod{
+		ObjectMeta: metav1.ObjectMeta{
+			Name: name, Namespace: recNS, UID: types.UID(uid),
+			Labels: map[string]string{workerPodLabel: recPool},
+		},
+		Spec: corev1.PodSpec{NodeName: "node1", Containers: []corev1.Container{{Name: "main", Image: "nginx"}}},
+		Status: corev1.PodStatus{
