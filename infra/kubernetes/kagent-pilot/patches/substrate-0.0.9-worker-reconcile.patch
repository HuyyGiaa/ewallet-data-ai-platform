+// recFixture builds the syncer without starting it, so tests can seed the store and the API server
+// (the "state left behind while ateapi was down") first.
+type recFixture struct {
+	persistence store.Interface
+	fakeK8s     *fake.Clientset
+	syncer      *WorkerPoolSyncer
+	start       func(ctx context.Context)
+}
+
+func newRecFixture(t *testing.T, pods ...*corev1.Pod) *recFixture {
+	t.Helper()
+	persistence, cleanup := storetest.SetupTestStore(t)
+	t.Cleanup(cleanup)
+	objs := make([]runtime.Object, len(pods))
+	for i, p := range pods {
+		objs[i] = p
+	}
+	fakeK8s := fake.NewSimpleClientset(objs...)
+	workerFactory, workerInformer := WorkerPodInformer(fakeK8s)
+	//nolint:staticcheck // NewSimpleClientset is the only available fake clientset for versioned CRDs.
+	fakeAte := atefake.NewSimpleClientset(recWorkerPool())
+	ateFactory := externalversions.NewSharedInformerFactory(fakeAte, 0)
+	lister := ateFactory.Api().V1alpha1().WorkerPools().Lister()
+	syncer := NewWorkerPoolSyncer(persistence, workerInformer, lister)
+	return &recFixture{
+		persistence: persistence, fakeK8s: fakeK8s, syncer: syncer,
+		start: func(ctx context.Context) {
+			// The WorkerPool lister must be ready before pod events arrive.
+			ateFactory.Start(ctx.Done())
+			ateFactory.WaitForCacheSync(ctx.Done())
+			syncer.Start(ctx)
+			// Runs before the store cleanup (t.Cleanup is LIFO) and after the test's deferred cancel.
+			t.Cleanup(func() { <-syncer.done })
+			workerFactory.Start(ctx.Done())
+			workerFactory.WaitForCacheSync(ctx.Done())
+		},
+	}
+}
+
+func bindActor(t *testing.T, ctx context.Context, p store.Interface, pod, actorName string) {
+	t.Helper()
+	if _, err := p.CreateActor(ctx, &ateapipb.Actor{
+		Metadata:               &ateapipb.ResourceMetadata{Name: actorName, Atespace: "team-rec"},
+		ActorTemplateNamespace: recNS, ActorTemplateName: "tmpl",
+		Status:            ateapipb.Actor_STATUS_RUNNING,
+		AteomPodNamespace: recNS, AteomPodName: pod, AteomPodIp: "10.0.0.9",
+	}); err != nil {
+		t.Fatalf("create actor: %v", err)
+	}
+	w, err := p.GetWorker(ctx, recNS, recPool, pod)
+	if err != nil {
+		t.Fatalf("get worker: %v", err)
+	}
+	w.Assignment = &ateapipb.Assignment{
+		ActorTemplate: &ateapipb.KubeNamespacedObjectRef{Namespace: recNS, Name: "tmpl"},
+		Actor:         &ateapipb.ObjectRef{Name: actorName, Atespace: "team-rec"},
+	}
+	if err := p.UpdateWorker(ctx, w, w.Version); err != nil {
+		t.Fatalf("assign worker: %v", err)
+	}
+}
+
+func workerGone(_ context.Context, p store.Interface, pod string) wait.ConditionWithContextFunc {
+	return func(c context.Context) (bool, error) {
+		_, err := p.GetWorker(c, recNS, recPool, pod)
+		return errors.Is(err, store.ErrNotFound), nil
+	}
+}
+
+func poll(t *testing.T, ctx context.Context, what string, cond wait.ConditionWithContextFunc) {
+	t.Helper()
+	if err := wait.PollUntilContextTimeout(ctx, 20*time.Millisecond, 3*time.Second, true, cond); err != nil {
+		t.Fatalf("%s: %v", what, err)
+	}
+}
