+// A live, assigned worker keeps its record and its actor.
+func TestSyncerReconcile_LiveAssignedWorkerUntouched(t *testing.T) {
+	t.Setenv("ATE_WORKER_RECONCILE_INTERVAL", "0")
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+
+	f := newRecFixture(t, recPod("live-1", "00000000-0000-4000-8000-000000000003", "10.0.0.2"))
+	f.start(ctx)
+	poll(t, ctx, "live-1 registered", func(c context.Context) (bool, error) {
+		_, err := f.persistence.GetWorker(c, recNS, recPool, "live-1")
+		return err == nil, nil
+	})
+	bindActor(t, ctx, f.persistence, "live-1", "actor-live")
+
+	for i := 0; i < 3; i++ {
+		if n := f.syncer.reconcileStore(ctx); n != 0 {
+			t.Fatalf("reconcile pass %d removed %d workers, want 0", i, n)
+		}
+	}
+	w, err := f.persistence.GetWorker(ctx, recNS, recPool, "live-1")
+	if err != nil || w.GetAssignment().GetActor().GetName() != "actor-live" {
+		t.Fatalf("live worker or its assignment lost: w=%v err=%v", w, err)
+	}
+	a, _ := f.persistence.GetActor(ctx, "team-rec", "actor-live")
+	if a.GetStatus() != ateapipb.Actor_STATUS_RUNNING || a.GetAteomPodName() != "live-1" {
+		t.Errorf("actor on live worker changed: status=%v pod=%q", a.GetStatus(), a.GetAteomPodName())
+	}
+}
+
+// Nothing is removed while the informer cache has not synced (an empty cache is not authoritative).
+func TestSyncerReconcile_NoRemovalBeforeSync(t *testing.T) {
+	ctx := context.Background()
+	f := newRecFixture(t)
+	if err := f.persistence.CreateWorker(ctx, recStoreWorker("maybe-live", "00000000-0000-4000-8000-000000000008", "10.0.0.3")); err != nil {
+		t.Fatalf("seed: %v", err)
+	}
+	// Syncer never started: the informer has not synced.
+	if n := f.syncer.reconcileStore(ctx); n != 0 {
+		t.Fatalf("reconcile before sync removed %d workers", n)
+	}
+	if _, err := f.persistence.GetWorker(ctx, recNS, recPool, "maybe-live"); err != nil {
+		t.Fatalf("worker removed before sync: %v", err)
+	}
+}
