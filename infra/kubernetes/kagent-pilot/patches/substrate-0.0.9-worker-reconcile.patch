+}
+
+// The periodic pass catches a record that becomes stale after startup without an informer event.
+func TestSyncerReconcile_PeriodicPass(t *testing.T) {
+	t.Setenv("ATE_WORKER_RECONCILE_INTERVAL", "100ms")
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+
+	f := newRecFixture(t, recPod("live-2", "00000000-0000-4000-8000-000000000004", "10.0.0.6"))
+	f.start(ctx)
+	poll(t, ctx, "live-2 registered", func(c context.Context) (bool, error) {
+		_, err := f.persistence.GetWorker(c, recNS, recPool, "live-2")
+		return err == nil, nil
+	})
+	if err := f.persistence.CreateWorker(ctx, recStoreWorker("late-stale", "00000000-0000-4000-8000-000000000001", "10.9.9.7")); err != nil {
+		t.Fatalf("seed: %v", err)
+	}
+	poll(t, ctx, "late stale worker removed by periodic pass", workerGone(ctx, f.persistence, "late-stale"))
+	if _, err := f.persistence.GetWorker(ctx, recNS, recPool, "live-2"); err != nil {
+		t.Errorf("periodic pass removed a live worker: %v", err)
+	}
+}
+
+func TestWorkerReconcileInterval(t *testing.T) {
+	for _, tc := range []struct {
+		env  string
+		want time.Duration
+	}{{"", 2 * time.Minute}, {"0", 0}, {"30s", 30 * time.Second}, {"bogus", 2 * time.Minute}, {"-1s", 2 * time.Minute}} {
+		t.Setenv("ATE_WORKER_RECONCILE_INTERVAL", tc.env)
+		if got := workerReconcileInterval(); got != tc.want {
+			t.Errorf("env %q: got %v want %v", tc.env, got, tc.want)
+		}
+	}
+}
