+func recWorkerPool() *atev1alpha1.WorkerPool {
+	return &atev1alpha1.WorkerPool{
+		ObjectMeta: metav1.ObjectMeta{Name: recPool, Namespace: recNS},
+		Spec:       atev1alpha1.WorkerPoolSpec{SandboxClass: "gvisor"},
+	}
