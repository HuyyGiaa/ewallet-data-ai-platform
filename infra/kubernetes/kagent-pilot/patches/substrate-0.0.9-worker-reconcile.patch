+// A pod recreated under the same name (new UID) replaces the old record; the old actor is released.
+func TestSyncerReconcile_ReplacedPodUIDChange(t *testing.T) {
+	t.Setenv("ATE_WORKER_RECONCILE_INTERVAL", "0")
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+
+	f := newRecFixture(t, recPod("same-name", "00000000-0000-4000-8000-000000000005", "10.0.0.4"))
+	if err := f.persistence.CreateWorker(ctx, recStoreWorker("same-name", "00000000-0000-4000-8000-000000000006", "10.9.9.8")); err != nil {
+		t.Fatalf("seed: %v", err)
+	}
+	bindActor(t, ctx, f.persistence, "same-name", "actor-old")
+
+	f.start(ctx)
+	poll(t, ctx, "record re-registered for the new pod", func(c context.Context) (bool, error) {
+		w, err := f.persistence.GetWorker(c, recNS, recPool, "same-name")
+		return err == nil && w.GetWorkerPodUid() == "00000000-0000-4000-8000-000000000005" && w.GetIp() == "10.0.0.4" && w.GetAssignment() == nil, nil
+	})
+	a, _ := f.persistence.GetActor(ctx, "team-rec", "actor-old")
+	if a.GetStatus() != ateapipb.Actor_STATUS_SUSPENDED || a.GetAteomPodName() != "" {
+		t.Errorf("actor of the old incarnation not released: status=%v pod=%q", a.GetStatus(), a.GetAteomPodName())
+	}
+	if n := f.syncer.reconcileStore(ctx); n != 0 {
+		t.Errorf("reconcile after re-registration removed %d, want 0", n)
+	}
+}
