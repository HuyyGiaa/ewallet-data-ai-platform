+// The GKE 2026-11-16 case: the store still holds workers of pods deleted while ateapi was down.
+func TestSyncerReconcile_StartupRemovesStaleKeepsLive(t *testing.T) {
+	t.Setenv("ATE_WORKER_RECONCILE_INTERVAL", "0")
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+
+	f := newRecFixture(t, recPod("live-0", "00000000-0000-4000-8000-000000000002", "10.0.0.1"))
+	for _, n := range []string{"stale-0", "stale-1"} {
+		if err := f.persistence.CreateWorker(ctx, recStoreWorker(n, staleUID[n], "10.9.9.9")); err != nil {
+			t.Fatalf("seed %s: %v", n, err)
+		}
+	}
+	bindActor(t, ctx, f.persistence, "stale-0", "actor-stale")
+
+	f.start(ctx)
+	poll(t, ctx, "stale-0 removed", workerGone(ctx, f.persistence, "stale-0"))
+	poll(t, ctx, "stale-1 removed", workerGone(ctx, f.persistence, "stale-1"))
+	poll(t, ctx, "live-0 registered", func(c context.Context) (bool, error) {
+		_, err := f.persistence.GetWorker(c, recNS, recPool, "live-0")
+		return err == nil, nil
+	})
+
+	a, err := f.persistence.GetActor(ctx, "team-rec", "actor-stale")
+	if err != nil {
+		t.Fatalf("get actor: %v", err)
+	}
+	if a.GetStatus() != ateapipb.Actor_STATUS_SUSPENDED || a.GetAteomPodName() != "" || a.GetAteomPodIp() != "" {
+		t.Errorf("actor on stale worker not released: status=%v pod=%q ip=%q", a.GetStatus(), a.GetAteomPodName(), a.GetAteomPodIp())
+	}
+
+	// Idempotent: a second pass removes nothing and keeps the live worker.
+	if n := f.syncer.reconcileStore(ctx); n != 0 {
+		t.Errorf("second reconcile removed %d workers, want 0", n)
+	}
+	workers, err := f.persistence.ListWorkers(ctx)
+	if err != nil {
+		t.Fatalf("list: %v", err)
+	}
+	if len(workers) != 1 || workers[0].GetWorkerPod() != "live-0" {
+		t.Errorf("workers after reconcile = %v, want only live-0", workers)
+	}
+}
