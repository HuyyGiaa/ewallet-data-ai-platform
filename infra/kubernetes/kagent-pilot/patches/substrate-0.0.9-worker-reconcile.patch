+// workerReconcileInterval reads ATE_WORKER_RECONCILE_INTERVAL (Go duration; "0" disables the periodic
+// pass, the startup pass always runs). Default 2m.
+func workerReconcileInterval() time.Duration {
+	raw := os.Getenv("ATE_WORKER_RECONCILE_INTERVAL")
+	if raw == "" {
+		return 2 * time.Minute
 	}
+	d, err := time.ParseDuration(raw)
+	if err != nil || d < 0 {
+		slog.Error("Invalid ATE_WORKER_RECONCILE_INTERVAL; using 2m", slog.String("value", raw))
+		return 2 * time.Minute
+	}
+	return d
+}
 
+// reconcileStore removes store workers whose pod is absent from the synced informer cache.
+//
+// Workers are only ever created from informer events, so the cache (a list+watch of the API server)
+// is the authority on which worker pods exist: a record whose pod is not in it (or whose pod has another
+// UID or pool) is stale, never a live worker that the cache has not seen yet. Live workers are untouched. Nothing is removed until the cache has synced. A stale
+// worker's actor is released exactly as for a delete event, so its next request is reassigned.
+func (s *WorkerPoolSyncer) reconcileStore(ctx context.Context) int {
+	if !s.workerInformer.HasSynced() {
+		return 0
+	}
+	workers, err := s.persistence.ListWorkers(ctx)
+	if err != nil {
+		slog.ErrorContext(ctx, "Syncer: reconcile could not list workers", slog.Any("err", err))
+		return 0
+	}
+	removed := 0
+	for _, w := range workers {
+		key := w.GetWorkerNamespace() + "/" + w.GetWorkerPod()
+		live, err := s.workerInformer.GetIndexer().ByIndex(byNamespaceAndName, key)
+		if err != nil {
+			slog.ErrorContext(ctx, "Syncer: reconcile index lookup failed", slog.String("worker", key), slog.Any("err", err))
+			continue
+		}
+		var current *corev1.Pod
+		reason := "pod no longer exists"
+		if len(live) > 0 {
+			current = live[0].(*corev1.Pod)
+			switch {
+			case w.GetWorkerPodUid() != "" && string(current.UID) != w.GetWorkerPodUid():
+				// Same name, new pod (e.g. recreated while ateapi was down): the record and any actor
+				// bound to it belong to the old incarnation.
+				reason = "pod was replaced (UID changed)"
+			case current.Labels[workerPodLabel] != w.GetWorkerPool():
+				reason = "pod no longer belongs to the worker pool"
+			default:
+				continue
+			}
+		}
+		slog.InfoContext(ctx, "Syncer: removing stale worker", slog.String("worker", key),
+			slog.String("pool", w.GetWorkerPool()), slog.String("reason", reason))
+		if err := s.releaseActorOnDeadWorker(ctx, w.GetWorkerNamespace(), w.GetWorkerPool(), w.GetWorkerPod()); err != nil {
+			slog.ErrorContext(ctx, "Failed to release actor bound to stale worker", slog.Any("err", err))
+		}
+		if err := s.persistence.DeleteWorker(ctx, w.GetWorkerNamespace(), w.GetWorkerPool(), w.GetWorkerPod()); err != nil &&
+			!errors.Is(err, store.ErrNotFound) {
+			slog.ErrorContext(ctx, "Failed to delete stale worker from store", slog.Any("err", err))
+			continue
+		}
+		removed++
+		if current != nil {
+			// Register the current incarnation now rather than at the next informer resync.
+			s.syncWorkerToStore(ctx, current)
+		}
+	}
+	if removed > 0 {
+		slog.InfoContext(ctx, "Syncer: reconcile removed stale workers", slog.Int("count", removed))
+	}
+	return removed
+}
