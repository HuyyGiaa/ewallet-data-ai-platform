+		case ateapipb.Actor_STATUS_SUSPENDING:
+			if err = b.client.SuspendActor(ctx, atespace, actorID); err == nil {
+				st = ateapipb.Actor_STATUS_SUSPENDED
+				continue
+			}
+		case ateapipb.Actor_STATUS_SUSPENDED, ateapipb.Actor_STATUS_UNSPECIFIED, ateapipb.Actor_STATUS_RESUMING,
+			ateapipb.Actor_STATUS_PAUSED, ateapipb.Actor_STATUS_PAUSING:
+			if _, err = b.client.ResumeActor(ctx, atespace, actorID); err == nil {
+				return nil
+			}
+		default:
+			return nil
+		}
+		if status.Code(err) != codes.Aborted {
+			return wrapResumeActorError(actorID, err)
+		}
+		if st, err = b.settleActor(ctx, atespace, actorID); err != nil {
+			return wrapResumeActorError(actorID, err)
+		}
+	}
+}
