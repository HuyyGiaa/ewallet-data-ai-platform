+
+func TestCoordinatorSerializesOneKeyAndDropsIdleEntries(t *testing.T) {
+	c := newSessionCoordinator(nil)
+	a, err := c.acquire(context.Background(), "ns/x")
+	if err != nil {
+		t.Fatal(err)
+	}
+	got := make(chan struct{})
+	go func() {
+		s, err := c.acquire(context.Background(), "ns/x")
+		if err == nil {
+			close(got)
+			c.release("ns/x", s)
+		}
+	}()
+	select {
+	case <-got:
+		t.Fatal("second holder entered while the first held the session")
+	case <-time.After(50 * time.Millisecond):
+	}
+	other, err := c.acquire(context.Background(), "ns/y")
+	if err != nil {
+		t.Fatalf("an unrelated session must not wait: %v", err)
+	}
+	c.release("ns/y", other)
+	c.release("ns/x", a)
+	<-got
+	deadline := time.Now().Add(time.Second)
+	for c.size() != 0 && time.Now().Before(deadline) {
+		time.Sleep(time.Millisecond)
+	}
+	if c.size() != 0 {
+		t.Fatalf("idle entries kept: %d", c.size())
+	}
+}
+
+func TestCoordinatorQueueIsBounded(t *testing.T) {
+	c := newSessionCoordinator(nil)
+	holder, _ := c.acquire(context.Background(), "k")
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	for i := 0; i < maxSessionWaiters; i++ {
+		go func() { _, _ = c.acquire(ctx, "k") }()
+	}
+	deadline := time.Now().Add(time.Second)
+	for {
+		c.mu.Lock()
+		w := c.slots["k"].waiters
+		c.mu.Unlock()
+		if w == maxSessionWaiters || time.Now().After(deadline) {
+			break
+		}
+		time.Sleep(time.Millisecond)
+	}
+	if _, err := c.acquire(context.Background(), "k"); !errors.Is(err, ErrSessionBusy) {
+		t.Fatalf("want ErrSessionBusy, got %v", err)
+	}
+	cancel()
+	c.release("k", holder)
+}
+
+// A waiter that gives up after the holder decided to hand the RUNNING actor over must not
+// strand it: release (or the leaving waiter) reclaims it, exactly once.
+func TestCoordinatorReclaimsAbandonedHandoff(t *testing.T) {
+	for _, order := range []string{"release-after-waiter-left", "waiter-leaves-after-release-attempt"} {
+		t.Run(order, func(t *testing.T) {
+			var reclaimed atomic.Int32
+			var c *sessionCoordinator
+			c = newSessionCoordinator(func(key string, slot *sessionSlot) {
+				reclaimed.Add(1)
+				c.release(key, slot)
+			})
+			holder, _ := c.acquire(context.Background(), "k")
+			ctx, cancel := context.WithCancel(context.Background())
+			left := make(chan struct{})
+			go func() { _, _ = c.acquire(ctx, "k"); close(left) }()
+			for {
+				c.mu.Lock()
+				w := c.slots["k"].waiters
+				c.mu.Unlock()
+				if w == 1 {
+					break
+				}
+				time.Sleep(time.Millisecond)
+			}
+			if !c.handOffIfWaiting(holder) {
+				t.Fatal("expected a handoff")
+			}
+			cancel()
+			<-left
+			c.release("k", holder)
+			deadline := time.Now().Add(time.Second)
+			for (reclaimed.Load() == 0 || c.size() != 0) && time.Now().Before(deadline) {
+				time.Sleep(time.Millisecond)
+			}
+			if reclaimed.Load() != 1 || c.size() != 0 {
+				t.Fatalf("reclaimed=%d entries=%d", reclaimed.Load(), c.size())
+			}
+		})
+	}
+}
