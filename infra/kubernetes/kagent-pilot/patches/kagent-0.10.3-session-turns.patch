diff --git a/go/core/pkg/sandboxbackend/substrate/session_turns.go b/go/core/pkg/sandboxbackend/substrate/session_turns.go
new file mode 100644
index 0000000..ad4557d
--- /dev/null
+++ b/go/core/pkg/sandboxbackend/substrate/session_turns.go
@@ -0,0 +1,334 @@
+package substrate
+
+// Per-session turn coordination for SandboxAgent session actors (ewallet patch on v0.10.3).
+//
+// Upstream, every A2A request ran EnsureSessionActor on its own and scheduled the post-turn
+// SuspendActor in a detached goroutine when the response body closed. Nothing ordered the turns
+// of one session: a follow-up that arrived while the previous turn's suspend was in flight saw
+// SUSPENDING, skipped ResumeActor and timed out after two minutes; a follow-up during a RUNNING
+// turn could be suspended underneath by the previous turn's goroutine.
+//
+// A SessionTurn owns its session actor's lifecycle from before EnsureSessionActor until the
+// post-turn suspend has finished (or the actor is handed to the next queued turn). The key is the
+// actor (atespace/actorID): that is the resource every lifecycle call mutates, and kagent derives
+// it from namespace, agent and session id only, so all callers of one session share it.
+//
+//   - Turns of one session never overlap (FIFO order among waiters is not promised); different
+//     sessions never wait for each other.
+//   - When a turn ends and another is already waiting, the RUNNING actor is handed over without a
+//     Suspend/Resume pair. Otherwise the turn suspends the actor before releasing it, so the next
+//     turn always starts from a settled state. If every waiter of a handed-over actor gives up,
+//     the last one to leave suspends the actor, so a handoff never strands a worker either.
+//   - A turn whose EnsureSessionActor failed releases only after the actor has left RESUMING or
+//     SUSPENDING (ate-api finishes or rolls back a workflow even after the caller gave up), and
+//     suspends it if it ended up RUNNING, so a failed turn never strands a worker.
+//
+// Every wait is bounded: acquiring waits at most for the caller's context and sessionTurnWaitLimit,
+// at most maxSessionWaiters requests queue per session, the post-turn suspend and the failure
+// settle have their own limits, and an idle session's entry is dropped from the map.
+//
+// The coordination is in-process. It assumes one kagent controller replica serves A2A traffic
+// (the chart default); ate-api's own per-actor workflow lock still serializes lifecycle calls
+// across processes, and a restarted controller finds in-flight states via settleActor.
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/agent-substrate/substrate/pkg/proto/ateapipb"
+	"github.com/kagent-dev/kagent/go/api/v1alpha2"
+	"github.com/kagent-dev/kagent/go/core/pkg/sandboxbackend"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+	ctrllog "sigs.k8s.io/controller-runtime/pkg/log"
+)
+
+var (
+	// sessionTurnWaitLimit bounds how long a request waits for the previous turn of its session.
+	sessionTurnWaitLimit = 10 * time.Minute
+	// maxSessionWaiters bounds the queue of one session; further requests fail fast.
+	maxSessionWaiters = 8
+	// postTurnSuspendLimit bounds the suspend (with retries) after a turn.
+	postTurnSuspendLimit = 2 * time.Minute
+	// settleLimit bounds waiting for an in-flight ate-api workflow to finish. It must exceed
+	// ate-api's --actor-workflow-deadline (5 min in v0.0.9).
+	settleLimit = 6 * time.Minute
+	// settlePoll is the GetActor polling interval while settling.
+	settlePoll = 500 * time.Millisecond
+)
+
+// ErrSessionBusy is returned when a session already has maxSessionWaiters queued requests.
+var ErrSessionBusy = errors.New("substrate session has too many concurrent requests; retry later")
+
+type sessionSlot struct {
+	token   chan struct{} // capacity 1: holding the token owns the actor's lifecycle
+	waiters int           // requests blocked in acquire
+	refs    int           // holder + waiters; the slot is dropped at zero
+	handoff bool          // the actor was left RUNNING for a waiter
+}
+
+type sessionCoordinator struct {
+	mu    sync.Mutex
+	slots map[string]*sessionSlot
+	// reclaim suspends the actor of a handed-over slot whose waiters all gave up; it owns the
+	// slot's token and must release it.
+	reclaim func(key string, slot *sessionSlot)
+}
+
+func newSessionCoordinator(reclaim func(key string, slot *sessionSlot)) *sessionCoordinator {
+	return &sessionCoordinator{slots: map[string]*sessionSlot{}, reclaim: reclaim}
+}
+
+func (c *sessionCoordinator) acquire(ctx context.Context, key string) (*sessionSlot, error) {
+	c.mu.Lock()
+	slot := c.slots[key]
+	if slot == nil {
+		slot = &sessionSlot{token: make(chan struct{}, 1)}
+		slot.token <- struct{}{}
+		c.slots[key] = slot
+	}
+	if slot.refs > maxSessionWaiters {
+		c.mu.Unlock()
+		return nil, ErrSessionBusy
+	}
+	slot.refs++
+	slot.waiters++
+	c.mu.Unlock()
+
+	wait, cancel := context.WithTimeout(ctx, sessionTurnWaitLimit)
+	defer cancel()
+	select {
+	case <-slot.token:
+		c.mu.Lock()
+		slot.waiters--
+		slot.handoff = false
+		c.mu.Unlock()
+		return slot, nil
+	case <-wait.Done():
+		err := fmt.Errorf("waiting for the previous turn of this session: %w", wait.Err())
+		c.mu.Lock()
+		defer c.mu.Unlock()
+		slot.waiters--
+		if slot.handoff && slot.waiters == 0 && c.reclaim != nil {
+			select {
+			case <-slot.token: // nobody took over the RUNNING actor: suspend it, keeping our ref
+				slot.handoff = false
+				go c.reclaim(key, slot)
+				return nil, err
+			default:
+			}
+		}
+		c.dropLocked(key, slot)
+		return nil, err
+	}
+}
+
+// handOffIfWaiting marks the slot as handed over when another request is queued.
+func (c *sessionCoordinator) handOffIfWaiting(slot *sessionSlot) bool {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if slot.waiters > 0 {
+		slot.handoff = true
+		return true
+	}
+	return false
+}
+
+func (c *sessionCoordinator) release(key string, slot *sessionSlot) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if slot.handoff && slot.waiters == 0 && c.reclaim != nil {
+		// The waiter we handed the actor to gave up before we released: suspend it instead,
+		// keeping the token and our ref until the reclaim releases them.
+		slot.handoff = false
+		go c.reclaim(key, slot)
+		return
+	}
+	slot.token <- struct{}{}
+	c.dropLocked(key, slot)
+}
+
+func (c *sessionCoordinator) dropLocked(key string, slot *sessionSlot) {
+	slot.refs--
+	if slot.refs == 0 && c.slots[key] == slot {
+		delete(c.slots, key)
+	}
+}
+
+func (c *sessionCoordinator) size() int {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return len(c.slots)
+}
+
+// sessionTurns returns the backend's coordinator, creating it on first use (the zero-value
+// backend is used by tests and must work too).
+func (b *SandboxAgentActorBackend) sessionTurns() *sessionCoordinator {
+	b.turnsOnce.Do(func() { b.turns = newSessionCoordinator(b.reclaimHandedOff) })
+	return b.turns
+}
+
+// SessionTurn is one A2A request's ownership of its session actor.
+type SessionTurn struct {
+	b         *SandboxAgentActorBackend
+	sa        *v1alpha2.SandboxAgent
+	sessionID string
+	key       string
+	slot      *sessionSlot
+	ensured   bool
+	once      sync.Once
+	done      chan struct{}
+}
+
+// BeginSessionTurn waits (bounded) until no other turn of the session is active and returns the
+// turn. The caller must call End exactly once; extra calls are ignored.
+func (b *SandboxAgentActorBackend) BeginSessionTurn(ctx context.Context, sa *v1alpha2.SandboxAgent, sessionID string) (*SessionTurn, error) {
+	if sa == nil {
+		return nil, fmt.Errorf("SandboxAgent is required")
+	}
+	if b == nil {
+		return nil, fmt.Errorf("substrate session coordination is not initialised")
+	}
+	key := sa.Namespace + "/" + SandboxAgentSessionActorID(sa, sessionID)
+	slot, err := b.sessionTurns().acquire(ctx, key)
+	if err != nil {
+		return nil, err
+	}
+	return &SessionTurn{b: b, sa: sa, sessionID: sessionID, key: key, slot: slot, done: make(chan struct{})}, nil
+}
+
+// Ensure runs EnsureSessionActor inside the turn.
+func (t *SessionTurn) Ensure(ctx context.Context) (sandboxbackend.EnsureResult, error) {
+	res, err := t.b.EnsureSessionActor(ctx, t.sa, t.sessionID)
+	t.ensured = err == nil
+	return res, err
+}
+
+// End finishes the turn in the background: the actor is handed to a queued turn, or suspended
+// (after a failed Ensure: first settled) before the session is released. It never blocks the
+// caller.
+func (t *SessionTurn) End() {
+	t.once.Do(func() { go t.finish() })
+}
+
+// Done is closed when the turn has fully released its session (for tests and shutdown).
+func (t *SessionTurn) Done() <-chan struct{} { return t.done }
+
+func (t *SessionTurn) finish() {
+	defer close(t.done)
+	defer t.b.sessionTurns().release(t.key, t.slot)
+	log := ctrllog.Log.WithName("substrate-session-turn").WithValues("actor", t.key)
+	atespace := t.sa.Namespace
+	actorID := SandboxAgentSessionActorID(t.sa, t.sessionID)
+
+	if !t.ensured {
+		ctx, cancel := context.WithTimeout(context.Background(), settleLimit)
+		defer cancel()
+		st, err := t.b.settleActor(ctx, atespace, actorID)
+		if err != nil {
+			log.Error(err, "failed turn: actor did not settle; releasing the session")
+			return
+		}
+		if st != ateapipb.Actor_STATUS_RUNNING {
+			return
+		}
+	}
+	if t.b.sessionTurns().handOffIfWaiting(t.slot) {
+		return // the next turn takes over the RUNNING actor: no Suspend/Resume pair
+	}
+	t.b.suspendAfterTurn(atespace, actorID)
+}
+
+func (b *SandboxAgentActorBackend) suspendAfterTurn(atespace, actorID string) {
+	ctx, cancel := context.WithTimeout(context.Background(), postTurnSuspendLimit)
+	defer cancel()
+	if err := b.suspendWithRetry(ctx, atespace, actorID); err != nil {
+		ctrllog.Log.WithName("substrate-session-turn").Error(err, "post-turn suspend failed; the next turn of this session resumes from the actor's current state",
+			"actor", atespace+"/"+actorID)
+	}
+}
+
+// reclaimHandedOff suspends an actor left RUNNING for waiters that all gave up.
+func (b *SandboxAgentActorBackend) reclaimHandedOff(key string, slot *sessionSlot) {
+	defer b.sessionTurns().release(key, slot)
+	atespace, actorID, ok := strings.Cut(key, "/")
+	if !ok {
+		return
+	}
+	b.suspendAfterTurn(atespace, actorID)
+}
+
+// withSessionTurn runs fn while owning the session, without the post-turn suspend (session delete).
+func (b *SandboxAgentActorBackend) withSessionTurn(ctx context.Context, sa *v1alpha2.SandboxAgent, sessionID string, fn func() (bool, error)) (bool, error) {
+	key := sa.Namespace + "/" + SandboxAgentSessionActorID(sa, sessionID)
+	slot, err := b.sessionTurns().acquire(ctx, key)
+	if err != nil {
+		return false, err
+	}
+	defer b.sessionTurns().release(key, slot)
+	return fn()
+}
+
+// settleActor waits until the actor is in neither RESUMING nor SUSPENDING and returns its status.
+// NotFound settles as UNSPECIFIED.
+func (b *SandboxAgentActorBackend) settleActor(ctx context.Context, atespace, actorID string) (ateapipb.Actor_Status, error) {
+	ticker := time.NewTicker(settlePoll)
+	defer ticker.Stop()
+	for {
+		actor, err := b.client.GetActor(ctx, atespace, actorID)
+		switch {
+		case status.Code(err) == codes.NotFound:
+			return ateapipb.Actor_STATUS_UNSPECIFIED, nil
+		case err == nil:
+			switch st := actor.GetStatus(); st {
+			case ateapipb.Actor_STATUS_RESUMING, ateapipb.Actor_STATUS_SUSPENDING:
+			default:
+				return st, nil
+			}
+		}
+		select {
+		case <-ctx.Done():
+			return ateapipb.Actor_STATUS_UNSPECIFIED, fmt.Errorf("actor %q did not settle: %w", actorID, ctx.Err())
+		case <-ticker.C:
+		}
+	}
+}
+
+// suspendWithRetry suspends a RUNNING actor. Aborted (another workflow holds the actor) is retried
+// until ctx ends; other states need nothing.
+func (b *SandboxAgentActorBackend) suspendWithRetry(ctx context.Context, atespace, actorID string) error {
+	backoff := 250 * time.Millisecond
+	for {
+		st, err := b.settleActor(ctx, atespace, actorID)
+		if err != nil {
+			return err
+		}
+		if st != ateapipb.Actor_STATUS_RUNNING {
+			return nil
+		}
+		err = b.client.SuspendActor(ctx, atespace, actorID)
+		if err == nil || status.Code(err) == codes.NotFound {
+			return nil
+		}
+		if status.Code(err) != codes.Aborted {
+			return fmt.Errorf("substrate SuspendActor %q: %w", actorID, err)
+		}
+		select {
+		case <-ctx.Done():
+			return fmt.Errorf("substrate SuspendActor %q: %w", actorID, ctx.Err())
+		case <-time.After(backoff):
+		}
+		if backoff < 2*time.Second {
+			backoff *= 2
+		}
+	}
+}
+
+// ActiveSessionTurns reports how many sessions currently have a turn active or queued.
+func (b *SandboxAgentActorBackend) ActiveSessionTurns() int {
+	return b.sessionTurns().size()
+}
