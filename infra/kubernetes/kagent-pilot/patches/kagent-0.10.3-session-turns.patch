@@ -0,0 +1,583 @@
+package a2a
+
+// ewallet patch: deterministic tests of session-turn coordination through the real
+// substrateSandboxSessionRoundTripper and the real SandboxAgentActorBackend. The fake ate-api
+// models the v0.0.9 workflow contract (blocking Resume/Suspend, per-actor lock -> Aborted, the
+// workflow keeps running when the caller's deadline expires, failed resumes roll back), and the
+// fake atenet-router records every A2A turn it serves and whether the actor stayed RUNNING
+// throughout.
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	atev1alpha1 "github.com/agent-substrate/substrate/pkg/api/v1alpha1"
+	"github.com/agent-substrate/substrate/pkg/proto/ateapipb"
+	"github.com/kagent-dev/kagent/go/api/v1alpha2"
+	"github.com/kagent-dev/kagent/go/core/pkg/sandboxbackend/substrate"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/runtime"
+	utilruntime "k8s.io/apimachinery/pkg/util/runtime"
+	"sigs.k8s.io/controller-runtime/pkg/client/fake"
+)
+
+type fakeActor struct {
+	status ateapipb.Actor_Status
+	locked bool
+}
+
+// workflowAPI is a fake ate-api ControlClient with v0.0.9 (+ ewallet rollback) semantics.
+type workflowAPI struct {
+	ateapipb.ControlClient
+	mu         sync.Mutex
+	actors     map[string]*fakeActor
+	resumeFor  time.Duration
+	suspendFor time.Duration
+
+	resumeFail  atomic.Int32 // next N resumes fail (rolled back to SUSPENDED)
+	suspendFail atomic.Int32 // next N suspends fail with Unavailable (actor stays RUNNING)
+	abortNext   atomic.Int32 // next N mutating calls return Aborted without effect
+	resumes     atomic.Int32
+	suspends    atomic.Int32
+	creates     atomic.Int32
+}
+
+func newWorkflowAPI(resumeFor, suspendFor time.Duration) *workflowAPI {
+	return &workflowAPI{actors: map[string]*fakeActor{}, resumeFor: resumeFor, suspendFor: suspendFor}
+}
+
+func (w *workflowAPI) statusOf(id string) ateapipb.Actor_Status {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	if a := w.actors[id]; a != nil {
+		return a.status
+	}
+	return ateapipb.Actor_STATUS_UNSPECIFIED
+}
+
+func (w *workflowAPI) GetActor(_ context.Context, in *ateapipb.GetActorRequest, _ ...grpc.CallOption) (*ateapipb.Actor, error) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	a := w.actors[in.GetActor().GetName()]
+	if a == nil {
+		return nil, status.Error(codes.NotFound, "not found")
+	}
+	return &ateapipb.Actor{Metadata: &ateapipb.ResourceMetadata{Name: in.GetActor().GetName(), Atespace: in.GetActor().GetAtespace()}, Status: a.status}, nil
+}
+
+func (w *workflowAPI) CreateAtespace(context.Context, *ateapipb.CreateAtespaceRequest, ...grpc.CallOption) (*ateapipb.Atespace, error) {
+	return nil, status.Error(codes.AlreadyExists, "exists")
+}
+
+func (w *workflowAPI) CreateActor(_ context.Context, in *ateapipb.CreateActorRequest, _ ...grpc.CallOption) (*ateapipb.Actor, error) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	id := in.GetActor().GetMetadata().GetName()
+	if w.actors[id] != nil {
+		return nil, status.Error(codes.AlreadyExists, "duplicate actor")
+	}
+	w.creates.Add(1)
+	w.actors[id] = &fakeActor{status: ateapipb.Actor_STATUS_SUSPENDED}
+	return &ateapipb.Actor{Metadata: in.GetActor().GetMetadata(), Status: ateapipb.Actor_STATUS_SUSPENDED}, nil
+}
+
+// workflow runs op under the actor lock in the background, like ate-api's detached workflow;
+// the caller returns at its own deadline while the workflow continues.
+func (w *workflowAPI) workflow(ctx context.Context, id string, start func(a *fakeActor) (done bool, err error), finish func(a *fakeActor), d time.Duration) error {
+	if w.abortNext.Load() > 0 {
+		w.abortNext.Add(-1)
+		return status.Error(codes.Aborted, "another operation is in progress for this actor")
+	}
+	w.mu.Lock()
+	a := w.actors[id]
+	switch {
+	case a == nil:
+		w.mu.Unlock()
+		return status.Error(codes.NotFound, "not found")
+	case a.locked:
+		w.mu.Unlock()
+		return status.Error(codes.Aborted, "another operation is in progress for this actor")
+	}
+	if done, err := start(a); done || err != nil {
+		w.mu.Unlock()
+		return err
+	}
+	a.locked = true
+	w.mu.Unlock()
+	result := make(chan struct{})
+	go func() {
+		time.Sleep(d)
+		w.mu.Lock()
+		finish(a)
+		a.locked = false
+		w.mu.Unlock()
+		close(result)
+	}()
+	select {
+	case <-result:
+		return nil
+	case <-ctx.Done():
+		return status.FromContextError(ctx.Err()).Err()
+	}
+}
+
+func (w *workflowAPI) ResumeActor(ctx context.Context, in *ateapipb.ResumeActorRequest, _ ...grpc.CallOption) (*ateapipb.ResumeActorResponse, error) {
+	id := in.GetActor().GetName()
+	var failed bool
+	err := w.workflow(ctx, id, func(a *fakeActor) (bool, error) {
+		if a.status == ateapipb.Actor_STATUS_RUNNING {
+			return true, nil
+		}
+		w.resumes.Add(1)
+		a.status = ateapipb.Actor_STATUS_RESUMING
+		return false, nil
+	}, func(a *fakeActor) {
+		if w.resumeFail.Load() > 0 {
+			w.resumeFail.Add(-1)
+			failed = true
+			a.status = ateapipb.Actor_STATUS_SUSPENDED // ewallet rollback
+			return
+		}
+		a.status = ateapipb.Actor_STATUS_RUNNING
+	}, w.resumeFor)
+	if err == nil && failed {
+		err = status.Error(codes.Unknown, "while restoring workload: readyz cancelled")
+	}
+	if err != nil {
+		return nil, err
+	}
+	return &ateapipb.ResumeActorResponse{Actor: &ateapipb.Actor{Status: ateapipb.Actor_STATUS_RUNNING}}, nil
+}
+
+func (w *workflowAPI) SuspendActor(ctx context.Context, in *ateapipb.SuspendActorRequest, _ ...grpc.CallOption) (*ateapipb.SuspendActorResponse, error) {
+	id := in.GetActor().GetName()
+	if w.suspendFail.Load() > 0 {
+		w.suspendFail.Add(-1)
+		return nil, status.Error(codes.Unavailable, "atelet unavailable")
+	}
+	err := w.workflow(ctx, id, func(a *fakeActor) (bool, error) {
+		switch a.status {
+		case ateapipb.Actor_STATUS_SUSPENDED:
+			return true, nil
+		case ateapipb.Actor_STATUS_RUNNING, ateapipb.Actor_STATUS_SUSPENDING:
+			w.suspends.Add(1)
+			a.status = ateapipb.Actor_STATUS_SUSPENDING
+			return false, nil
+		}
+		return true, status.Error(codes.InvalidArgument, "cannot checkpoint a "+a.status.String()+" actor")
+	}, func(a *fakeActor) { a.status = ateapipb.Actor_STATUS_SUSPENDED }, w.suspendFor)
+	if err != nil {
+		return nil, err
+	}
+	return &ateapipb.SuspendActorResponse{}, nil
+}
+
+// fakeRouter serves /health and A2A turns, recording violations: a turn served while the actor
+// was not RUNNING, or an actor that stopped RUNNING during a turn.
+type fakeRouter struct {
+	api        *workflowAPI
+	turnFor    atomic.Int64 // time.Duration
+	served     atomic.Int32
+	violations atomic.Int32
+	active     sync.Map // actorID -> *atomic.Int32 (concurrent turns per actor)
+	maxPerActr atomic.Int32
+	running    atomic.Int32
+	maxTotal   atomic.Int32
+}
+
+func storeMax(m *atomic.Int32, v int32) {
+	for {
+		cur := m.Load()
+		if v <= cur || m.CompareAndSwap(cur, v) {
+			return
+		}
+	}
+}
+
+func (r *fakeRouter) ServeHTTP(w http.ResponseWriter, req *http.Request) {
+	actorID, _, _ := strings.Cut(req.Host, ".")
+	if req.URL.Path == "/health" {
+		if r.api.statusOf(actorID) == ateapipb.Actor_STATUS_RUNNING {
+			w.WriteHeader(http.StatusOK)
+		} else {
+			w.WriteHeader(http.StatusBadGateway)
+		}
+		return
+	}
+	_, _ = io.Copy(io.Discard, req.Body)
+	v, _ := r.active.LoadOrStore(actorID, &atomic.Int32{})
+	n := v.(*atomic.Int32).Add(1)
+	defer v.(*atomic.Int32).Add(-1)
+	storeMax(&r.maxPerActr, n)
+	storeMax(&r.maxTotal, r.running.Add(1))
+	defer r.running.Add(-1)
+	if r.api.statusOf(actorID) != ateapipb.Actor_STATUS_RUNNING {
+		r.violations.Add(1)
+	}
+	select {
+	case <-time.After(time.Duration(r.turnFor.Load())):
+	case <-req.Context().Done():
+		return
+	}
+	if r.api.statusOf(actorID) != ateapipb.Actor_STATUS_RUNNING {
+		r.violations.Add(1)
+	}
+	r.served.Add(1)
+	w.Header().Set("Content-Type", "application/json")
+	_, _ = w.Write([]byte(`{"jsonrpc":"2.0","id":"1","result":{"kind":"task","status":{"state":"completed"}}}`))
+}
+
+type turnHarness struct {
+	t       *testing.T
+	api     *workflowAPI
+	router  *fakeRouter
+	backend *substrate.SandboxAgentActorBackend
+	sa      *v1alpha2.SandboxAgent
+	rt      http.RoundTripper
+}
+
+func newTurnHarness(t *testing.T, resumeFor, suspendFor, turnFor time.Duration) *turnHarness {
+	t.Helper()
+	scheme := runtime.NewScheme()
+	utilruntime.Must(atev1alpha1.AddToScheme(scheme))
+	tmpl := &atev1alpha1.ActorTemplate{ObjectMeta: metav1.ObjectMeta{
+		Name: "drift-specialist-401c441e274e8282", Namespace: "ewallet-sandbox",
+		Labels: map[string]string{substrate.SandboxAgentLabelKey: "drift-specialist"},
+	}, Status: atev1alpha1.ActorTemplateStatus{Phase: atev1alpha1.PhaseReady}}
+	kube := fake.NewClientBuilder().WithScheme(scheme).WithObjects(tmpl).Build()
+	api := newWorkflowAPI(resumeFor, suspendFor)
+	router := &fakeRouter{api: api}
+	router.turnFor.Store(int64(turnFor))
+	srv := httptest.NewServer(router)
+	t.Cleanup(srv.Close)
+	sa := &v1alpha2.SandboxAgent{ObjectMeta: metav1.ObjectMeta{Name: "drift-specialist", Namespace: "ewallet-sandbox"}}
+	backend := substrate.NewSandboxAgentActorBackend(&substrate.Client{ControlClient: api}, kube, srv.URL)
+	rt, err := newSubstrateSandboxSessionRoundTripper(srv.URL, sa, backend, http.DefaultTransport, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &turnHarness{t: t, api: api, router: router, backend: backend, sa: sa, rt: rt}
+}
+
+func (h *turnHarness) actor(session string) string {
+	return substrate.SandboxAgentSessionActorID(h.sa, session)
+}
+
+// send runs one A2A turn through the real transport and reads and closes the body, as the A2A
+// client does.
+func (h *turnHarness) send(ctx context.Context, session string) error {
+	body := fmt.Sprintf(`{"jsonrpc":"2.0","id":"1","method":"message/send","params":{"message":{"kind":"message","role":"user","messageId":"m","contextId":%q,"parts":[]}}}`, session)
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, "http://kagent.invalid/api/a2a-sandboxes/ewallet-sandbox/drift-specialist/", bytes.NewBufferString(body))
+	if err != nil {
+		return err
+	}
+	req.Header.Set("Content-Type", "application/json")
+	resp, err := h.rt.RoundTrip(req)
+	if err != nil {
+		return err
+	}
+	defer resp.Body.Close()
+	b, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return err
+	}
+	if !strings.Contains(string(b), `"completed"`) {
+		return fmt.Errorf("unexpected reply %s", b)
+	}
+	return nil
+}
+
+func (h *turnHarness) waitStatus(id string, want ateapipb.Actor_Status, within time.Duration) {
+	h.t.Helper()
+	deadline := time.Now().Add(within)
+	for h.api.statusOf(id) != want {
+		if time.Now().After(deadline) {
+			h.t.Fatalf("actor %s: want %v within %v, have %v", id, want, within, h.api.statusOf(id))
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+}
+
+// settled waits for every session to be released and the actor to be SUSPENDED.
+func (h *turnHarness) settled(ids ...string) {
+	h.t.Helper()
+	for _, id := range ids {
+		h.waitStatus(id, ateapipb.Actor_STATUS_SUSPENDED, 5*time.Second)
+	}
+	deadline := time.Now().Add(5 * time.Second)
+	for h.backend.ActiveSessionTurns() != 0 {
+		if time.Now().After(deadline) {
+			h.t.Fatalf("session entries leaked: %d", h.backend.ActiveSessionTurns())
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+	if v := h.router.violations.Load(); v != 0 {
+		h.t.Fatalf("%d turns ran while the actor was not RUNNING", v)
+	}
+	if m := h.router.maxPerActr.Load(); m > 1 {
+		h.t.Fatalf("%d turns of one session overlapped", m)
+	}
+}
+
+func ctxFor(t *testing.T, d time.Duration) context.Context {
+	ctx, cancel := context.WithTimeout(context.Background(), d)
+	t.Cleanup(cancel)
+	return ctx
+}
+
+const quick = 5 * time.Second
+
+// 1. A follow-up arriving while the previous turn is still RUNNING waits for it and is then
+// served on the same RUNNING actor (handoff: no Suspend/Resume in between).
+func TestTurnFollowUpDuringRunning(t *testing.T) {
+	h := newTurnHarness(t, 50*time.Millisecond, 50*time.Millisecond, 300*time.Millisecond)
+	errs := make(chan error, 2)
+	go func() { errs <- h.send(ctxFor(t, quick), "c1") }()
+	h.waitStatus(h.actor("c1"), ateapipb.Actor_STATUS_RUNNING, time.Second)
+	time.Sleep(50 * time.Millisecond) // turn 1 is being served
+	go func() { errs <- h.send(ctxFor(t, quick), "c1") }()
+	for i := 0; i < 2; i++ {
+		if err := <-errs; err != nil {
+			t.Fatal(err)
+		}
+	}
+	h.settled(h.actor("c1"))
+	if r, s := h.api.resumes.Load(), h.api.suspends.Load(); r != 1 || s != 1 {
+		t.Fatalf("handoff expected: resumes=%d suspends=%d, want 1/1", r, s)
+	}
+}
+
+// 2. The GKE race: a follow-up while the previous turn's suspend is in flight (SUSPENDING) waits
+// for the suspend and then resumes the same actor.
+func TestTurnFollowUpDuringSuspending(t *testing.T) {
+	h := newTurnHarness(t, 50*time.Millisecond, 400*time.Millisecond, 20*time.Millisecond)
+	if err := h.send(ctxFor(t, quick), "c1"); err != nil {
+		t.Fatal(err)
+	}
+	h.waitStatus(h.actor("c1"), ateapipb.Actor_STATUS_SUSPENDING, time.Second)
+	if err := h.send(ctxFor(t, quick), "c1"); err != nil {
+		t.Fatalf("follow-up during SUSPENDING: %v", err)
+	}
+	h.settled(h.actor("c1"))
+	if r := h.api.resumes.Load(); r != 2 {
+		t.Fatalf("resumes=%d, want 2", r)
+	}
+}
+
+// 3. A follow-up after the suspend completed resumes the actor.
+func TestTurnFollowUpAfterSuspended(t *testing.T) {
+	h := newTurnHarness(t, 50*time.Millisecond, 50*time.Millisecond, 20*time.Millisecond)
+	if err := h.send(ctxFor(t, quick), "c1"); err != nil {
+		t.Fatal(err)
+	}
+	h.waitStatus(h.actor("c1"), ateapipb.Actor_STATUS_SUSPENDED, time.Second)
+	if err := h.send(ctxFor(t, quick), "c1"); err != nil {
+		t.Fatal(err)
+	}
+	h.settled(h.actor("c1"))
+	if r, c := h.api.resumes.Load(), h.api.creates.Load(); r != 2 || c != 1 {
+		t.Fatalf("resumes=%d creates=%d, want 2/1 (same actor)", r, c)
+	}
+}
+
+// 4. Concurrent requests sharing a context are serialized; all succeed on one actor.
+func TestTurnConcurrentSameContext(t *testing.T) {
+	h := newTurnHarness(t, 50*time.Millisecond, 50*time.Millisecond, 80*time.Millisecond)
+	var wg sync.WaitGroup
+	errs := make(chan error, 5)
+	for i := 0; i < 5; i++ {
+		wg.Add(1)
+		go func() { defer wg.Done(); errs <- h.send(ctxFor(t, quick), "c1") }()
+	}
+	wg.Wait()
+	close(errs)
+	for err := range errs {
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	h.settled(h.actor("c1"))
+	if c := h.api.creates.Load(); c != 1 {
+		t.Fatalf("creates=%d, want one actor for the context", c)
+	}
+	if h.router.served.Load() != 5 {
+		t.Fatalf("served=%d", h.router.served.Load())
+	}
+}
+
+// 5. Independent contexts are not serialized against each other.
+func TestTurnIndependentContextsRunConcurrently(t *testing.T) {
+	h := newTurnHarness(t, 50*time.Millisecond, 50*time.Millisecond, 300*time.Millisecond)
+	var wg sync.WaitGroup
+	for _, s := range []string{"c1", "c2", "c3"} {
+		wg.Add(1)
+		go func(s string) {
+			defer wg.Done()
+			if err := h.send(ctxFor(t, quick), s); err != nil {
+				t.Error(err)
+			}
+		}(s)
+	}
+	wg.Wait()
+	h.settled(h.actor("c1"), h.actor("c2"), h.actor("c3"))
+	if m := h.router.maxTotal.Load(); m < 2 {
+		t.Fatalf("independent sessions did not overlap (max concurrent turns %d)", m)
+	}
+}
+
+// 6. A request cancelled while waiting for the previous turn fails fast and leaves nothing behind.
+func TestTurnCancelWhileWaiting(t *testing.T) {
+	h := newTurnHarness(t, 20*time.Millisecond, 20*time.Millisecond, 500*time.Millisecond)
+	first := make(chan error, 1)
+	go func() { first <- h.send(ctxFor(t, quick), "c1") }()
+	h.waitStatus(h.actor("c1"), ateapipb.Actor_STATUS_RUNNING, time.Second)
+	start := time.Now()
+	err := h.send(ctxFor(t, 100*time.Millisecond), "c1")
+	if err == nil || !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("want the waiter's deadline, got %v", err)
+	}
+	if time.Since(start) > 400*time.Millisecond {
+		t.Fatalf("cancelled waiter returned late: %v", time.Since(start))
+	}
+	if err := <-first; err != nil {
+		t.Fatalf("first turn disturbed: %v", err)
+	}
+	h.settled(h.actor("c1"))
+}
+
+// 7. A client that disconnects mid-turn ends the turn (request context), and the session works
+// again afterwards.
+func TestTurnCancelDuringExecution(t *testing.T) {
+	h := newTurnHarness(t, 20*time.Millisecond, 20*time.Millisecond, 2*time.Second)
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan error, 1)
+	go func() { done <- h.send(ctx, "c1") }()
+	h.waitStatus(h.actor("c1"), ateapipb.Actor_STATUS_RUNNING, time.Second)
+	time.Sleep(50 * time.Millisecond)
+	cancel()
+	if err := <-done; err == nil {
+		t.Fatal("expected the cancelled turn to fail")
+	}
+	h.waitStatus(h.actor("c1"), ateapipb.Actor_STATUS_SUSPENDED, quick)
+	h.router.turnFor.Store(int64(20 * time.Millisecond))
+	if err := h.send(ctxFor(t, quick), "c1"); err != nil {
+		t.Fatalf("session after disconnect: %v", err)
+	}
+	h.settled(h.actor("c1"))
+}
+
+// 8a. A failed post-turn suspend is logged; the next turn finds the actor RUNNING and is served.
+func TestTurnSuspendFailure(t *testing.T) {
+	h := newTurnHarness(t, 20*time.Millisecond, 20*time.Millisecond, 20*time.Millisecond)
+	h.api.suspendFail.Store(1)
+	if err := h.send(ctxFor(t, quick), "c1"); err != nil {
+		t.Fatal(err)
+	}
+	time.Sleep(100 * time.Millisecond)
+	if err := h.send(ctxFor(t, quick), "c1"); err != nil {
+		t.Fatalf("turn after a failed suspend: %v", err)
+	}
+	h.settled(h.actor("c1"))
+}
+
+// 8b. Aborted (another workflow holds the actor) is retried until the suspend goes through.
+func TestTurnSuspendAbortedIsRetried(t *testing.T) {
+	h := newTurnHarness(t, 20*time.Millisecond, 20*time.Millisecond, 20*time.Millisecond)
+	if err := h.send(ctxFor(t, quick), "c1"); err != nil {
+		t.Fatal(err)
+	}
+	h.settled(h.actor("c1"))
+	h.api.abortNext.Store(0)
+	// next turn: its suspend is aborted twice first
+	go func() {
+		h.waitStatus(h.actor("c1"), ateapipb.Actor_STATUS_RUNNING, time.Second)
+		h.api.abortNext.Store(2)
+	}()
+	if err := h.send(ctxFor(t, quick), "c1"); err != nil {
+		t.Fatal(err)
+	}
+	h.settled(h.actor("c1"))
+}
+
+// 9. A failed resume fails the request, releases the session, and the next request succeeds.
+func TestTurnResumeFailure(t *testing.T) {
+	h := newTurnHarness(t, 50*time.Millisecond, 20*time.Millisecond, 20*time.Millisecond)
+	h.api.resumeFail.Store(1)
+	if err := h.send(ctxFor(t, quick), "c1"); err == nil {
+		t.Fatal("expected the first turn to fail")
+	}
+	h.settled(h.actor("c1"))
+	if err := h.send(ctxFor(t, quick), "c1"); err != nil {
+		t.Fatalf("retry after a failed resume: %v", err)
+	}
+	h.settled(h.actor("c1"))
+}
+
+// 9b. The resume outlives the caller's deadline (concurrent restores, F2): the request fails, the
+// detached workflow finishes RUNNING, and the failed turn suspends it, so no worker is stranded.
+func TestTurnResumeOutlivesCallerDeadline(t *testing.T) {
+	h := newTurnHarness(t, 600*time.Millisecond, 20*time.Millisecond, 20*time.Millisecond)
+	if err := h.send(ctxFor(t, 150*time.Millisecond), "c1"); err == nil {
+		t.Fatal("expected the caller's deadline")
+	}
+	h.settled(h.actor("c1"))
+	if s := h.api.suspends.Load(); s != 1 {
+		t.Fatalf("suspends=%d: the late RUNNING actor must be suspended", s)
+	}
+}
+
+// 10. Ten rapid unpaced turns on one context: all served, one actor, never overlapping.
+func TestTurnRepeatedRapidCycles(t *testing.T) {
+	h := newTurnHarness(t, 30*time.Millisecond, 60*time.Millisecond, 10*time.Millisecond)
+	for i := 0; i < 10; i++ {
+		if err := h.send(ctxFor(t, quick), "c1"); err != nil {
+			t.Fatalf("turn %d: %v", i, err)
+		}
+	}
+	h.settled(h.actor("c1"))
+	if c := h.api.creates.Load(); c != 1 {
+		t.Fatalf("creates=%d", c)
+	}
+	if r := h.api.resumes.Load(); r < 2 {
+		t.Fatalf("resumes=%d: expected genuine suspend/resume cycles", r)
+	}
+}
+
+// 11/12. Stress for the race detector: many goroutines over a few contexts, random spacing.
+func TestTurnStress(t *testing.T) {
+	h := newTurnHarness(t, 5*time.Millisecond, 5*time.Millisecond, 3*time.Millisecond)
+	var wg sync.WaitGroup
+	var failures atomic.Int32
+	for g := 0; g < 24; g++ {
+		wg.Add(1)
+		go func(g int) {
+			defer wg.Done()
+			for i := 0; i < 5; i++ {
+				if err := h.send(ctxFor(t, 20*time.Second), fmt.Sprintf("c%d", g%3)); err != nil {
+					if !errors.Is(err, substrate.ErrSessionBusy) {
+						t.Errorf("unexpected failure: %v", err)
+					}
+					failures.Add(1)
+				}
+				time.Sleep(time.Duration((g*7+i*3)%5) * time.Millisecond)
+			}
+		}(g)
+	}
+	wg.Wait()
+	// ErrSessionBusy (queue bound per session) is the only acceptable failure.
+	t.Logf("%d of 120 requests rejected as busy", failures.Load())
+	h.settled(h.actor("c0"), h.actor("c1"), h.actor("c2"))
+}
