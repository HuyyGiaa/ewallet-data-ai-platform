# PKG-T runtime-fix images, built by scripts/llm_agent/build_runtime_fix_images.py from runtime-fix.json
# and pushed by scripts/llm_agent/scan_and_push.sh (Trivy gate PASS). Repo-level provenance is in
# docs/workplans/edai2/agent-platform-campaign/images.json (runtime_fix).
KAGENT_CONTROLLER_IMAGE=asia-southeast1-docker.pkg.dev/ewallet-data-ai-platform-hg26/ewallet-platform/kagent-controller:0.10.3-ewallet.ea032b19@sha256:6d5c9de094c193d8bb4b895c7894c524191310c1018a18e1484b6879f5cd64a1
SUBSTRATE_ATEAPI_IMAGE=asia-southeast1-docker.pkg.dev/ewallet-data-ai-platform-hg26/ewallet-platform/substrate-ateapi:0.0.9-ewallet.0291af52.d836b5a3.49125b15@sha256:96d35600a5632332d1b810488eca3012a73a8456a5dd810129248ea830d97921
# B′: ate-controller with the worker drain grace period (graceful-drain patch).
SUBSTRATE_ATECONTROLLER_IMAGE=asia-southeast1-docker.pkg.dev/ewallet-data-ai-platform-hg26/ewallet-platform/substrate-atecontroller:0.0.9-ewallet.0291af52.49125b15@sha256:7475c1f51bb83e72c0e395f918d35ae67078414c7f43246efebf42b4885926d6
SUBSTRATE_ATEOM_GVISOR_IMAGE=asia-southeast1-docker.pkg.dev/ewallet-data-ai-platform-hg26/ewallet-platform/substrate-ateom-gvisor:0.0.9-ewallet.0291af52.d8d1db43.49125b15@sha256:0dd6cbf674509b21337891ca65db964ae65ee2bafcf5e69e785a6d8f52edb470
# kagent's per-RPC ate-api deadline (default 30s). See resume-rca/RCA.md section 8.3 for the budget.
KAGENT_SUBSTRATE_CALL_TIMEOUT=90s
# atelet memory request:limit (Substrate post-renderer default 128Mi:512Mi). The in-memory pull cache
# holds the 203 MiB flattened business-agent image and ReadAll needs ~2x while filling it; two
# concurrent cache misses plus the held entry need ~1.1 GiB. See resume-rca/RCA.md section 8.6.
SUBSTRATE_ATELET_MEMORY=512Mi:1536Mi
