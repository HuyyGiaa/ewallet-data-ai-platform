# Isolated Prometheus and Grafana for EXP-V1 / EXP-V2. Both live in ewallet-bench on the
# benchmark pool and are reached only through local port-forwards (ClusterIP Services, no
# Ingress, no LoadBalancer). Production Prometheus is not changed.
#
# Prometheus discovers pods in ewallet-bench only (a Role, no ClusterRole) and keeps one
# target per pod, so two vLLM replicas are scraped separately rather than through a
# Service. CPU and memory come from metrics.k8s.io through a sidecar exporter
# (ops/experiments/pod_usage_exporter.py), because a kubelet/cAdvisor scrape would need a
# cluster-wide permission. Rendered by scripts/experiments/render_bench.py --stack observability.
apiVersion: v1
kind: ServiceAccount
metadata: {name: bench-prometheus, namespace: ewallet-bench}
automountServiceAccountToken: false
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata: {name: bench-prometheus, namespace: ewallet-bench}
rules:
  - apiGroups: [""]
    resources: [pods]
    verbs: [get, list, watch]
  - apiGroups: [metrics.k8s.io]
    resources: [pods]
    verbs: [get, list]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata: {name: bench-prometheus, namespace: ewallet-bench}
roleRef: {apiGroup: rbac.authorization.k8s.io, kind: Role, name: bench-prometheus}
subjects:
  - {kind: ServiceAccount, name: bench-prometheus, namespace: ewallet-bench}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: allow-prometheus-apiserver, namespace: ewallet-bench}
spec:
  podSelector:
    matchLabels: {app.kubernetes.io/name: bench-prometheus}
  policyTypes: [Egress]
  egress:
    - to: __API_SERVER_PEERS__
      ports:
        - {protocol: TCP, port: __API_SERVER_PORT__}
---
apiVersion: v1
kind: ConfigMap
metadata: {name: bench-prometheus-config, namespace: ewallet-bench}
data:
  prometheus.yaml: |
    global:
      scrape_interval: 5s
      scrape_timeout: 4s
      evaluation_interval: 15s
    scrape_configs:
      - job_name: vllm
        kubernetes_sd_configs: [{role: pod, namespaces: {names: [ewallet-bench]}}]
        relabel_configs:
          - action: keep
            source_labels: [__meta_kubernetes_pod_phase, __meta_kubernetes_pod_label_app_kubernetes_io_name, __meta_kubernetes_pod_container_port_number]
            regex: Running;vllm;8000
          - {source_labels: [__meta_kubernetes_pod_name], target_label: pod}
          - {source_labels: [__meta_kubernetes_pod_node_name], target_label: node}
          - {source_labels: [__meta_kubernetes_pod_annotation_ewallet_io_run_id], target_label: run_id}
          - {source_labels: [__meta_kubernetes_pod_annotation_ewallet_io_run_id], regex: '([a-z]+)-.*', target_label: arm, replacement: '$1'}
          - {target_label: experiment, replacement: __EXPERIMENT__}
      - job_name: agentgateway
        kubernetes_sd_configs: [{role: pod, namespaces: {names: [ewallet-bench]}}]
        relabel_configs:
          - action: keep
            source_labels: [__meta_kubernetes_pod_phase, __meta_kubernetes_pod_label_app_kubernetes_io_name, __meta_kubernetes_pod_container_port_number]
            regex: Running;agentgateway;15020
          - {source_labels: [__meta_kubernetes_pod_name], target_label: pod}
          - {source_labels: [__meta_kubernetes_pod_node_name], target_label: node}
          - {source_labels: [__meta_kubernetes_pod_annotation_ewallet_io_run_id], target_label: run_id}
          - {source_labels: [__meta_kubernetes_pod_annotation_ewallet_io_run_id], regex: '([a-z]+)-.*', target_label: arm, replacement: '$1'}
          - {target_label: experiment, replacement: __EXPERIMENT__}
      - job_name: epp
        kubernetes_sd_configs: [{role: pod, namespaces: {names: [ewallet-bench]}}]
        relabel_configs:
          - action: keep
            source_labels: [__meta_kubernetes_pod_phase, __meta_kubernetes_pod_label_llm_d_router_standalone, __meta_kubernetes_pod_container_port_number]
            regex: Running;llmd-router-epp;9090
          - {source_labels: [__meta_kubernetes_pod_name], target_label: pod}
          - {source_labels: [__meta_kubernetes_pod_node_name], target_label: node}
          - {target_label: experiment, replacement: __EXPERIMENT__}
      - job_name: pod-usage
        static_configs: [{targets: ['127.0.0.1:9101']}]
        relabel_configs:
          - {target_label: experiment, replacement: __EXPERIMENT__}
---
apiVersion: v1
kind: ConfigMap
metadata: {name: bench-exporter-code, namespace: ewallet-bench}
data:
  pod_usage_exporter.py: |
    __EXPORTER_CODE__
---
apiVersion: v1
kind: Service
metadata: {name: bench-prometheus, namespace: ewallet-bench}
spec:
  type: ClusterIP
  selector: {app.kubernetes.io/name: bench-prometheus}
  ports:
    - {name: http, port: 9090, targetPort: http}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: bench-prometheus
  namespace: ewallet-bench
  labels: {app.kubernetes.io/name: bench-prometheus}
spec:
  replicas: 1
  strategy: {type: Recreate}
  selector:
    matchLabels: {app.kubernetes.io/name: bench-prometheus}
  template:
    metadata:
      labels: {app.kubernetes.io/name: bench-prometheus}
    spec:
      serviceAccountName: bench-prometheus
      automountServiceAccountToken: true
      enableServiceLinks: false
      nodeSelector: {ewallet.io/bench: "true"}
      tolerations:
        - {key: ewallet.io/bench, operator: Equal, value: "true", effect: NoSchedule}
      securityContext:
        runAsNonRoot: true
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: prometheus
          image: __PROMETHEUS_IMAGE__
          imagePullPolicy: IfNotPresent
          args: [--config.file=/etc/prometheus/prometheus.yaml, --storage.tsdb.path=/prometheus,
                 --storage.tsdb.retention.time=12h]
          ports:
            - {name: http, containerPort: 9090}
          readinessProbe:
            httpGet: {path: /-/ready, port: http}
            periodSeconds: 5
          resources:
            requests: {cpu: 100m, memory: 256Mi}
            limits: {cpu: 500m, memory: 768Mi}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            runAsUser: 65534
            runAsGroup: 65534
            capabilities: {drop: [ALL]}
          volumeMounts:
            - {name: config, mountPath: /etc/prometheus, readOnly: true}
            - {name: data, mountPath: /prometheus}
        - name: pod-usage-exporter
          image: __HELPER_IMAGE__
          imagePullPolicy: IfNotPresent
          command: [python3, /code/pod_usage_exporter.py]
          env:
            - name: NAMESPACE
              valueFrom: {fieldRef: {fieldPath: metadata.namespace}}
            - {name: POLL_SECONDS, value: "10"}
          resources:
            requests: {cpu: 10m, memory: 32Mi}
            limits: {cpu: 100m, memory: 96Mi}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            runAsUser: 10001
            runAsGroup: 10001
            capabilities: {drop: [ALL]}
          volumeMounts:
            - {name: exporter, mountPath: /code, readOnly: true}
      volumes:
        - name: config
          configMap: {name: bench-prometheus-config}
        - name: exporter
          configMap: {name: bench-exporter-code}
        - name: data
          emptyDir: {sizeLimit: 2Gi}
---
apiVersion: v1
kind: ServiceAccount
metadata: {name: bench-grafana, namespace: ewallet-bench}
automountServiceAccountToken: false
---
apiVersion: v1
kind: ConfigMap
metadata: {name: bench-grafana-provisioning, namespace: ewallet-bench}
data:
  datasources.yaml: |
    apiVersion: 1
    datasources:
      - {name: bench-prometheus, uid: bench-prom, type: prometheus, access: proxy, isDefault: true,
         url: "http://bench-prometheus.ewallet-bench.svc.cluster.local:9090", jsonData: {timeInterval: 5s}}
  dashboards.yaml: |
    apiVersion: 1
    providers:
      - {name: ewallet-bench, folder: EDAI-2 Benchmark, type: file, disableDeletion: true,
         allowUiUpdates: false, options: {path: /var/lib/grafana/dashboards}}
---
apiVersion: v1
kind: ConfigMap
metadata: {name: bench-grafana-dashboards, namespace: ewallet-bench}
data:
  llm-cpu-benchmark.json: |
    __DASHBOARD_JSON__
---
apiVersion: v1
kind: Service
metadata: {name: bench-grafana, namespace: ewallet-bench}
spec:
  type: ClusterIP
  selector: {app.kubernetes.io/name: bench-grafana}
  ports:
    - {name: http, port: 3000, targetPort: http}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: bench-grafana
  namespace: ewallet-bench
  labels: {app.kubernetes.io/name: bench-grafana}
spec:
  replicas: 1
  strategy: {type: Recreate}
  selector:
    matchLabels: {app.kubernetes.io/name: bench-grafana}
  template:
    metadata:
      labels: {app.kubernetes.io/name: bench-grafana}
    spec:
      serviceAccountName: bench-grafana
      automountServiceAccountToken: false
      enableServiceLinks: false
      nodeSelector: {ewallet.io/bench: "true"}
      tolerations:
        - {key: ewallet.io/bench, operator: Equal, value: "true", effect: NoSchedule}
      securityContext:
        runAsNonRoot: true
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: grafana
          image: __GRAFANA_IMAGE__
          imagePullPolicy: IfNotPresent
          env:
            # Read-only viewing through the local port-forward; the admin password is a
            # random Secret that nothing prints.
            - {name: GF_AUTH_ANONYMOUS_ENABLED, value: "true"}
            - {name: GF_AUTH_ANONYMOUS_ORG_ROLE, value: Viewer}
            - {name: GF_SECURITY_ADMIN_USER, value: admin}
            - name: GF_SECURITY_ADMIN_PASSWORD
              valueFrom: {secretKeyRef: {name: bench-grafana-admin, key: password}}
            - {name: GF_PLUGINS_PREINSTALL_DISABLED, value: "true"}
            - {name: GF_ANALYTICS_REPORTING_ENABLED, value: "false"}
            - {name: GF_ANALYTICS_CHECK_FOR_UPDATES, value: "false"}
            - {name: GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES, value: "false"}
            - {name: GF_NEWS_NEWS_FEED_ENABLED, value: "false"}
            - {name: GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH, value: /var/lib/grafana/dashboards/llm-cpu-benchmark.json}
            - {name: GF_PATHS_DATA, value: /tmp/grafana-data}
            - {name: GF_PATHS_LOGS, value: /tmp/grafana-logs}
            - {name: GF_PATHS_PLUGINS, value: /tmp/grafana-plugins}
          ports:
            - {name: http, containerPort: 3000}
          readinessProbe:
            httpGet: {path: /api/health, port: http}
            periodSeconds: 5
          resources:
            requests: {cpu: 50m, memory: 128Mi}
            limits: {cpu: 300m, memory: 384Mi}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL]}
          volumeMounts:
            - {name: provisioning, mountPath: /etc/grafana/provisioning/datasources/datasources.yaml, subPath: datasources.yaml, readOnly: true}
            - {name: provisioning, mountPath: /etc/grafana/provisioning/dashboards/dashboards.yaml, subPath: dashboards.yaml, readOnly: true}
            - {name: dashboards, mountPath: /var/lib/grafana/dashboards, readOnly: true}
            - {name: tmp, mountPath: /tmp}
      volumes:
        - name: provisioning
          configMap: {name: bench-grafana-provisioning}
        - name: dashboards
          configMap: {name: bench-grafana-dashboards}
        - name: tmp
          emptyDir: {sizeLimit: 512Mi}
