# Deadline watchdog for ewallet-bench (ops/experiments/bench_watchdog.py). It runs inside
# the cluster, so it still acts when the operator's laptop sleeps or dies: at the deadline it
# deletes the namespace's workloads and its own CronJob, and the autoscaled bench-pool then
# drops to zero nodes. Its Role exists only in ewallet-bench, so it cannot reach anything
# else. Rendered by scripts/experiments/render_bench.py --stack watchdog.
apiVersion: v1
kind: ServiceAccount
metadata: {name: bench-watchdog, namespace: ewallet-bench}
automountServiceAccountToken: false
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata: {name: bench-watchdog, namespace: ewallet-bench}
rules:
  - apiGroups: [apps]
    resources: [deployments, statefulsets]
    verbs: [list, delete]
  - apiGroups: [batch]
    resources: [jobs]
    verbs: [list, delete]
  - apiGroups: [batch]
    resources: [cronjobs]
    resourceNames: [bench-watchdog]
    verbs: [delete]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata: {name: bench-watchdog, namespace: ewallet-bench}
roleRef: {apiGroup: rbac.authorization.k8s.io, kind: Role, name: bench-watchdog}
subjects:
  - {kind: ServiceAccount, name: bench-watchdog, namespace: ewallet-bench}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: allow-watchdog-apiserver, namespace: ewallet-bench}
spec:
  podSelector:
    matchLabels: {app.kubernetes.io/name: bench-watchdog}
  policyTypes: [Egress]
  egress:
    - to: __API_SERVER_PEERS__
      ports:
        - {protocol: TCP, port: __API_SERVER_PORT__}
---
apiVersion: v1
kind: ConfigMap
metadata: {name: bench-watchdog-code, namespace: ewallet-bench}
data:
  watchdog.py: |
    __WATCHDOG_CODE__
---
apiVersion: v1
kind: ConfigMap
metadata: {name: bench-watchdog-target, namespace: ewallet-bench}
data:
  DEADLINE_UTC: "__DEADLINE_UTC__"
  MODE: enforce
  CRONJOB_NAME: bench-watchdog
---
apiVersion: batch/v1
kind: CronJob
metadata: {name: bench-watchdog, namespace: ewallet-bench, labels: {app.kubernetes.io/name: bench-watchdog}}
spec:
  schedule: "*/3 * * * *"
  concurrencyPolicy: Forbid
  startingDeadlineSeconds: 120
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      backoffLimit: 1
      activeDeadlineSeconds: 150
      ttlSecondsAfterFinished: 1800
      template:
        metadata:
          labels: {app.kubernetes.io/name: bench-watchdog}
          # A finished watchdog pod must never keep a node alive.
          annotations: {cluster-autoscaler.kubernetes.io/safe-to-evict: "true"}
        spec:
          restartPolicy: Never
          serviceAccountName: bench-watchdog
          automountServiceAccountToken: true
          enableServiceLinks: false
          nodeSelector: {ewallet.io/bench: "true"}
          tolerations:
            - {key: ewallet.io/bench, operator: Equal, value: "true", effect: NoSchedule}
          securityContext:
            runAsNonRoot: true
            runAsUser: 10001
            runAsGroup: 10001
            seccompProfile: {type: RuntimeDefault}
          containers:
            - name: watchdog
              image: __HELPER_IMAGE__
              imagePullPolicy: IfNotPresent
              command: [python3, /code/watchdog.py]
              envFrom: [{configMapRef: {name: bench-watchdog-target}}]
              env:
                - name: NAMESPACE
                  valueFrom: {fieldRef: {fieldPath: metadata.namespace}}
              resources:
                requests: {cpu: 10m, memory: 32Mi}
                limits: {cpu: 100m, memory: 96Mi}
              securityContext:
                allowPrivilegeEscalation: false
                readOnlyRootFilesystem: true
                capabilities: {drop: [ALL]}
              volumeMounts:
                - {name: code, mountPath: /code, readOnly: true}
          volumes:
            - name: code
              configMap: {name: bench-watchdog-code}
