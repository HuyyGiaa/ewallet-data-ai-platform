{
  "kv_mount": "ewallet",
  "audit_file": "/vault/audit/audit.log",
  "kubernetes_auth_mount": "kubernetes",
  "token_audience": "vault",
  "policies": {
    "eso-ewallet-reader": "infra/kubernetes/vault/policies/eso-ewallet-reader.hcl",
    "root-generation": "infra/kubernetes/vault/policies/root-generation.hcl",
    "secret-operator": "infra/kubernetes/vault/policies/secret-operator.hcl"
  },
  "roles": {
    "eso-ewallet-reader": {
      "bound_service_account_names": ["eso-vault-reader"],
      "bound_service_account_namespaces": ["external-secrets"],
      "audience": "vault",
      "token_policies": ["eso-ewallet-reader"],
      "token_ttl": "5m",
      "token_max_ttl": "15m",
      "token_no_default_policy": true
    },
    "vault-admin": {
      "bound_service_account_names": ["vault-admin"],
      "bound_service_account_namespaces": ["ewallet-vault"],
      "audience": "vault",
      "token_policies": ["root-generation"],
      "token_ttl": "15m",
      "token_max_ttl": "30m",
      "token_no_default_policy": true
    }
  }
}
