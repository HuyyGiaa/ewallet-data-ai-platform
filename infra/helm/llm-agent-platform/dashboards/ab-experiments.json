{
  "title": "E-Wallet A/B Experiments",
  "uid": "ewallet-ab-experiments",
  "schemaVersion": 41,
  "tags": [
    "ewallet",
    "ab"
  ],
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "ML: requests by served arm",
      "telemetryStatus": "runtime-pending",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (served_arm, model_version) (rate(fraud_ab_requests_total[5m]))",
          "legendFormat": "{{served_arm}} v{{model_version}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "ML: p95 model latency",
      "telemetryStatus": "runtime-pending",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, served_arm) (rate(fraud_ab_model_latency_seconds_bucket[5m])))",
          "legendFormat": "{{served_arm}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "ML: candidate failures and fallbacks",
      "telemetryStatus": "runtime-pending",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (arm, error_code) (rate(fraud_ab_candidate_failures_total[5m]))",
          "legendFormat": "{{arm}} {{error_code}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "ML: positive prediction rate",
      "telemetryStatus": "runtime-pending",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (served_arm) (rate(fraud_ab_positive_predictions_total[5m])) / sum by (served_arm) (rate(fraud_ab_requests_total{outcome=\"success\"}[5m]))",
          "legendFormat": "{{served_arm}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Agent: intakes by variant and outcome",
      "telemetryStatus": "runtime-pending",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (variant, outcome) (rate(ewallet_agent_ab_requests_total[5m]))",
          "legendFormat": "{{variant}} {{outcome}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Agent: LLM tokens by variant",
      "telemetryStatus": "runtime-pending",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (variant, kind) (rate(ewallet_agent_ab_llm_tokens_total[5m]))",
          "legendFormat": "{{variant}} {{kind}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Agent: p95 intake latency",
      "telemetryStatus": "runtime-pending",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, variant) (rate(ewallet_agent_ab_llm_latency_seconds_bucket[5m])))",
          "legendFormat": "{{variant}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "LLM: requests by served model",
      "telemetryStatus": "runtime-pending",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model_name) (rate(vllm:request_success_total[5m]))",
          "legendFormat": "{{model_name}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "LLM: p95 end-to-end latency by model",
      "telemetryStatus": "runtime-pending",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, model_name) (rate(vllm:e2e_request_latency_seconds_bucket[5m])))",
          "legendFormat": "{{model_name}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "LLM: p95 time to first token by model",
      "telemetryStatus": "runtime-pending",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, model_name) (rate(vllm:time_to_first_token_seconds_bucket[5m])))",
          "legendFormat": "{{model_name}}"
        }
      ]
    }
  ]
}
