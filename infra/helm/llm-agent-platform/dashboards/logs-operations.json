{
  "title": "E-Wallet Logs & Operations", "uid": "ewallet-logs-operations", "schemaVersion": 41,
  "tags": ["ewallet", "loki", "operations"], "refresh": "30s", "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {"id": 1, "type": "logs", "title": "Application logs", "telemetryStatus": "runtime-pending", "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"refId": "A", "expr": "{service_name=~\"fraud-api|fraud-coordinator|feature-rag-specialist|drift-specialist|feature-rag-mcp|drift-mcp\"}"}]},
    {"id": 2, "type": "timeseries", "title": "Pod restarts", "telemetryStatus": "runtime-pending", "targets": [{"refId": "A", "expr": "sum by (namespace, pod) (increase(kube_pod_container_status_restarts_total[1h]))"}]},
    {"id": 3, "type": "timeseries", "title": "OTel export failures", "telemetryStatus": "runtime-pending", "targets": [{"refId": "A", "expr": "sum by (exporter) (rate(otelcol_exporter_send_failed_spans[5m]))"}]}
  ]
}
