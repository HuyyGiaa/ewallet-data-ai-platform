# llm-d inference-aware routing pins (rubric edai-2 rows 3-6). Digests were
# read with `helm pull` / sha256sum on 2026-10-31; nothing was installed.
# Topology: docs/llm_agent/llm_d_inference_routing.md.

# agentgateway controller in Kubernetes Gateway API mode, same release as the
# pinned standalone LLM agentgateway image (v1.7.0).
AGENTGATEWAY_VERSION=v1.7.0
AGENTGATEWAY_CRDS_CHART=oci://cr.agentgateway.dev/charts/agentgateway-crds
AGENTGATEWAY_CRDS_DIGEST=sha256:946b739c0fcda4d47a72d1589d184b6fd507772e733cbedf02789bafd0468064
AGENTGATEWAY_CHART=oci://cr.agentgateway.dev/charts/agentgateway
AGENTGATEWAY_CHART_DIGEST=sha256:40340d639e35206317c934e9af3e29575cf7c5377b2940679732baac6e108c15

# Gateway API Inference Extension: InferencePool inference.networking.k8s.io/v1.
GAIE_VERSION=v1.6.2
GAIE_MANIFEST_URL=https://github.com/kubernetes-sigs/gateway-api-inference-extension/releases/download/v1.6.2/manifests.yaml
GAIE_MANIFEST_SHA256=38bfba9c452ab54b1afd1f4df15e75b3238c788d8ab007d2f469e6f7ae16fc9f

# Gateway API standard CRDs. The agentgateway docs use v1.6.3; the local kind
# cluster already serves v1.7.0 (installed with Istio 1.30.7). Do not
# downgrade: the v1 resources used here (Gateway, HTTPRoute) are unchanged,
# and controller compatibility with v1.7.0 is a runtime gate.
GATEWAY_API_DOC_VERSION=v1.6.3
GATEWAY_API_DOC_SHA256=356c2b8e286a964dc20995435659ad1095386329974793af10bbfe3eff977fe5

# llm-d router (EPP + InferencePool + HTTPRoute), provider none so the chart
# creates no resources for another gateway implementation.
LLMD_ROUTER_VERSION=v0.9.0
LLMD_ROUTER_CHART=oci://ghcr.io/llm-d/charts/llm-d-router-gateway
LLMD_ROUTER_CHART_DIGEST=sha256:60f4533be587496faee9eb24a3ad8f91f4efda49b7800ee200a1d918d9aba54b
LLMD_EPP_IMAGE=ghcr.io/llm-d/llm-d-router-endpoint-picker:v0.9.0
LLMD_RELEASE=ewallet-fraud-llm

# G2 (llm-d standalone routing, no CRDs): llm-d-router v1.0.0 (2026-10-16).
# Chart pulled with helm on 2026-11-01; image digests read with
# `docker buildx imagetools inspect` (multi-arch index, linux/amd64 present).
LLMD_STANDALONE_VERSION=v1.0.0
LLMD_STANDALONE_CHART=oci://ghcr.io/llm-d/charts/llm-d-router-standalone
LLMD_STANDALONE_CHART_OCI_DIGEST=sha256:c1d1af55382ef1097188d188070385c6de02b771f34681678e658a59e975024c
LLMD_STANDALONE_CHART_SHA256=c4787dcda88cae57124d8eaf7672d56e9993ce25d6ce62d8a5f71097640c09d3
LLMD_STANDALONE_EPP_IMAGE=ghcr.io/llm-d/llm-d-router-endpoint-picker:v1.0.0@sha256:024188e998f516879f68532016ca24fabca00afbdcc2af9a61b17634e197df2c
LLMD_STANDALONE_ENVOY_IMAGE=docker.io/envoyproxy/envoy:distroless-v1.33.2@sha256:85500e28ed088ec39ff0adc1be3d358a8ad062926aaa62c36b28bde00919e4e8
