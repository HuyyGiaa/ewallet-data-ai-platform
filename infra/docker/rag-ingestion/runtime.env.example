# Settings for the rag_fraud_policy DAG tasks (ops.llm_agent.rag_ingest).
# Copy to ~/.config/ewallet-rag/runtime.env and chmod 600, or export the same
# names in the Airflow worker environment. Only these keys are accepted.
# Never commit the filled-in copy.

# Canonical profile (online_store=redis): the existing Feast Online Redis plus a RAG-owned
# registry. Never point this at the MLOps online registry of the historical fraud features.
EWALLET_RAG_FEAST_REGISTRY=gs://<bucket>/features/registries/rag/fraud-policy-feast-v1/registry.db
EWALLET_RAG_FEAST_PROJECT=ewallet_rag
# Laptop Airflow: through `kubectl -n feature-store port-forward svc/redis 16380:6379`.
EWALLET_REDIS_CONNECTION_STRING=127.0.0.1:16380,password=<redis-password>
# Immutable offline parquet per feature_index_revision (default: data/rag/feast, local-dev).
EWALLET_RAG_PUBLICATION_BASE=gs://<bucket>/features/rag

# DataHub (datahub_mode=publish fails without the URL).
DATAHUB_GMS_URL=http://<datahub-gms-host>:8080
DATAHUB_GMS_TOKEN=

# Optional.
HF_HOME=/home/<user>/.cache/ewallet-rag-hf
EWALLET_RAG_EMBED_THREADS=2
GOOGLE_APPLICATION_CREDENTIALS=
