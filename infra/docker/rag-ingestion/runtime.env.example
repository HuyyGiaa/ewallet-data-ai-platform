# Settings for the rag_fraud_policy_ingestion DAG tasks (ops.llm_agent.rag_ingest).
# Copy to ~/.config/ewallet-rag/runtime.env and chmod 600, or export the same
# names in the Airflow worker environment. Only these keys are accepted.
# Never commit the filled-in copy. For the Hybrid run, prefer
#   RAG_TARGET=gke scripts/llm_agent/rag_runtime_run.sh configure <db 2-15> ewallet_rag_<suffix>
# which writes this file from the Secret feature-store/redis without printing the password.

# verification (default): Redis DB 2-15, Feast project ewallet_rag_<suffix>, ownership claim.
# production: DB 0 and project ewallet_rag only (what the RAG MCP server reads); owner change only.
EWALLET_RAG_ONLINE_TARGET=verification
EWALLET_RAG_FEAST_PROJECT=ewallet_rag_<suffix>
# GCS paths of a verification run must contain /<project>/ (the bucket also holds production).
EWALLET_RAG_FEAST_REGISTRY=gs://<bucket>/features/registries/rag/ewallet_rag_<suffix>/registry.db
# Immutable offline parquet per feature_index_revision below this base.
EWALLET_RAG_PUBLICATION_BASE=gs://<bucket>/features/rag/ewallet_rag_<suffix>
# Laptop Airflow reaches the GKE Redis through the runner's port-forward on 127.0.0.1:16380.
# The database is mandatory: without ,db=N Redis would use production DB 0.
EWALLET_REDIS_CONNECTION_STRING=127.0.0.1:16380,password=<redis-password>,db=<2-15>

# DataHub (datahub_mode=publish fails without the URL); local quickstart GMS.
DATAHUB_GMS_URL=http://127.0.0.1:18080
DATAHUB_GMS_TOKEN=

# Optional.
HF_HOME=/home/<user>/.cache/ewallet-rag-hf
EWALLET_RAG_EMBED_THREADS=2
GOOGLE_APPLICATION_CREDENTIALS=
