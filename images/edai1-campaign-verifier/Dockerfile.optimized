# syntax=docker/dockerfile:1.7
# OPTIMIZED: multi-stage build with a minimal, validated payload.
#   - Dockerfile.optimized.dockerignore limits the build context to the verifier package;
#   - the build stage byte-compiles the package and imports every module (fails the build on error);
#   - the runtime stage receives only the compiled package, read-only and root-owned;
#   - slim Debian Bookworm runtime, digest-pinned, fixed non-root UID/GID 65532.
# RUNTIME_IMAGE/BUILD_IMAGE are build arguments only so the A/B harness can build the
# full-base control variant; the published image uses the defaults below.
ARG BUILD_IMAGE=python:3.13.9-slim-bookworm@sha256:8cdd496996889eef0a8a7921c152c0a4a9f18a26c7a5e7257d3c90b431891894
ARG RUNTIME_IMAGE=python:3.13.9-slim-bookworm@sha256:8cdd496996889eef0a8a7921c152c0a4a9f18a26c7a5e7257d3c90b431891894

FROM ${BUILD_IMAGE} AS build
WORKDIR /build
COPY ops/edai1_verifier/ /build/edai1_verifier/
RUN python -m compileall -q /build/edai1_verifier \
    && python -c "import edai1_verifier.__main__, edai1_verifier.report, edai1_verifier.checks, edai1_verifier.spec" \
    && python -m edai1_verifier --help > /dev/null \
    && chmod -R a=rX,u-w /build/edai1_verifier

FROM ${RUNTIME_IMAGE} AS runtime
RUN groupadd --system --gid 65532 verifier \
    && useradd --system --uid 65532 --gid 65532 --no-create-home --shell /usr/sbin/nologin verifier
WORKDIR /app
COPY --from=build --chown=0:0 /build/edai1_verifier /app/edai1_verifier
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 65532:65532
ENTRYPOINT ["python", "-m", "edai1_verifier"]
