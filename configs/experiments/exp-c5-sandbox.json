{
  "experiment_id": "EXP-C5-SANDBOX",
  "hypothesis": "A sandboxed Feature-RAG specialist returns the same tool evidence as the same image in a Deployment. Startup, latency and resource cost are measured, with no expected winner: gVisor is an isolation choice, and slower can be an acceptable result.",
  "variable": "Runtime: kagent BYO Deployment versus SandboxAgent on a gVisor WorkerPool, both in ewallet-sandbox",
  "baseline": "byo-deployment",
  "optimized": "sandbox-agent",
  "controls": [
    "load_profile_sha256",
    "image_digest",
    "tool_set",
    "namespace"
  ],
  "metrics": [
    {
      "name": "initialization_seconds",
      "direction": "lower",
      "path": "initialization_seconds"
    },
    {
      "name": "first_success_seconds",
      "direction": "lower",
      "path": "first_success_seconds"
    },
    {
      "name": "e2e_p50_ms",
      "direction": "lower",
      "path": "e2e_ms.p50"
    },
    {
      "name": "e2e_p95_ms",
      "direction": "lower",
      "path": "e2e_ms.p95"
    },
    {
      "name": "resume_e2e_p50_ms",
      "direction": "lower",
      "path": "resume_e2e_ms.p50"
    },
    {
      "name": "successful_mcp_calls",
      "direction": "higher",
      "path": "successful_mcp_calls"
    },
    {
      "name": "cpu_cores_mean",
      "direction": "lower",
      "path": "cpu_cores_mean"
    },
    {
      "name": "memory_mib_peak",
      "direction": "lower",
      "path": "memory_mib_peak"
    },
    {
      "name": "worker_cpu_limit_percent",
      "direction": "lower",
      "path": "worker_cpu_limit_percent"
    },
    {
      "name": "recovery_seconds",
      "direction": "lower",
      "path": "recovery_seconds"
    }
  ],
  "primary_metric": "e2e_p95_ms",
  "min_runs": 2,
  "significant_percent": 10,
  "screenshots": [
    "kagent agent list showing both arms in ewallet-sandbox",
    "SandboxAgent Ready condition and ActorTemplate golden snapshot",
    "WorkerPool readback and worker pod usage",
    "One completed A2A task from each arm",
    "comparison.md with the verdict"
  ]
}
