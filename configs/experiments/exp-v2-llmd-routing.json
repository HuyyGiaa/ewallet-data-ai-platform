{
  "experiment_id": "EXP-V2",
  "hypothesis": "llm-d Endpoint Picker routing improves latency over Kubernetes Service routing for shared-prefix traffic at higher concurrency, without harming low concurrency.",
  "variable": "Routing path: Kubernetes Service versus llm-d EPP",
  "baseline": "k8s-service",
  "optimized": "llmd-epp",
  "controls": [
    "workload_sha256",
    "image_digest",
    "model_revision",
    "cpu_request",
    "memory_request",
    "node_type",
    "replicas",
    "thread_bind",
    "gateway_token_budget"
  ],
  "metrics": [
    {
      "name": "ttft_p50_ms",
      "direction": "lower",
      "path": "ttft_ms.p50"
    },
    {
      "name": "ttft_p95_ms",
      "direction": "lower",
      "path": "ttft_ms.p95"
    },
    {
      "name": "e2e_p50_ms",
      "direction": "lower",
      "path": "e2e_ms.p50"
    },
    {
      "name": "e2e_p95_ms",
      "direction": "lower",
      "path": "e2e_ms.p95"
    },
    {
      "name": "output_tokens_per_second",
      "direction": "higher",
      "path": "output_tokens_per_second"
    },
    {
      "name": "request_throughput",
      "direction": "higher",
      "path": "requests_per_second"
    },
    {
      "name": "tpot_ms",
      "direction": "lower",
      "path": "tpot_ms.p50"
    },
    {
      "name": "cpu_cores_mean",
      "direction": "lower",
      "path": "derived.cpu_cores_mean"
    },
    {
      "name": "memory_mib_peak",
      "direction": "lower",
      "path": "derived.memory_mib_peak"
    },
    {
      "name": "prefix_cache_hit_ratio",
      "direction": "higher",
      "path": "derived.prefix_cache_hit_rate"
    },
    {
      "name": "queue_time_ms",
      "direction": "lower",
      "path": "derived.queue_time_mean_ms"
    }
  ],
  "primary_metric": "e2e_p95_ms",
  "min_runs": 3,
  "significant_percent": 10,
  "screenshots": [
    "Baseline configuration (Deployment env and args)",
    "Baseline benchmark terminal output",
    "Baseline Cloud Monitoring panels for namespace ewallet-bench for the same window",
    "Optimized configuration",
    "Optimized benchmark terminal output",
    "Optimized Cloud Monitoring panels for namespace ewallet-bench for the same window",
    "comparison.md with the verdict",
    "kubectl get nodes,pods -o wide during each arm",
    "manifest.json with source SHA and image digest",
    "Per-replica request distribution for each arm",
    "EPP routing log excerpt"
  ]
}
