# Runtime profile
EWALLET_ENV=local

# Local MinIO adapter (required for the local profile)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=replace-with-local-access-key
MINIO_SECRET_KEY=replace-with-local-secret-key

# Optional local overrides
EWALLET_SOURCE_ROOT=file:///tmp/ewallet-source
EWALLET_FEAST_ROOT=file:///tmp/ewallet-feast
SPARK_EVENT_LOG_URI=file:///tmp/spark-events
TRINO_HOST=localhost

# GCP dev/gcp profiles
GCP_PROJECT_ID=replace-with-gcp-project-id
GCP_REGION=asia-southeast1
EWALLET_DATA_BUCKET=replace-with-gcs-bucket-name
DATAHUB_GMS_URL=http://replace-with-datahub-gms:8080

# Canonical MLOps cloud runtime (all values are required; no secrets here)
GKE_ZONE=asia-southeast1-b
GKE_NODE_POOL=cpu-pool
MLFLOW_TRACKING_URI=http://mlflow.ml-platform.svc.cluster.local:5000
MLFLOW_ARTIFACT_ROOT=gs://replace-with-gcs-bucket-name/mlflow/artifacts
MLFLOW_IMAGE=asia-southeast1-docker.pkg.dev/ewallet-data-ai-platform-hg26/ewallet-platform/mlflow:v3.17.1-gcs-postgres-1
MLFLOW_DB_USERNAME=mlflow
MLFLOW_DB_SECRET_NAME=mlflow-postgresql
MLFLOW_BACKEND_SECRET_NAME=mlflow-backend-store
MLFLOW_EXPERIMENT_NAME=ewallet-fraud-comparison
MLFLOW_REGISTERED_MODEL_NAME=ewallet-fraud-detector
GKE_CLUSTER=replace-with-gke-cluster
KFP_VERSION=2.17.3
KFP_NAMESPACE=kubeflow
KFP_RUNNER_KSA=pipeline-runner
TRAINING_GSA=ewallet-training@ewallet-data-ai-platform-hg26.iam.gserviceaccount.com
F9_RUNTIME_IMAGE=asia-southeast1-docker.pkg.dev/ewallet-data-ai-platform-hg26/ewallet-platform/f9-kfp-runtime:kfp-2.17.3-f9-v1
