Table silver_zone.accounts [headercolor: #5D6D7E, note: 'Silver. Grain: one row per (account_id).'] {
  account_id string [pk]
  user_id string [not null, note: 'Logical FK to users.user_id (required).']
  account_type string
  currency string
  created_at timestamp
}

Table silver_zone.balance_snapshots [headercolor: #5D6D7E, note: 'Silver. Grain: one row per (account_id, snapshot_date). Partitioned by snapshot_date.'] {
  account_id string [not null, note: 'Logical FK to accounts.account_id (required).']
  snapshot_date date
  closing_balance double
  indexes {
    (account_id, snapshot_date) [pk]
  }
}

Table silver_zone.devices [headercolor: #5D6D7E, note: 'Silver. Grain: one row per (device_id).'] {
  device_id string [pk]
  user_id string [not null, note: 'Logical FK to users.user_id (required).']
  device_type string
  os string
  first_seen_at timestamp
}

Table silver_zone.fraud_labels [headercolor: #5D6D7E, note: 'Silver. Grain: one row per (transaction_id).'] {
  transaction_id string [pk, note: 'Logical FK to transactions.transaction_id (required).']
  label integer
  fraud_type string
}

Table silver_zone.login_events [headercolor: #5D6D7E, note: 'Silver. Grain: one row per (login_id). Partitioned by login_date.'] {
  login_id string [pk]
  user_id string [not null, note: 'Logical FK to users.user_id (required).']
  device_id string [not null, note: 'Logical FK to devices.device_id (required).']
  login_ts timestamp
  is_success boolean
  login_date date
}

Table silver_zone.merchant_history [headercolor: #5D6D7E, note: 'Silver. Grain: one row per (snapshot_id).'] {
  snapshot_id string [pk]
  merchant_id string [not null, note: 'Logical FK to merchants.merchant_id (required).']
  merchant_name string
  category string
  snapshot_ts timestamp
  history_source string
  indexes {
    (merchant_id, snapshot_ts) [unique, name: 'uk_merchant_history_merchant_id_snapshot_ts']
  }
}

Table silver_zone.merchants [headercolor: #5D6D7E, note: 'Silver. Grain: one row per (merchant_id).'] {
  merchant_id string [pk]
  merchant_name string
  category string
}

Table silver_zone.transactions [headercolor: #5D6D7E, note: 'Silver. Grain: one row per (transaction_id). Partitioned by event_date.'] {
  transaction_id string [pk]
  account_id string [not null, note: 'Logical FK to accounts.account_id (required).']
  user_id string [not null, note: 'Logical FK to users.user_id (required).']
  device_id string [not null, note: 'Logical FK to devices.device_id (required).']
  type string
  amount double
  currency string
  status string
  old_balance double
  new_balance double
  merchant_id string [null, note: 'Logical FK to merchants.merchant_id (optional).']
  counterparty_account_id string [null, note: 'Logical FK to accounts.account_id (optional).']
  timestamp timestamp
  ingested_at timestamp
  channel string
  event_date date
}

Table silver_zone.users [headercolor: #5D6D7E, note: 'Silver. Grain: one row per (user_id).'] {
  user_id string [pk]
  full_name string
  email string
  phone string
  kyc_verified boolean
  created_at timestamp
}

TableGroup silver_master_data {
  silver_zone.users
  silver_zone.accounts
  silver_zone.merchants
  silver_zone.devices
}

TableGroup silver_events {
  silver_zone.transactions
  silver_zone.login_events
  silver_zone.balance_snapshots
}

TableGroup silver_labels_and_history {
  silver_zone.fraud_labels
  silver_zone.merchant_history
}

