// LOGICAL model of the observed Delta tables of one campaign profile. Keys and Refs
// come from data_platform/contracts/relationships/schema_relationships.yml; Delta
// itself declares no primary or foreign key and every column is physically nullable.
// `not null`/`null` on a referencing column is the business rule its validator checks.

Project edai1_gold_features {
  database_type: 'Delta Lake (Spark 3.5)'
  Note: 'Observed from rehearsal-5gb-v1, benchmark ab-20261110225456, profile optimized (gold run ab-20261110225456-optimized-gold-r261110225458, features run ab-20261110225456-optimized-feat-r261110225459); source manifest ac2dfb0eac16. Ref `>` = many-to-one, `-` = one-to-one; every Ref note names the executed validator rule.'
}

Table gold_zone.dim_account [headercolor: #1F6FB2, note: 'Dimension. Grain: one row per (account_id).'] {
  account_id string [pk]
  user_id string [not null, note: 'Logical FK to dim_user.user_id (required).']
  account_type string
  currency string
  created_at timestamp
}

Table gold_zone.dim_date [headercolor: #1F6FB2, note: 'Dimension. Grain: one row per (date_key).'] {
  date_key integer [pk]
  calendar_date date
  day integer
  month integer
  quarter integer
  year integer
  day_of_week string
  is_weekend boolean
}

Table gold_zone.dim_device [headercolor: #1F6FB2, note: 'Dimension. Grain: one row per (device_id).'] {
  device_id string [pk]
  user_id string [not null, note: 'Logical FK to dim_user.user_id (required).']
  device_type string
  os string
  first_seen_at timestamp
}

Table gold_zone.dim_merchant [headercolor: #1F6FB2, note: 'Dimension. Grain: one row per (merchant_id).'] {
  merchant_id string [pk]
  merchant_name string
  category string
}

Table gold_zone.dim_merchant_scd2 [headercolor: #1F6FB2, note: 'Dimension. Grain: one row per (merchant_sk). fact_transactions resolves a version as of its event time: merchant_id = merchant_id AND valid_from_ts <= timestamp AND (valid_to_ts IS NULL OR timestamp < valid_to_ts) (`dim_merchant_scd2.transactions_resolve_to_one_version` PASS in baseline and optimized (ab-20261110225456)). Not a key-based Ref.'] {
  merchant_sk string [pk, note: 'Surrogate version key: SHA-256 of merchant_id and valid_from_ts epoch microseconds.']
  merchant_id string [not null, note: 'Business key; several versions per merchant. Logical FK to dim_merchant.merchant_id (required).']
  merchant_name string
  category string
  valid_from_ts timestamp [note: 'Version start (inclusive), UTC.']
  valid_to_ts timestamp [note: 'Version end (exclusive); NULL for the current version.']
  is_current boolean [note: 'TRUE exactly when valid_to_ts IS NULL; one current version per merchant.']
  indexes {
    (merchant_id, valid_from_ts) [unique, name: 'uk_dim_merchant_scd2_merchant_id_valid_from_ts']
  }
}

Table gold_zone.dim_user [headercolor: #1F6FB2, note: 'Dimension. Grain: one row per (user_id).'] {
  user_id string [pk]
  full_name string
  email string
  phone string
  kyc_verified boolean
  created_at timestamp
}

Table gold_zone.fact_balance_snapshot [headercolor: #C0392B, note: 'Fact. Grain: one row per (account_id, snapshot_date). Partitioned by snapshot_date.'] {
  account_id string [not null, note: 'Logical FK to dim_account.account_id (required).']
  date_key integer [not null, note: 'Logical FK to dim_date.date_key (required).']
  snapshot_date date
  closing_balance double
  indexes {
    (account_id, snapshot_date) [pk]
  }
}

Table gold_zone.fact_login_events [headercolor: #C0392B, note: 'Fact. Grain: one row per (login_id). Partitioned by event_date.'] {
  login_id string [pk]
  user_id string [not null, note: 'Logical FK to dim_user.user_id (required).']
  device_id string [not null, note: 'Logical FK to dim_device.device_id (required).']
  date_key integer [not null, note: 'Logical FK to dim_date.date_key (required).']
  is_success boolean
  login_ts timestamp
  event_date date
}

Table gold_zone.fact_transactions [headercolor: #C0392B, note: 'Fact. Grain: one row per (transaction_id). Partitioned by event_date. As-of join to dim_merchant_scd2: merchant_id = merchant_id AND valid_from_ts <= timestamp AND (valid_to_ts IS NULL OR timestamp < valid_to_ts) (`dim_merchant_scd2.transactions_resolve_to_one_version` PASS in baseline and optimized (ab-20261110225456)).'] {
  transaction_id string [pk]
  user_id string [not null, note: 'Logical FK to dim_user.user_id (required).']
  account_id string [not null, note: 'Logical FK to dim_account.account_id (required).']
  merchant_id string [null, note: 'Logical FK to dim_merchant.merchant_id (optional).']
  device_id string [not null, note: 'Logical FK to dim_device.device_id (required).']
  counterparty_account_id string [null, note: 'Logical FK to dim_account.account_id (optional).']
  date_key integer [not null, note: 'Logical FK to dim_date.date_key (required).']
  type string
  status string
  channel string
  currency string
  amount double
  old_balance double
  new_balance double
  timestamp timestamp
  ingested_at timestamp
  event_date date
}

Table gold_zone.feat_user_90d [headercolor: #1E8449, note: 'Feature. Grain: one row per (user_id).'] {
  user_id string [pk, note: 'Logical FK to dim_user.user_id (required).']
  f_user_total_transactions_90d long
  f_user_avg_transaction_amount_90d double
  f_user_failed_transaction_rate_90d double
  f_user_distinct_merchants_90d long
  event_timestamp timestamp [note: 'Feature event time: the reference time the 90-day window ends at.']
  created_timestamp timestamp [note: 'Legacy name of the materialization time; validated equal to created.']
  created timestamp [note: 'Materialization time of this DP2 run; one value per table.']
}

