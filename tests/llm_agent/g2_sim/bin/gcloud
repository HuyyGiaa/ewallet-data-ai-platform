#!/usr/bin/env python3
"""Fake gcloud for the offline G2 runner simulation: node pool size, resize, delete-instances."""

from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import simstate  # noqa: E402

line = " ".join(sys.argv[1:])
with simstate.locked() as s:
    s["calls"].append("gcloud " + line[:150])
    if "instance-groups managed list" in line:
        print(s["pool"])
    elif "clusters resize" in line:
        target = int(sys.argv[sys.argv.index("--num-nodes") + 1])
        while len(s["nodes"]) < target:
            s["nodes"][f"sim-g2-{len(s['nodes'])}"] = {}
        s["pool"] = target
    elif "node-pools describe" in line:
        print("https://x/zones/z/instanceGroupManagers/sim-mig")
    elif "delete-instances" in line:
        names = next(a for a in sys.argv if a.startswith("--instances=")).split("=", 1)[1].split(",")
        for name in names:
            s["nodes"].pop(name, None)
        s["pool"] -= len(names)
    else:
        sys.stderr.write(f"fake gcloud: unsupported call: {line}\n")
        sys.exit(3)
