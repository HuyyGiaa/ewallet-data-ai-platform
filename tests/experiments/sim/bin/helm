#!/usr/bin/env python3
"""Fake helm for the offline benchmark session; ``pull`` copies the pinned chart."""
import os, shutil, sys
from pathlib import Path

state = Path(os.environ["SIM_STATE"])
argv = sys.argv[1:]
(state / "calls.log").open("a").write("helm " + " ".join(argv) + "\n")
if argv[0] == "list":
    revision = (state / "prod-revision").read_text() if (state / "prod-revision").exists() else "41"
    print(f'[{{"name":"llm-agent","revision":"{revision}"}}]')
elif argv[0] == "pull":
    shutil.copy(os.environ["G2_ROUTER_CHART"], argv[argv.index("-d") + 1])
