#!/usr/bin/env python3
"""Fake kubectl for the isolated MCP run: records calls and keeps the namespace state."""
import json, os, sys, time
from pathlib import Path

state = Path(os.environ["SIM_STATE"])
argv = sys.argv[1:]
(state / "calls.log").open("a").write("kubectl " + " ".join(argv) + "\n")
text = " ".join(argv)
ns = state / "namespace"
digest = "sha256:" + "e" * 64
if " apply " in text:
    data = sys.stdin.read() if argv[-1] == "-" else ""
    if "kind: Namespace" in data:
        ns.write_text("true")
elif "get namespace" in text:
    if "SIM_FOREIGN_NAMESPACE" in os.environ:
        print("", end="")
    if ns.exists():
        print("true" if "jsonpath" in text else "namespace/ewallet-mcp-exp", end="")
elif "delete namespace" in text:
    if os.environ.get("SIM_DELETE_FAILS") != "yes":
        ns.unlink(missing_ok=True)
    else:
        sys.exit(1)
elif "create secret" in text or "patch secret" in text:
    sys.stdin.read()
elif " rollout " in text or " wait " in text:
    if "condition=complete" in text and os.environ.get("SIM_JOB_FAILS") == "yes":
        sys.exit(1)
elif " delete pod " in text:
    (state / "deleted").write_text(text)
elif "-n ewallet-mcp get" in text:
    revision = (state / "prod").read_text() if (state / "prod").exists() else "1"
    print(f"prod {revision}")
elif " logs " in text:
    now = time.time()
    fails = os.environ.get("SIM_FAILS", "0") == "1"
    for index in range(6):
        ok = not (fails and index in (2, 3))
        print("LOAD_ROW " + json.dumps({"id": f"c{index}", "ok": ok, "state": "completed" if ok else "failed",
                                        "started": now - 20 + index, "finished": now - 19 + index,
                                        "e2e_ms": 900.0 + index}))
elif "readyReplicas" in text:
    print("1", end="")
elif "get pods" in text and "wide" in text or "get nodes" in text:
    print("row")
elif "get pods" in text:
    print("mcp-exp-drift-abc", end="")
elif "get deployment/" in text or "get job/" in text:
    print(f"repo/image@{digest}", end="")
else:
    sys.stderr.write(f"fake kubectl: unsupported: {text}\n"); sys.exit(1)
