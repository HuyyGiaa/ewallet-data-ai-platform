      "uid": "bench-prom"
     },
     "expr": "sum by (pod, run_id) (rate(vllm:prompt_tokens_total{job=\"vllm\",run_id=~\"$run_id\"}[1m]))",
     "legendFormat": "{{pod}} {{run_id}}"
    }
   ]
  },
  {
   "id": 5,
