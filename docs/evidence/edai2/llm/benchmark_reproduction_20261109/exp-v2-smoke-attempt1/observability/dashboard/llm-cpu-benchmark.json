{
 "uid": "edai2-llm-cpu-bench",
 "title": "EDAI-2 — LLM CPU Benchmark (EXP-V1 / EXP-V2)",
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
 "tags": [
  "edai2",
  "benchmark",
  "ewallet-bench"
 ],
 "timezone": "utc",
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "run_id",
    "label": "run (arm-run)",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "bench-prom"
    },
    "query": {
     "query": "label_values(vllm:num_requests_running, run_id)",
     "refId": "run_id"
    },
    "definition": "label_values(vllm:num_requests_running, run_id)",
    "refresh": 2,
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "current": {
     "selected": true,
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "text",
   "title": "About these panels",
   "gridPos": {
    "h": 3,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "options": {
    "mode": "markdown",
    "content": "Namespace **ewallet-bench** only (temporary benchmark stack, not production). `run_id` = arm-run, e.g. `baseline-01`. Server-side percentiles are histogram estimates; the benchmark client's raw records (`raw/run-NN/summary.json`) are authoritative. CPU/memory come from metrics-server via `metrics.k8s.io`. EPP panels have data only in the EXP-V2 optimized (llm-d) arm."
   }
  },
  {
   "id": 2,
   "type": "row",
   "title": "A. Serving performance",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 3
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Output tokens/s per vLLM pod",
   "datasource": {
    "type": "prometheus",
    "uid": "bench-prom"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "noValue": "no data: series absent"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "bench-prom"
     },
     "expr": "sum by (pod, run_id) (rate(vllm:generation_tokens_total{job=\"vllm\",run_id=~\"$run_id\"}[1m]))",
     "legendFormat": "{{pod}} {{run_id}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Prompt tokens/s per vLLM pod",
   "datasource": {
    "type": "prometheus",
    "uid": "bench-prom"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "noValue": "no data: series absent"
