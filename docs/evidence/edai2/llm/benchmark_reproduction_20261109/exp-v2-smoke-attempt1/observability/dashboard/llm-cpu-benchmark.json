   "title": "TTFT p50 / p95 (vLLM histogram)",
   "datasource": {
    "type": "prometheus",
    "uid": "bench-prom"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "noValue": "no data: series absent"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max"
