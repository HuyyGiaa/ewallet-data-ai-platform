@@ -0,0 +1,293 @@
+"""Read-only GKE checks around an edge campaign (G3-A1 / G3-B / G4), replayable from the repo.
+
+Subcommands (all read-only: kubectl get, and exec of read-only GETs / pilot-agent dumps):
+  backends   readiness, restarts and endpoints of the four backends (+ kagent-controller) and
+             their callers (Jenkins -> Registry, Grafana -> Prometheus/Loki/Tempo); --out writes
+             the snapshot used as a baseline
+  compare    the same, judged against a baseline snapshot (no new restarts, still ready)
+  watch      a Deployment's pod stays Ready with unchanged restarts for --seconds (the kagent-ui
+             probe check after the edge NetworkPolicy lands)
+  gateway    GatewayClass/Gateway/HTTPRoute/ReferenceGrant conditions
+  envoy      the edge gateway's active config: filter order on 443, nothing on 80, route names,
+             per-route buckets, no retries, TLS secret; --wait captures the FIRST config that has
+             a 443 listener (staged 0 -> 1 rollout)
+  sleep-feasibility  the PDBs a wake-full would make blockers, against the approved guarded record
+
+Every check prints one JSON line {"check", "passed", "observed"}; the exit code is 1 if any failed.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+import subprocess
+import sys
+import time
+from typing import Callable
+
+import yaml
+
+ROOT = Path(__file__).resolve().parents[2]
+NS = "ewallet-ingress"
+GATEWAY = "ewallet-edge-gateway"
+BACKENDS = [("ml-platform", "feature-api"), ("kagent", "kagent-ui"), ("kagent", "kagent-controller"),
+            ("ewallet-prompts", "prompt-registry-agentregistry"), ("ewallet-agents", "grafana")]
+ROUTES = ["feature-api", "kagent-ui", "agent-registry", "grafana"]
+SECURITY = ("envoy.filters.http.local_ratelimit", "envoy.filters.http.basic_auth")
+
+
+class Kube:
+    """kubectl pinned to one kubeconfig and context."""
+
+    def __init__(self, context: str, kubeconfig: str | None = None, runner: Callable[[list[str]], str] | None = None):
+        self.base = ["kubectl", *(["--kubeconfig", kubeconfig] if kubeconfig else []), "--context", context]
+        self.runner = runner or (lambda cmd: subprocess.run(cmd, capture_output=True, text=True, check=False).stdout)
+
+    def json(self, *args: str) -> dict:
+        return json.loads(self.runner([*self.base, *args, "-o", "json"]) or "{}")
+
+    def exec(self, namespace: str, target: str, *command: str, container: str | None = None) -> str:
+        return self.runner([*self.base, "-n", namespace, "exec", target, *(["-c", container] if container else []), "--", *command])
+
+
+def result(check: str, passed: bool, observed: object) -> dict:
+    return {"check": check, "passed": bool(passed), "observed": observed}
+
+
+# --- backends -----------------------------------------------------------------------------------
+
+def snapshot(kube: Kube) -> dict:
+    """Readiness, restarts and ready endpoints per backend, plus the callers' answers."""
+    out: dict = {"backends": {}, "callers": {}}
+    for ns, name in BACKENDS:
+        deploy = kube.json("-n", ns, "get", "deploy", name)
+        selector = deploy.get("spec", {}).get("selector", {}).get("matchLabels", {})
+        pods = kube.json("-n", ns, "get", "pods", "-l", ",".join(f"{k}={v}" for k, v in selector.items())).get("items", [])
+        slices = kube.json("-n", ns, "get", "endpointslices", "-l", f"kubernetes.io/service-name={name}").get("items", [])
+        out["backends"][f"{ns}/{name}"] = {
+            "ready_replicas": deploy.get("status", {}).get("readyReplicas", 0) or 0,
+            "restarts": sum(c.get("restartCount", 0) for p in pods for c in p.get("status", {}).get("containerStatuses", [])),
+            "ready_endpoints": sum(1 for s in slices for e in s.get("endpoints") or [] if e.get("conditions", {}).get("ready")),
+        }
+    jenkins = next(iter(kube.json("-n", "ewallet-ci", "get", "pods", "-l", "app.kubernetes.io/name=jenkins").get("items", [])), None)
+    if jenkins:
+        line = kube.exec("ewallet-ci", jenkins["metadata"]["name"], "bash", "-c",
+                         'exec 3<>/dev/tcp/prompt-registry-agentregistry.ewallet-prompts.svc/12121 && '
+                         'printf "GET / HTTP/1.0\\r\\nHost: x\\r\\n\\r\\n" >&3 && head -1 <&3', container="jenkins")
+        out["callers"]["jenkins->registry"] = line.strip()
+    grafana = next(iter(kube.json("-n", "ewallet-agents", "get", "pods", "-l", "app.kubernetes.io/name=grafana").get("items", [])), None)
+    for target in ("prometheus:9090/-/ready", "loki:3100/ready", "tempo:3200/ready"):
+        answer = kube.exec("ewallet-agents", grafana["metadata"]["name"], "wget", "-q", "-O", "-", "-T", "10", f"http://{target}") if grafana else ""
+        out["callers"][f"grafana->{target.split(':')[0]}"] = answer.strip().splitlines()[0] if answer.strip() else ""
+    return out
+
+
+def judge(current: dict, baseline: dict | None = None) -> list[dict]:
+    """Every backend ready with a ready endpoint (where it has a Service), callers answering, and
+    against a baseline: no backend restarted since."""
+    results = []
+    for key, now in current["backends"].items():
+        before = (baseline or {}).get("backends", {}).get(key)
+        ok = now["ready_replicas"] >= 1 and (now["ready_endpoints"] >= 1 or key.endswith("kagent-controller"))
+        if before is not None:
+            ok = ok and now["restarts"] <= before["restarts"]
+        results.append(result(f"backend {key}", ok, {**now, **({"baseline_restarts": before["restarts"]} if before else {})}))
+    callers = current["callers"]
+    results.append(result("jenkins -> registry", callers.get("jenkins->registry", "").startswith("HTTP/1.0 200"),
+                          callers.get("jenkins->registry")))
+    for name in ("prometheus", "loki", "tempo"):
+        answer = callers.get(f"grafana->{name}", "")
+        results.append(result(f"grafana -> {name}", "ready" in answer.lower(), answer))
+    return results
+
+
+def watch(kube: Kube, namespace: str, deployment: str, seconds: int, interval: int, sleep=time.sleep,
+          now: Callable[[], str] = lambda: time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())) -> list[dict]:
+    """The Deployment's pods stay Ready, restarts do not change, and no Unhealthy/BackOff/Killing
+    event for it appears after the start, for ``seconds``."""
+    started = now()
+    selector = kube.json("-n", namespace, "get", "deploy", deployment)["spec"]["selector"]["matchLabels"]
+    label = ",".join(f"{k}={v}" for k, v in selector.items())
+    samples = []
+    for _ in range(max(1, seconds // interval)):
+        pods = kube.json("-n", namespace, "get", "pods", "-l", label).get("items", [])
+        samples.append([(p["metadata"]["name"], all(c.get("ready") for c in p["status"].get("containerStatuses", [])),
+                         sum(c.get("restartCount", 0) for c in p["status"].get("containerStatuses", []))) for p in pods])
+        sleep(interval)
+    events = [e for e in kube.json("-n", namespace, "get", "events").get("items", [])
+              if e.get("reason") in ("Unhealthy", "BackOff", "Killing")
+              and e.get("involvedObject", {}).get("name", "").startswith(deployment)
+              and (e.get("lastTimestamp") or e.get("eventTime") or "") >= started]
+    restarts = lambda sample: [r for *_, r in sample]
+    steady = all(sample and all(ready for _, ready, _ in sample) and restarts(sample) == restarts(samples[0]) for sample in samples)
+    return [result(f"{namespace}/{deployment} stays Ready for {seconds}s", steady and not events,
+                   {"samples": len(samples), "first": samples[0], "last": samples[-1], "probe_events": len(events)})]
+
+
+# --- gateway and envoy --------------------------------------------------------------------------
+
+def conditions(obj: dict) -> dict:
+    return {c["type"]: c["status"] for c in obj.get("status", {}).get("conditions", [])}
+
+
+def gateway_checks(gatewayclass: dict, gateway: dict, routes: list[dict], grants: list[dict], expect_programmed: bool) -> list[dict]:
+    listeners = {l["name"]: {c["type"]: c["status"] for c in l.get("conditions", [])} for l in gateway.get("status", {}).get("listeners", [])}
+    route_state = {r["metadata"]["name"]: {c["type"]: c["status"] for p in r.get("status", {}).get("parents", []) for c in p["conditions"]}
+                   for r in routes}
+    return [
+        result("GatewayClass istio Accepted", conditions(gatewayclass).get("Accepted") == "True", conditions(gatewayclass)),
+        result("Gateway Accepted", conditions(gateway).get("Accepted") == "True", conditions(gateway)),
+        result(f"Gateway Programmed is {expect_programmed}", (conditions(gateway).get("Programmed") == "True") == expect_programmed,
+               conditions(gateway)),
+        result("listeners https and http accepted with resolved refs", {"https", "http"} <= set(listeners) and all(
+            v.get("Accepted") == "True" and v.get("ResolvedRefs") == "True" for v in listeners.values()), listeners),
+        result("every HTTPRoute Accepted with ResolvedRefs", bool(route_state) and all(
+            v.get("Accepted") == "True" and v.get("ResolvedRefs") == "True" for v in route_state.values()), route_state),
+        result("each ReferenceGrant: HTTPRoute@ewallet-ingress -> one Service", bool(grants) and all(
+            [f.get("namespace") for f in g["spec"]["from"]] == [NS] and len(g["spec"]["to"]) == 1 and g["spec"]["to"][0].get("kind") == "Service"
+            for g in grants), [f"{g['metadata']['namespace']}/{g['metadata']['name']}" for g in grants]),
+    ]
+
+
+def envoy_checks(dump: dict, limits: dict[str, int], restricted: bool = False) -> list[dict]:
+    """The edge gateway's active config, as G3-A1 verified it."""
+    chains, routes, secrets = {}, {}, []
+    for c in dump.get("configs", []):
+        for l in c.get("dynamic_listeners", []):
+            active = l.get("active_state", {}).get("listener", {})
+            port = active.get("address", {}).get("socket_address", {}).get("port_value")
+            for fc in active.get("filter_chains", []):
+                for f in fc.get("filters", []):
+                    names = [h["name"] for h in f.get("typed_config", {}).get("http_filters", [])]
+                    chains[port] = names or chains.get(port, [])
+        for r in c.get("dynamic_route_configs", []):
+            for vh in r.get("route_config", {}).get("virtual_hosts", []):
+                for x in vh.get("routes", []):
+                    routes[x.get("name")] = x
+        secrets += [s.get("name") for s in c.get("dynamic_active_secrets", [])]
+    https, http = chains.get(443, []), chains.get(80, [])
+    rl, ba, router = (*SECURITY, "envoy.filters.http.router")
+    buckets = {n: routes[n].get("typed_per_filter_config", {}).get(rl, {}).get("token_bucket", {}).get("max_tokens")
+               for n in ROUTES if n in routes}
+    out = [
+        result("443: rate limit, then Basic Auth, then router", rl in https and ba in https and router in https
+               and https.index(rl) < https.index(ba) < https.index(router), https),
+        result("80: no security filter", bool(http) and rl not in http and ba not in http, http),
+        result("routes named after the HTTPRoute rules", set(ROUTES) <= set(routes), sorted(n for n in routes if n)),
+        result("per-route token buckets equal values.yaml", buckets == {n: limits[n] for n in buckets} and len(buckets) == len(ROUTES), buckets),
+        result("no route retries", all("retry_policy" not in routes[n].get("route", {}) for n in ROUTES if n in routes),
+               [n for n in ROUTES if "retry_policy" in routes.get(n, {}).get("route", {})]),
+        result("TLS secret edge-tls loaded", f"kubernetes-gateway://{NS}/edge-tls" in secrets, secrets),
+    ]
+    if restricted:
+        out.append(result("443: RBAC (source restriction) active", "envoy.filters.http.rbac" in https, https))
+    return out
+
+
+def gateway_dump(kube: Kube, wait: int = 0, sleep=time.sleep) -> tuple[str, dict]:
+    """The first config of the gateway pod that has a 443 listener (``wait`` seconds at most)."""
+    for _ in range(max(1, wait)):
+        pods = kube.json("-n", NS, "get", "pods", "-l", f"istio={GATEWAY}").get("items", [])
+        if pods:
+            name = pods[0]["metadata"]["name"]
+            text = kube.exec(NS, name, "pilot-agent", "request", "GET", "config_dump")
+            if '"port_value": 443' in text:
+                return name, json.loads(text)
+        sleep(1)
+    return "", {}
+
+
+def route_limits() -> dict[str, int]:
+    values = yaml.safe_load((ROOT / "infra/helm/ewallet-edge/values.yaml").read_text())
+    return {n: r["rateLimit"]["maxTokens"] for n, r in values["routes"].items()}
+
+
+# --- sleep feasibility --------------------------------------------------------------------------
+
+def predict_blockers(pdbs: list[dict], deployments: list[dict], recorded: dict[str, int], approved: set[str]) -> dict:
+    """PDBs that block a drain to zero once wake-full restores the recorded replicas."""
+    sys.path.insert(0, str(ROOT / "ops/gcp"))
+    import cloud_lab  # noqa: E402 (the accepted Cloud Lab gate logic, reused as is)
+    blockers = []
+    for pdb in pdbs:
+        ns = pdb["metadata"]["namespace"]
+        labels = pdb["spec"].get("selector", {}).get("matchLabels") or {}
+        targets = [f"{ns}/{d['metadata']['name']}" for d in deployments if d["metadata"]["namespace"] == ns
+                   and labels.items() <= (d["spec"]["template"]["metadata"].get("labels") or {}).items()]
+        replicas = sum(recorded.get(t, 0) for t in targets)
+        if ns not in cloud_lab.SYSTEM_NAMESPACES and cloud_lab.evaluate_pdbs([{**pdb, "status": {"expectedPods": replicas}}]):
+            blockers.append(f"{ns}/{pdb['metadata']['name']}")
+    return {"predicted_blockers": sorted(blockers), "not_covered": sorted(set(blockers) - approved)}
+
+
+# --- CLI ----------------------------------------------------------------------------------------
+
+def emit(results: list[dict], out: Path | None) -> int:
+    for r in results:
+        print(json.dumps(r, default=str))
+    if out:
+        out.parent.mkdir(parents=True, exist_ok=True)
+        out.write_text("".join(json.dumps(r, default=str) + "\n" for r in results), encoding="utf-8")
+    return 0 if all(r["passed"] for r in results) else 1
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--context", required=True)
+    parser.add_argument("--kubeconfig")
+    sub = parser.add_subparsers(dest="command", required=True)
+    backends = sub.add_parser("backends")
+    backends.add_argument("--snapshot-out", type=Path, help="write the snapshot (baseline for compare)")
+    compare = sub.add_parser("compare")
+    compare.add_argument("--baseline", type=Path, required=True)
+    w = sub.add_parser("watch")
+    w.add_argument("--namespace", default="kagent")
+    w.add_argument("--deployment", default="kagent-ui")
+    w.add_argument("--seconds", type=int, default=180)
+    w.add_argument("--interval", type=int, default=15)
+    g = sub.add_parser("gateway")
+    g.add_argument("--expect-programmed", choices=["true", "false"], default="true")
+    e = sub.add_parser("envoy")
+    e.add_argument("--wait", type=int, default=0, help="seconds to wait for the first 443 listener")
+    e.add_argument("--restricted", action="store_true", help="also require the RBAC filter (source restriction)")
+    s = sub.add_parser("sleep-feasibility")
+    s.add_argument("--manifest", type=Path, required=True, help="recovery manifest directory (workloads.json)")
+    s.add_argument("--approved-record", type=Path, default=ROOT / "docs/evidence/edai2/cloud_lab/sleep_20261106T163042Z")
+    s.add_argument("--also-approve", action="append", default=[], metavar="NS/NAME", help="owner-approved extra PDBs")
+    for p in (backends, compare, w, g, e, s):
+        p.add_argument("--out", type=Path, help="also write the results as JSON lines")
+    args = parser.parse_args(argv)
+    kube = Kube(args.context, args.kubeconfig)
+    if args.command == "backends":
+        snap = snapshot(kube)
+        if args.snapshot_out:
+            args.snapshot_out.write_text(json.dumps(snap, indent=2) + "\n", encoding="utf-8")
+        return emit(judge(snap), args.out)
+    if args.command == "compare":
+        return emit(judge(snapshot(kube), json.loads(args.baseline.read_text())), args.out)
+    if args.command == "watch":
+        return emit(watch(kube, args.namespace, args.deployment, args.seconds, args.interval), args.out)
+    if args.command == "gateway":
+        gw = kube.json("-n", NS, "get", "gateways.gateway.networking.k8s.io", "ewallet-edge")
+        results = gateway_checks(kube.json("get", "gatewayclass", "istio"), gw,
+                                 kube.json("-n", NS, "get", "httproutes.gateway.networking.k8s.io").get("items", []),
+                                 kube.json("get", "referencegrants.gateway.networking.k8s.io", "-A").get("items", []),
+                                 args.expect_programmed == "true")
+        return emit(results, args.out)
+    if args.command == "envoy":
+        pod, dump = gateway_dump(kube, args.wait)
+        results = [result("a gateway pod with a 443 listener", bool(pod), pod or "none")]
+        return emit(results + (envoy_checks(dump, route_limits(), args.restricted) if pod else []), args.out)
+    sys.path.insert(0, str(ROOT / "ops/gcp"))
+    import cloud_lab  # noqa: E402
+    recorded = {f"{w['namespace']}/{w['name']}": int(w.get("replicas") or 0)
+                for w in json.loads((args.manifest / "workloads.json").read_text()) if w["kind"] == "Deployment"}
+    approved = cloud_lab.approved_guarded_pdbs(args.approved_record) | set(args.also_approve)
+    prediction = predict_blockers(kube.json("get", "pdb", "-A").get("items", []), kube.json("get", "deploy", "-A").get("items", []),
+                                  recorded, approved)
+    return emit([result("every predicted PDB blocker is covered by an approval", not prediction["not_covered"], prediction)], args.out)
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/edge/public_e2e.py b/scripts/edge/public_e2e.py
new file mode 100644
index 00000000..e298c36d
--- /dev/null
+++ b/scripts/edge/public_e2e.py
@@ -0,0 +1,174 @@
+"""Replayable end-to-end checks through the edge gateway for rubric rows 37-43 (G3-B / G4).
+
+Runs against any address of the gateway: the public LoadBalancer (G3-B/G4) or a port-forward
+(G3-A style). Row 42 (Basic Auth and rate limiting) is negative_tests.py; this script covers
+the rest and labels every result with --evidence-class (LOCAL_KIND, GKE_PRIVATE,
+PUBLIC_INTERNET), which is never inferred.
+
+Read-only on the backends. Grafana is reached by a form login: the edge strips Authorization,
+so its API cannot use Basic Auth. Its credentials come from a file outside the repository
+(``user:password``), as do the edge credentials. Nothing secret is printed.
+
+  python3 scripts/edge/public_e2e.py --address <LB IP> --domain ewallet-hg.gleeze.com \
+      --credentials-file ~/private/edge-cred --grafana-credentials-file ~/private/grafana-cred \
+      --evidence-class PUBLIC_INTERNET --out ~/ewallet-evidence/gateway/<campaign>/e2e.jsonl
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+import re
+import subprocess
+import sys
+import tempfile
+from urllib.parse import quote, urlsplit
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import negative_tests as nt  # noqa: E402  (the harness's curl client: SNI, Host, credentials on stdin)
+
+ROOT = Path(__file__).resolve().parents[2]
+HOSTS = ("features", "agents", "registry", "observe")
+
+
+def row(results: list, rubric: str, name: str, passed: bool, observed: object) -> None:
+    results.append({"row": rubric, "check": name, "passed": bool(passed), "observed": str(observed)[:300]})
+
+
+def private_file(path: str) -> str:
+    """Read a credential file that must live outside the repository."""
+    resolved = Path(path).resolve()
+    if resolved == ROOT or ROOT in resolved.parents:
+        raise SystemExit(f"{resolved} is inside the repository; keep credentials outside it")
+    return resolved.read_text(encoding="utf-8").rstrip("\r\n")
+
+
+def tls_checks(edge: nt.Edge, results: list, run=subprocess.run) -> None:
+    """Row 43: the certificate verifies (system trust unless --ca-file), names every host, and
+    TLS 1.1 is refused."""
+    base = ["openssl", "s_client", "-connect", f"{edge.address}:{edge.https}", "-servername", f"features.{edge.domain}"]
+    trust = ["-CAfile", edge.ca] if edge.ca else []
+    verify = run([*base, *trust, "-verify_return_error"], input="", capture_output=True, text=True).stdout
+    row(results, "43", "certificate verifies", "Verify return code: 0 (ok)" in verify,
+        next((l.strip() for l in verify.splitlines() if "Verify return code" in l), "no handshake"))
+    cert = run([*base, *trust], input="", capture_output=True, text=True).stdout
+    sans = run(["openssl", "x509", "-noout", "-ext", "subjectAltName"], input=cert, capture_output=True, text=True).stdout
+    names = set(re.findall(r"DNS:([^,\s]+)", sans))
+    wanted = {f"{h}.{edge.domain}" for h in HOSTS}
+    row(results, "43", "certificate names the four hosts", wanted <= names, sorted(names))
+    old = run([*base, "-tls1_1", "-cipher", "DEFAULT@SECLEVEL=0"], input="", capture_output=True, text=True).stdout
+    row(results, "43", "TLS 1.1 refused", "Cipher is (NONE)" in old or "Cipher is" not in old,
+        next((l.strip() for l in old.splitlines() if "Cipher is" in l), "no handshake"))
+
+
+def feature_checks(edge: nt.Edge, results: list, lookup: str | None) -> None:
+    """Row 43: the Feature API answers over HTTPS. An empty body proves the application was
+    reached (422 + correlation_id); a supplied synthetic lookup is reported separately and only
+    a 200 counts as BUSINESS_LOOKUP_SUCCESS."""
+    status, body = edge.authed("features", nt.LOOKUP, *nt.POST_JSON)
+    row(results, "43", "Feature API reached over HTTPS (APPLICATION_REACHED)", nt.reached_application(edge, status, body), status)
+    if lookup:
+        status, body = edge.authed("features", nt.LOOKUP, "-X", "POST", "-H", "content-type: application/json", "--data-binary", f"@{lookup}")
+        code = (json.loads(body).get("error", {}) or {}).get("code") if body.startswith("{") else None
+        row(results, "43", "synthetic lookup (BUSINESS_LOOKUP_SUCCESS only on 200)", status in (200, 422, 424),
+            f"status={status} {'BUSINESS_LOOKUP_SUCCESS' if status == 200 else 'APPLICATION_REACHED code=' + str(code)}")
+
+
+def ui_checks(edge: nt.Edge, results: list, rubric: str, host: str, api: str, expect: str = "allowed") -> None:
+    """Rows 40 (agents) and 41 (registry): HTML, one static asset and a read-only API answer.
+    For a restricted agents host seen from a non-allowed address, ``expect=denied`` wants 403."""
+    status, html = edge.authed(host, "/")
+    if expect == "denied":
+        row(results, rubric, f"{host}: refused from a non-allowed address", status == 403, status)
+        return
+    row(results, rubric, f"{host}: UI page", status == 200 and "<html" in html.lower(), status)
+    asset = re.search(r'(?:src|href)="(/_next/static/[^"]+\.(?:js|css))"', html)
+    status_a, _ = edge.authed(host, asset.group(1)) if asset else (0, "")
+    row(results, rubric, f"{host}: static asset", asset is not None and status_a == 200, f"{asset.group(1) if asset else 'none'} {status_a}")
+    status_api, body = edge.authed(host, api)
+    try:
+        data = json.loads(body)
+        count = len(data.get("data", data) if isinstance(data, dict) else data)
+    except (ValueError, TypeError):
+        count = None
+    row(results, rubric, f"{host}: read-only API {api}", status_api == 200 and count is not None, f"status={status_api} items={count}")
+
+
+def grafana_checks(edge: nt.Edge, results: list, credentials: str, root_url: str | None,
+                   loki_query: str, tempo_limit: int = 5) -> None:
+    """Rows 37-39 through observe.<domain>: login, dashboards, and real data from each source
+    (not only a healthy datasource): Prometheus 'up' samples, Loki log lines, Tempo traces."""
+    user, _, password = credentials.partition(":")
+    with tempfile.TemporaryDirectory() as tmp:
+        jar = ["-b", f"{tmp}/jar", "-c", f"{tmp}/jar"]
+        login = Path(tmp, "login.json")
+        login.write_text(json.dumps({"user": user, "password": password}))
+        reply = edge.request("observe", "/", authed=True)
+        row(results, "37", "Grafana redirects to its login on the same host", reply.status == 302 and (
+            not urlsplit(reply.location).hostname or urlsplit(reply.location).hostname == f"observe.{edge.domain}"),
+            f"{reply.status} {reply.location}")
+        _, page = edge.authed("observe", "/login")
+        app_url = (re.search(r'"appUrl":"([^"]*)"', page) or [None, None])[1]
+        if root_url:
+            row(results, "37", "Grafana appUrl is the public root URL", app_url == root_url, app_url)
+        status, _ = edge.authed("observe", "/login", "-X", "POST", "-H", "content-type: application/json",
+                                "--data-binary", f"@{login}", *jar)
+        login.unlink()
+        row(results, "37", "Grafana login", status == 200, status)
+        status, body = edge.authed("observe", "/api/search?type=dash-db", *jar)
+        dashboards = len(json.loads(body)) if status == 200 else 0
+        row(results, "37", "Grafana dashboards listed", dashboards > 0, f"status={status} dashboards={dashboards}")
+        status, body = edge.authed("observe", "/api/datasources/proxy/uid/prometheus/api/v1/query?query=up", *jar)
+        samples = len(json.loads(body).get("data", {}).get("result", [])) if status == 200 else 0
+        row(results, "37", "metrics: Prometheus returns 'up' samples", samples > 0, f"status={status} series={samples}")
+        status, body = edge.authed("observe", "/api/datasources/proxy/uid/loki/loki/api/v1/query_range?limit=20&query="
+                                   + quote(loki_query), *jar)
+        lines = sum(len(s.get("values", [])) for s in json.loads(body).get("data", {}).get("result", [])) if status == 200 else 0
+        row(results, "38", "logs: Loki returns log lines", lines > 0, f"status={status} lines={lines} query={loki_query}")
+        status, body = edge.authed("observe", f"/api/datasources/proxy/uid/tempo/api/search?limit={tempo_limit}", *jar)
+        traces = len(json.loads(body).get("traces", [])) if status == 200 else 0
+        row(results, "39", "traces: Tempo returns traces", traces > 0, f"status={status} traces={traces}")
+        edge.authed("observe", "/logout", *jar)
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--address", required=True, help="gateway address (LB IP, or 127.0.0.1 with a port-forward)")
+    parser.add_argument("--https-port", type=int, default=443)
+    parser.add_argument("--http-port", type=int, default=80)
+    parser.add_argument("--domain", required=True)
+    parser.add_argument("--ca-file", help="trust only this CA (private tests); default: system trust")
+    parser.add_argument("--credentials-file", required=True, help="edge Basic Auth user:password, outside the repo")
+    parser.add_argument("--grafana-credentials-file", help="Grafana user:password, outside the repo (rows 37-39)")
+    parser.add_argument("--grafana-root-url", help="expected Grafana appUrl, e.g. https://observe.<domain>/")
+    parser.add_argument("--loki-query", default='{namespace="ewallet-agents"}')
+    parser.add_argument("--lookup-json", help="optional synthetic lookup body (row 43 business lookup)")
+    parser.add_argument("--agents", choices=["allowed", "denied", "skip"], default="allowed",
+                        help="expected agents result from this client address")
+    parser.add_argument("--evidence-class", required=True, choices=["LOCAL_KIND", "GKE_PRIVATE", "PUBLIC_INTERNET"])
+    parser.add_argument("--out", type=Path)
+    args = parser.parse_args(argv)
+    private_file(args.credentials_file)
+    edge = nt.Edge(argparse.Namespace(address=args.address, https_port=args.https_port, http_port=args.http_port,
+                                      domain=args.domain, ca_file=args.ca_file, stub=False, foundation=False,
+                                      credentials_file=args.credentials_file))
+    results: list = []
+    tls_checks(edge, results)
+    feature_checks(edge, results, args.lookup_json)
+    if args.agents != "skip":
+        ui_checks(edge, results, "40", "agents", "/api/agents", args.agents)
+    ui_checks(edge, results, "41", "registry", "/v0/agents")
+    if args.grafana_credentials_file:
+        grafana_checks(edge, results, private_file(args.grafana_credentials_file), args.grafana_root_url, args.loki_query)
+    for r in results:
+        r["evidence_class"] = args.evidence_class
+        print(json.dumps(r))
+    if args.out:
+        args.out.parent.mkdir(parents=True, exist_ok=True)
+        args.out.write_text("".join(json.dumps(r) + "\n" for r in results), encoding="utf-8")
+    return 0 if all(r["passed"] for r in results) else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/edge/release_diff.py b/scripts/edge/release_diff.py
new file mode 100644
index 00000000..8faef540
--- /dev/null
+++ b/scripts/edge/release_diff.py
@@ -0,0 +1,71 @@
+"""Gate for a Helm upgrade of a frozen release (G3-B: grafanaExternal.rootUrl on llm-agent).
+
+Compares rendered manifests object by object and fails unless the change is exactly what was
+approved. Used twice, with files produced from the live release:
+
+  helm get manifest llm-agent -n default            > live.yaml
+  helm get values llm-agent -n default -a -o yaml   > values.yaml   (private dir: may hold settings)
+  helm template llm-agent infra/helm/llm-agent-platform -n default -f values.yaml > current.yaml
+  helm template ... -f values.yaml --set grafanaExternal.rootUrl=https://observe.<D>/ > proposed.yaml
+
+  release_diff.py --before live.yaml --after current.yaml
+      no drift: the current chart with the live values reproduces what is deployed
+  release_diff.py --before current.yaml --after proposed.yaml --allow-grafana-root-url https://observe.<D>/
+      the only change is GF_SERVER_ROOT_URL on Deployment ewallet-agents/grafana
+
+Prints the changed objects (kind/namespace/name) and never their contents.
+"""
+
+from __future__ import annotations
+
+import argparse
+import copy
+import json
+from pathlib import Path
+
+import yaml
+
+
+def objects(path: Path) -> dict[tuple, dict]:
+    return {(d["kind"], (d.get("metadata") or {}).get("namespace", ""), d["metadata"]["name"]): d
+            for d in yaml.safe_load_all(path.read_text(encoding="utf-8")) if d and "kind" in d}
+
+
+def without_root_url(deployment: dict) -> dict:
+    d = copy.deepcopy(deployment)
+    for c in d["spec"]["template"]["spec"]["containers"]:
+        c["env"] = [e for e in c.get("env", []) if e.get("name") != "GF_SERVER_ROOT_URL"]
+    return d
+
+
+def diff(before: dict[tuple, dict], after: dict[tuple, dict], root_url: str | None) -> tuple[list[str], list[str]]:
+    """(problems, allowed changes)."""
+    problems, allowed = [], []
+    for key in sorted(set(before) | set(after), key=str):
+        a, b = before.get(key), after.get(key)
+        if a == b:
+            continue
+        where = "/".join(key)
+        if root_url and key[0] == "Deployment" and key[2] == "grafana" and a and b and without_root_url(a) == without_root_url(b):
+            envs = [e for c in b["spec"]["template"]["spec"]["containers"] for e in c.get("env", []) if e.get("name") == "GF_SERVER_ROOT_URL"]
+            if envs == [{"name": "GF_SERVER_ROOT_URL", "value": root_url}]:
+                allowed.append(f"{where}: GF_SERVER_ROOT_URL={root_url}")
+                continue
+        problems.append(f"{where}: {'added' if a is None else 'removed' if b is None else 'changed'}")
+    return problems, allowed
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--before", type=Path, required=True)
+    parser.add_argument("--after", type=Path, required=True)
+    parser.add_argument("--allow-grafana-root-url", help="the one approved change")
+    args = parser.parse_args(argv)
+    problems, allowed = diff(objects(args.before), objects(args.after), args.allow_grafana_root_url)
+    print(json.dumps({"allowed_changes": allowed, "unexpected_changes": problems}, indent=2))
+    print("RELEASE_DIFF_OK" if not problems else "RELEASE_DIFF_UNEXPECTED")
+    return 1 if problems else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/edge/staged_rollout_check.sh b/scripts/edge/staged_rollout_check.sh
new file mode 100755
index 00000000..7766265d
--- /dev/null
+++ b/scripts/edge/staged_rollout_check.sh
@@ -0,0 +1,51 @@
+#!/usr/bin/env bash
+# usage: staged_rollout_check.sh <out-dir>   (kind only; EDGE_LOCAL_CONTEXT, default kind-llm-agent-local)
+# Local kind check of the G3-A1 fail-closed order: gateway workload at 0 replicas, edge chart
+# applied, then 1 replica. The first Envoy must start with Basic Auth and rate limit on 443.
+set -euo pipefail
+out=${1:?out dir}; C=${EDGE_LOCAL_CONTEXT:-kind-llm-agent-local}; NS=ewallet-ingress; STUB=edge-stub; D=edge.local.test
+root=$(cd "$(dirname "$0")/../.." && pwd); chart=$root/infra/helm/ewallet-edge
+[[ "$C" == kind-* ]] || { echo "refusing non-kind context $C" >&2; exit 2; }
+k() { kubectl --context "$C" "$@"; }
+for ns in $NS $STUB; do k get ns $ns >/dev/null 2>&1 && { echo "namespace $ns exists" >&2; exit 2; }; done
+work=$(mktemp -d); trap 'helm --kube-context $C uninstall ewallet-edge-gateway -n $NS >/dev/null 2>&1 || true; k delete ns $NS $STUB --wait=false >/dev/null 2>&1 || true; rm -rf "$work"' EXIT
+k create ns $NS >/dev/null; k create ns $STUB >/dev/null
+openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 1 -subj "/CN=$D" -addext "subjectAltName=DNS:*.$D" -keyout $work/k -out $work/c 2>/dev/null
+k -n $NS create secret tls edge-tls --cert=$work/c --key=$work/k >/dev/null
+openssl rand -hex 24 | tr -d '\n' | "$root/scripts/edge/create_basic_auth.sh" edge $NS $C >/dev/null
+k -n $STUB create deployment stub --image=python:3.12-alpine -- python3 -m http.server 8080 >/dev/null
+k -n $STUB expose deployment stub --port 8080 >/dev/null; k -n $STUB rollout status deploy/stub --timeout=120s >/dev/null
+helm --kube-context $C install ewallet-edge-gateway istio/gateway --version 1.30.7 -n $NS -f $chart/values-gateway.yaml --set replicaCount=0 --wait --timeout 3m >/dev/null
+echo "step1 gateway release at 0 replicas: pods=$(k -n $NS get pods --no-headers 2>/dev/null | wc -l) svc=$(k -n $NS get svc ewallet-edge-gateway -o jsonpath='{.spec.type}')"
+python3 - "$chart/values.yaml" > $work/v.yaml <<'PY'
+import sys, yaml
+routes = yaml.safe_load(open(sys.argv[1]))["routes"]
+print(yaml.safe_dump({"enabled": True, "domain": "edge.local.test", "securityFiltersVerified": True,
+  "routes": {n: {"enabled": True, "backend": {"service": "stub", "namespace": "edge-stub", "port": 8080}, "access": None} for n in routes}}))
+PY
+helm template ewallet-edge $chart -n $NS -f $work/v.yaml > $work/r.yaml; k apply -f $work/r.yaml >/dev/null; sleep 20
+echo "step2 edge applied with 0 gateway pods: Gateway conditions $(k -n $NS get gateway ewallet-edge -o jsonpath='{range .status.conditions[*]}{.type}={.status}({.reason}) {end}')"
+echo "        HTTPRoutes Accepted/ResolvedRefs: $(k -n $NS get httproute -o jsonpath='{range .items[*]}{.metadata.name}:{.status.parents[0].conditions[?(@.type=="Accepted")].status}/{.status.parents[0].conditions[?(@.type=="ResolvedRefs")].status} {end}')"
+helm --kube-context $C upgrade ewallet-edge-gateway istio/gateway --version 1.30.7 -n $NS -f $chart/values-gateway.yaml >/dev/null
+# Poll from the moment the container starts: the very first config that has a 443 listener.
+pod=""; for i in $(seq 1 60); do pod=$(k -n $NS get pod -l istio=ewallet-edge-gateway -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || true); [ -n "$pod" ] && k -n $NS exec $pod -- pilot-agent request GET config_dump >$work/d.json 2>/dev/null && grep -q '"port_value": 443' $work/d.json && break; sleep 1; done
+python3 - $work/d.json <<'PY'
+import json, sys
+chains = {}
+for c in json.load(open(sys.argv[1]))["configs"]:
+    for l in c.get("dynamic_listeners", []):
+        li = l.get("active_state", {}).get("listener", {}); port = li.get("address", {}).get("socket_address", {}).get("port_value")
+        for fc in li.get("filter_chains", []):
+            for f in fc.get("filters", []):
+                if f["name"] == "envoy.filters.network.http_connection_manager":
+                    chains[port] = [h["name"].rsplit(".", 1)[-1] for h in f["typed_config"].get("http_filters", [])]
+c443 = chains.get(443, [])
+ok = "local_ratelimit" in c443 and "basic_auth" in c443 and c443.index("local_ratelimit") < c443.index("basic_auth") < c443.index("router")
+print(f"step3 first config of the first gateway pod: 443 chain {c443}; 80 chain {chains.get(80)}")
+print("STAGED_ROLLOUT_FIRST_CONFIG_SECURED" if ok else "STAGED_ROLLOUT_UNSECURED")
+PY
+k -n $NS rollout status deploy/ewallet-edge-gateway --timeout=120s >/dev/null
