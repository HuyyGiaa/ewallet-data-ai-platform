diff --git a/infra/helm/ewallet-edge/templates/source-restriction.yaml b/infra/helm/ewallet-edge/templates/source-restriction.yaml
new file mode 100644
index 00000000..9b8a84c9
--- /dev/null
+++ b/infra/helm/ewallet-edge/templates/source-restriction.yaml
@@ -0,0 +1,51 @@
+{{- if and .Values.enabled .Values.sourceRestriction.enabled }}
+{{- $r := .Values.sourceRestriction }}
+{{- if not $r.allowedCidrs }}
+{{- fail "sourceRestriction.allowedCidrs is empty: list the owner-approved client CIDRs, or disable the restriction" }}
+{{- end }}
+{{- range $r.allowedCidrs }}
+{{- if not (regexMatch "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$" .) }}
+{{- fail (printf "sourceRestriction.allowedCidrs: %q is not an IPv4 CIDR" .) }}
+{{- end }}
+{{- if hasSuffix "/0" . }}
+{{- fail (printf "sourceRestriction.allowedCidrs: %q allows every address" .) }}
+{{- end }}
+{{- end }}
+{{- if not $r.routes }}
+{{- fail "sourceRestriction.routes is empty" }}
+{{- end }}
+{{- $hosts := list }}
+{{- range $r.routes }}
+{{- $route := index $.Values.routes . }}
+{{- if not (and $route $route.enabled) }}
+{{- fail (printf "sourceRestriction.routes: %s is not an enabled route" .) }}
+{{- end }}
+{{- $host := printf "%s.%s" $route.hostPrefix $.Values.domain }}
+{{- $hosts = concat $hosts (list $host (printf "%s:*" $host)) }}
+{{- end }}
+---
+# Requests for these hosts are refused (403) unless the TCP peer address Envoy sees is in
+# the allowlist. ipBlocks is that peer address, never X-Forwarded-For, so a client cannot
+# claim an allowed address in a header. The ":*" form also matches a Host header that
+# carries a port. Only meaningful when the client address reaches Envoy unchanged: on GKE,
+# a LoadBalancer Service with externalTrafficPolicy Local (values-gateway-public.yaml).
+apiVersion: security.istio.io/v1
+kind: AuthorizationPolicy
+metadata:
+  name: edge-source-restriction
+  namespace: {{ .Values.namespace }}
+  labels:
+    {{- include "ewallet-edge.labels" . | nindent 4 }}
+spec:
+  selector:
+    matchLabels:
+      {{- toYaml .Values.gatewaySelector | nindent 6 }}
+  action: DENY
+  rules:
+    - from:
+        - source:
+            notIpBlocks: {{ toJson $r.allowedCidrs }}
+      to:
+        - operation:
+            hosts: {{ toJson $hosts }}
+{{- end }}
diff --git a/infra/helm/ewallet-edge/values-gateway-public.yaml b/infra/helm/ewallet-edge/values-gateway-public.yaml
new file mode 100644
index 00000000..d02c507b
--- /dev/null
+++ b/infra/helm/ewallet-edge/values-gateway-public.yaml
@@ -0,0 +1,18 @@
+# G3-B public exposure overlay for the official istio/gateway 1.30.7 chart. Applied ON TOP
+# of values-gateway.yaml to the same release (ewallet-edge-gateway), so the existing
+# Deployment is reused and only its Service changes; no second gateway is created.
+# Not used until the owner approves public exposure (docs/evidence/edai2/gateway/g3b0-*/).
+service:
+  type: LoadBalancer
+  # The client address reaches Envoy unchanged (no SNAT), which the kagent source
+  # restriction (ewallet-edge sourceRestriction) relies on. Traffic goes only to nodes
+  # running a gateway pod; GKE health-checks healthCheckNodePort for that.
+  externalTrafficPolicy: Local
+  # REQUIRED before use: owner-approved client CIDRs. GKE enforces them as a VPC firewall
+  # rule in front of the load balancer. ownership_preflight.py refuses an empty list or
+  # 0.0.0.0/0. Note: an ACME HTTP-01 validator cannot pass this filter (use DNS-01).
+  loadBalancerSourceRanges: []
+  # Only HTTP (redirect) and HTTPS; the 15021 status port stays off the public address.
+  ports:
+    - {name: http2, port: 80, protocol: TCP, targetPort: 80}
+    - {name: https, port: 443, protocol: TCP, targetPort: 443}
