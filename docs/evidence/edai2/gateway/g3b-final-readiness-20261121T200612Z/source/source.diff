+++ b/scripts/edge/install_watchdog.sh
@@ -0,0 +1,24 @@
+#!/usr/bin/env bash
+# Render the G3-B watchdog user units for this machine.
+# usage: install_watchdog.sh [--state FILE] [--dest DIR] [--enable]
+#   --state  campaign state the watchdog follows (default ~/ewallet-evidence/gateway/active-campaign/state.json,
+#            a symlink the owner points at the campaign directory)
+#   --dest   where to write the units (default ~/.config/systemd/user); tests use a temporary directory
+#   --enable also run systemctl --user daemon-reload and enable --now the timer (owner step)
+# Without --enable nothing is started. The watchdog itself only acts on an active campaign.
+set -euo pipefail
+repo=$(cd "$(dirname "$0")/../.." && pwd)
+state="$HOME/ewallet-evidence/gateway/active-campaign/state.json" dest="$HOME/.config/systemd/user" enable=""
+while [ $# -gt 0 ]; do
+  case "$1" in --state) state=$2; shift 2 ;; --dest) dest=$2; shift 2 ;; --enable) enable=1; shift ;; *) echo "unknown $1" >&2; exit 2 ;; esac
+done
+mkdir -p "$dest"
+for unit in edge-campaign-watchdog.service edge-campaign-watchdog.timer; do
+  sed -e "s#@REPO@#$repo#g" -e "s#@PATH@#$PATH#g" -e "s#@STATE@#$state#g" "$repo/scripts/edge/systemd/$unit" > "$dest/$unit"
+done
+echo "wrote $dest/edge-campaign-watchdog.{service,timer}"
+if [ -n "$enable" ]; then
+  systemctl --user daemon-reload
+  systemctl --user enable --now edge-campaign-watchdog.timer
+  echo "enabled; also run: loginctl enable-linger $USER (keeps the timer running after logout)"
+fi
diff --git a/scripts/edge/systemd/edge-campaign-watchdog.service b/scripts/edge/systemd/edge-campaign-watchdog.service
new file mode 100644
index 00000000..1f1e9738
--- /dev/null
+++ b/scripts/edge/systemd/edge-campaign-watchdog.service
@@ -0,0 +1,11 @@
+# Rendered by scripts/edge/install_watchdog.sh (@REPO@, @PATH@ and @STATE@ are filled in).
+# One watchdog pass for the active G3-B campaign: cleans up only when the campaign deadline has
+# passed, or the main process is gone with a stale heartbeat. Idle otherwise.
+[Unit]
+Description=G3-B edge campaign watchdog (deadline and dead-process cleanup)
+
+[Service]
+Type=oneshot
+Environment=PATH=@PATH@
+ExecStart=/usr/bin/systemd-inhibit --what=sleep:idle --who=edge-campaign --why=edge-campaign-cleanup --mode=block /usr/bin/env python3 @REPO@/scripts/edge/g3b_campaign.py watchdog --state @STATE@
+TimeoutStartSec=3h
diff --git a/scripts/edge/systemd/edge-campaign-watchdog.timer b/scripts/edge/systemd/edge-campaign-watchdog.timer
new file mode 100644
index 00000000..9875d8ae
--- /dev/null
+++ b/scripts/edge/systemd/edge-campaign-watchdog.timer
@@ -0,0 +1,13 @@
+# Every 5 minutes while the user manager runs (enable linger to keep it running after logout).
+# Persistent=true: a pass missed during suspend runs right after resume.
+[Unit]
+Description=G3-B edge campaign watchdog timer
+
+[Timer]
+OnBootSec=2min
+OnUnitActiveSec=5min
+Persistent=true
+AccuracySec=30s
+
+[Install]
+WantedBy=timers.target
diff --git a/tests/ops/test_dns_campaign.py b/tests/ops/test_dns_campaign.py
