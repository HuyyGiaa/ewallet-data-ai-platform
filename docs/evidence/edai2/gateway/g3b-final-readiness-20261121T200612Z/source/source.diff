+def wait_for_phase(path, phase, timeout=30):
+    end = time.time() + timeout
+    while time.time() < end:
+        try:
+            if json.loads(path.read_text()).get("CURRENT_PHASE") == phase:
+                return
+        except ValueError:
+            pass
+        time.sleep(0.1)
+    raise AssertionError(f"phase {phase} not reached")
+
