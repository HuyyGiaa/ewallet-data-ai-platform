+def cli(*args, env=None):
+    return subprocess.Popen([sys.executable, str(EDGE / "g3b_campaign.py"), "--simulate", *args], stdout=subprocess.PIPE,
+                            stderr=subprocess.PIPE, text=True, env={**os.environ, **(env or {})})
