  {
    "kind": "HorizontalPodAutoscaler",
    "namespace": "gke-managed-cim",
    "name": "kube-state-metrics",
    "spec": {
      "behavior": {
        "scaleDown": {
          "policies": [
            {
              "periodSeconds": 1800,
              "type": "Pods",
              "value": 1
            }
          ],
          "selectPolicy": "Max",
          "stabilizationWindowSeconds": 3600
        },
        "scaleUp": {
          "policies": [
            {
              "periodSeconds": 300,
              "type": "Pods",
              "value": 1
            }
          ],
          "selectPolicy": "Max",
          "stabilizationWindowSeconds": 900
        }
      },
      "maxReplicas": 10,
      "metrics": [
        {
          "resource": {
            "name": "memory",
            "target": {
              "averageValue": "400Mi",
              "type": "AverageValue"
            }
          },
          "type": "Resource"
        }
      ],
      "minReplicas": 1,
      "scaleTargetRef": {
        "apiVersion": "apps/v1",
        "kind": "StatefulSet",
        "name": "kube-state-metrics"
      }
    }
  },
  {
    "kind": "HorizontalPodAutoscaler",
    "namespace": "istio-system",
    "name": "istiod",
    "spec": {
      "maxReplicas": 5,
      "metrics": [
        {
          "resource": {
            "name": "cpu",
            "target": {
              "averageUtilization": 80,
              "type": "Utilization"
            }
          },
          "type": "Resource"
        }
      ],
      "minReplicas": 1,
      "scaleTargetRef": {
        "apiVersion": "apps/v1",
        "kind": "Deployment",
        "name": "istiod"
      }
    }
  }
]
