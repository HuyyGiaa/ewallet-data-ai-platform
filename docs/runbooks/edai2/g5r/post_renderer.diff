+VALKEY_COMMAND = ["valkey-server", "/etc/valkey/valkey.conf"]
+VALKEY_SERVICE = "valkey-cluster-service"
+
+# Runs beside every Valkey pod. Each pass resolves the StatefulSet's own pods through the
+# headless Service and sends CLUSTER MEET only to a pod that (a) is not already known at its
+# current address and (b) reports a node ID this node already has in its table. A pod with
+# an unknown ID (for example one whose PVC was lost) is never introduced: membership changes
+# stay a human decision. MEET to a known ID at a new address only updates that address.
+RECONCILER_SCRIPT = r"""
+set -u
+until valkey-cli -h 127.0.0.1 ping >/dev/null 2>&1; do sleep 1; done
+while true; do
+  nodes=$(valkey-cli -h 127.0.0.1 cluster nodes 2>/dev/null || true)
+  i=0
+  while [ "$i" -lt "$VALKEY_REPLICAS" ]; do
+    host="valkey-cluster-$i.$VALKEY_SERVICE.$POD_NAMESPACE.svc.cluster.local"
+    ip=$(getent hosts "$host" | awk '{print $1; exit}')
+    i=$((i + 1))
+    [ -n "$ip" ] && [ "$ip" != "$POD_IP" ] || continue
+    printf '%s\n' "$nodes" | grep -q " $ip:6379@" && continue
+    id=$(timeout 3 valkey-cli -h "$ip" cluster myid 2>/dev/null || true)
+    if [ -z "$id" ] || ! printf '%s\n' "$nodes" | grep -q "^$id "; then
+      echo "skip $host $ip: node id '$id' is not a known member"; continue
+    fi
+    echo "meet $host $ip (node $id)"; valkey-cli -h 127.0.0.1 cluster meet "$ip" 6379
+  done
+  sleep 15
+done
+"""
+
+
+def patch_valkey(document: dict) -> None:
+    """Announce the pod IP and keep peer addresses current after any pod move."""
+    if document.get("kind") != "StatefulSet" or document.get("metadata", {}).get("name") != "valkey-cluster":
+        return
+    spec = document["spec"]["template"]["spec"]
+    containers = {c["name"]: c for c in spec["containers"]}
+    valkey = containers.get("valkey")
+    if valkey is None or valkey.get("command") != VALKEY_COMMAND or valkey.get("args"):
+        raise ValueError("valkey-cluster container changed upstream; review the announce-ip patch")
+    def pod_ip() -> dict:
+        return {"name": "POD_IP", "valueFrom": {"fieldRef": {"fieldPath": "status.podIP"}}}
+
+    valkey["env"] = [*valkey.get("env", []), pod_ip()]
+    valkey["command"] = [*VALKEY_COMMAND, "--cluster-announce-ip", "$(POD_IP)"]
+    valkey["readinessProbe"] = {"exec": {"command": ["valkey-cli", "-h", "127.0.0.1", "ping"]},
+                                "periodSeconds": 5, "failureThreshold": 3}
+    replicas = str(document["spec"].get("replicas", 6))
+    spec["containers"].append({
+        "name": "cluster-address-reconciler",
+        "image": valkey["image"],
+        "command": ["/bin/sh", "-c", RECONCILER_SCRIPT],
+        "env": [pod_ip(),
+                {"name": "POD_NAMESPACE", "valueFrom": {"fieldRef": {"fieldPath": "metadata.namespace"}}},
+                {"name": "VALKEY_SERVICE", "value": VALKEY_SERVICE},
+                {"name": "VALKEY_REPLICAS", "value": replicas}],
+        "resources": {"requests": {"cpu": "5m", "memory": "16Mi"}, "limits": {"cpu": "50m", "memory": "32Mi"}},
+    })
+
+
 def pod_spec(document: dict) -> dict | None:
     kind = document.get("kind")
     spec = document.get("spec", {})
