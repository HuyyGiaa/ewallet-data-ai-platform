--- valkey-cluster (current render)
+++ valkey-cluster (proposed render)
@@ -22,4 +22,6 @@
         - valkey-server
         - /etc/valkey/valkey.conf
+        - --cluster-announce-ip
+        - $(POD_IP)
         ports:
         - name: valkey
@@ -32,4 +34,18 @@
         - name: data
           mountPath: /data
+        env:
+        - name: POD_IP
+          valueFrom:
+            fieldRef:
+              fieldPath: status.podIP
+        readinessProbe:
+          exec:
+            command:
+            - valkey-cli
+            - -h
+            - 127.0.0.1
+            - ping
+          periodSeconds: 5
+          failureThreshold: 3
         resources:
           requests:
@@ -39,4 +55,41 @@
             cpu: 250m
             memory: 256Mi
+      - name: cluster-address-reconciler
+        image: valkey/valkey:8.0@sha256:04b9002ae24bbe66687fb025052ed9bcebb54f8da3937338eb718d98d362887f
+        command:
+        - /bin/sh
+        - -c
+        - "\nset -u\nuntil valkey-cli -h 127.0.0.1 ping >/dev/null 2>&1; do sleep\
+          \ 1; done\nwhile true; do\n  nodes=$(valkey-cli -h 127.0.0.1 cluster nodes\
+          \ 2>/dev/null || true)\n  i=0\n  while [ \"$i\" -lt \"$VALKEY_REPLICAS\"\
+          \ ]; do\n    host=\"valkey-cluster-$i.$VALKEY_SERVICE.$POD_NAMESPACE.svc.cluster.local\"\
+          \n    ip=$(getent hosts \"$host\" | awk '{print $1; exit}')\n    i=$((i\
+          \ + 1))\n    [ -n \"$ip\" ] && [ \"$ip\" != \"$POD_IP\" ] || continue\n\
+          \    printf '%s\\n' \"$nodes\" | grep -q \" $ip:6379@\" && continue\n  \
+          \  id=$(timeout 3 valkey-cli -h \"$ip\" cluster myid 2>/dev/null || true)\n\
+          \    if [ -z \"$id\" ] || ! printf '%s\\n' \"$nodes\" | grep -q \"^$id \"\
+          ; then\n      echo \"skip $host $ip: node id '$id' is not a known member\"\
+          ; continue\n    fi\n    echo \"meet $host $ip (node $id)\"; valkey-cli -h\
+          \ 127.0.0.1 cluster meet \"$ip\" 6379\n  done\n  sleep 15\ndone\n"
+        env:
+        - name: POD_IP
+          valueFrom:
+            fieldRef:
+              fieldPath: status.podIP
+        - name: POD_NAMESPACE
+          valueFrom:
+            fieldRef:
+              fieldPath: metadata.namespace
+        - name: VALKEY_SERVICE
+          value: valkey-cluster-service
+        - name: VALKEY_REPLICAS
+          value: '6'
+        resources:
+          requests:
+            cpu: 5m
+            memory: 16Mi
+          limits:
+            cpu: 50m
+            memory: 32Mi
       volumes:
       - name: config
