+
+const (
+	suspendSettleTimeout  = time.Minute
+	suspendSettleInterval = 250 * time.Millisecond
+)
+
+// settleSuspendingActor waits, bounded, while an actor is SUSPENDING and returns its settled state.
+func settleSuspendingActor(ctx context.Context, c *Client, atespace, actorID string, actor *ateapipb.Actor) (*ateapipb.Actor, error) {
+	if actor.GetStatus() != ateapipb.Actor_STATUS_SUSPENDING {
+		return actor, nil
+	}
+	settleCtx, cancel := context.WithTimeout(ctx, suspendSettleTimeout)
+	defer cancel()
+	ticker := time.NewTicker(suspendSettleInterval)
+	defer ticker.Stop()
+	for actor.GetStatus() == ateapipb.Actor_STATUS_SUSPENDING {
+		select {
+		case <-settleCtx.Done():
+			return nil, fmt.Errorf("substrate session actor %q still suspending: %w", actorID, settleCtx.Err())
+		case <-ticker.C:
+		}
+		next, err := c.GetActor(settleCtx, atespace, actorID)
+		if err != nil {
+			return nil, fmt.Errorf("substrate GetActor %q while suspending: %w", actorID, err)
+		}
+		actor = next
+	}
+	return actor, nil
+}
