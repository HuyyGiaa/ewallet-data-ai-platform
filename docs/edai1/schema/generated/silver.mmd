erDiagram
    USERS ||--o{ ACCOUNTS : user_id
    USERS ||--o{ DEVICES : user_id
    USERS ||--o{ TRANSACTIONS : user_id
    ACCOUNTS ||--o{ TRANSACTIONS : account_id
    DEVICES ||--o{ TRANSACTIONS : device_id
    MERCHANTS o|--o{ TRANSACTIONS : merchant_id
    ACCOUNTS o|--o{ TRANSACTIONS : counterparty_account_id
    USERS ||--o{ LOGIN_EVENTS : user_id
    DEVICES ||--o{ LOGIN_EVENTS : device_id
    ACCOUNTS ||--o{ BALANCE_SNAPSHOTS : account_id
    TRANSACTIONS ||--|| FRAUD_LABELS : transaction_id
    ACCOUNTS {
        string account_id PK
        string user_id FK
        string account_type
        string currency
        timestamp created_at
    }
    BALANCE_SNAPSHOTS {
        string account_id PK,FK
        date snapshot_date PK
        double closing_balance
    }
    DEVICES {
        string device_id PK
        string user_id FK
        string device_type
        string os
        timestamp first_seen_at
    }
    FRAUD_LABELS {
        string transaction_id PK,FK
        integer label
        string fraud_type
    }
    LOGIN_EVENTS {
        string login_id PK
        string user_id FK
        string device_id FK
        timestamp login_ts
        boolean is_success
        date login_date
    }
    MERCHANTS {
        string merchant_id PK
        string merchant_name
        string category
    }
    TRANSACTIONS {
        string transaction_id PK
        string account_id FK
        string user_id FK
        string device_id FK
        string type
        double amount
        string currency
        string status
        double old_balance
        double new_balance
        string merchant_id FK
        string counterparty_account_id FK
        timestamp timestamp
        timestamp ingested_at
        string channel
        date event_date
    }
    USERS {
        string user_id PK
        string full_name
        string email
        string phone
        boolean kyc_verified
        timestamp created_at
    }
